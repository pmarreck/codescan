#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root" || exit 1
source "$root/tests/lib/capture.bash"

out=
err=
rc=
failed=0
latency_job="${CODESCAN_LATENCY_JOB:-}"
unset CODESCAN_LATENCY_JOB

profile_command() {
	local kind="$1" name="$2"
	shift 2
	if [ -n "$latency_job" ]; then
		performance-profile latency span --job "$latency_job" --name "$name" --kind "$kind" -- "$@"
	else
		"$@"
	fi
}

run_case() {
	local name="$1"
	shift
	capture "$@"
	if [ "$rc" -eq 0 ]; then
		printf '\033[32mPASS\033[0m %s\n' "$name"
		if [ "$name" = 'isolated complete suite' ]; then printf '%s\n' "$out"; fi
	else
		printf '\033[31mFAIL\033[0m %s\n' "$name" >&2
		printf '%s' "$out" >&2
		printf '%s' "$err" >&2
		failed=1
	fi
}

run_development_case() {
	local name="$1" stamp
	shift
	if [ -z "$latency_job" ]; then
		run_case "$name" nix develop -c env TMPDIR="${TMPDIR:-/tmp}" "$@"
	elif stamp="$(performance-profile latency stamp)"; then
		run_case "$name" nix develop -c env TMPDIR="${TMPDIR:-/tmp}" bash ./tests/lib/latency-run "$latency_job" "$stamp" "$name" "$@"
	else
		rc=1
		failed=1
		printf 'FAIL %s: profiling clock failed\n' "$name" >&2
	fi
}

case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) export CODESCAN_EXPECT_PF=linux-amd64 CODESCAN_EXPECT_VARIANT=musl; codescan_nix_system=x86_64-linux ;;
	Linux/aarch64) export CODESCAN_EXPECT_PF=linux-arm64 CODESCAN_EXPECT_VARIANT=musl; codescan_nix_system=aarch64-linux ;;
	*) printf 'Required native runtime isolation is not qualified on this host; refusing unconfined tests\n' >&2; exit 69 ;;
esac

if [ "$#" -eq 3 ] && [ "$1" = --prepared ]; then
	cli_output="$2"
	test_output="$3"
	nix path-info "$cli_output" "$test_output" >/dev/null || exit 1
elif [ "$#" -eq 0 ]; then
	printf 'Preparing exact CLI and unit-test artifacts through Nix...\n' >&2
	if out="$(profile_command mixed 'artifact preparation' timeout 1800 nix build .#default .#test-binaries --no-link --json --timeout 1800 --log-format bar-with-logs)"; then
		rc=0
	else
		exit "$?"
	fi
	cli_output="$(printf '%s' "$out" | nix develop -c jq -er '[.[] | select(.drvPath | contains("-codescan-test-binaries-") | not)] | if length == 1 then .[0].outputs.out else error("expected one CLI output") end')" || exit 1
	test_output="$(printf '%s' "$out" | nix develop -c jq -er '[.[] | select(.drvPath | contains("-codescan-test-binaries-"))] | if length == 1 then .[0].outputs.out else error("expected one test output") end')" || exit 1
else
	printf 'Usage: ./test [--prepared NIX_CLI_OUTPUT NIX_TEST_OUTPUT]\n' >&2
	exit 64
fi
export CODESCAN_TEST_BIN="$cli_output/bin/codescan"
export CODESCAN_TEST_DB_BIN="$test_output/bin/mk-test-db"
export CODESCAN_UNIT_TEST_BIN="$test_output/bin/codescan-unit-tests"
run_development_case 'dev-shell cache preservation' ./tests/unit/test-dev-shell-cache
run_case 'all-system flake evaluation' profile_command nix_eval 'all-system flake evaluation' nix flake check --no-build --all-systems
run_case 'compiler concurrency contract' profile_command mixed 'compiler concurrency contract' nix build --no-link ".#checks.$codescan_nix_system.compiler-concurrency"
run_case 'compiled source closure' profile_command mixed 'compiled source closure' nix build --no-link ".#checks.$codescan_nix_system.source-closure"
run_development_case 'preventive filesystem boundary' ./tests/unit/test-isolation
if [ "$rc" -eq 0 ]; then
	run_development_case 'isolated complete suite' ./tests/lib/run-isolated -- bash ./tests/run-prepared
fi

exit "$failed"
