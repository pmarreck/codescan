#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root" || exit 1
source "$root/tests/lib/capture.bash"

out=
err=
rc=
failed=0

run_case() {
	local name="$1"
	shift
	capture "$@"
	if [ "$rc" -eq 0 ]; then
		printf '\033[32mPASS\033[0m %s\n' "$name"
		if [ "$name" = 'isolated complete suite' ]; then printf '%s\n' "$out"; fi
	else
		printf '\033[31mFAIL\033[0m %s\n' "$name" >&2
		printf '%s' "$out" >&2
		printf '%s' "$err" >&2
		failed=1
	fi
}

case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) export CODESCAN_EXPECT_PF=linux-amd64 CODESCAN_EXPECT_VARIANT=musl; codescan_nix_system=x86_64-linux ;;
	Linux/aarch64) export CODESCAN_EXPECT_PF=linux-arm64 CODESCAN_EXPECT_VARIANT=musl; codescan_nix_system=aarch64-linux ;;
	*) printf 'Required native runtime isolation is not qualified on this host; refusing unconfined tests\n' >&2; exit 69 ;;
esac

if [ "$#" -eq 3 ] && [ "$1" = --prepared ]; then
	cli_output="$2"
	test_output="$3"
	nix path-info "$cli_output" "$test_output" >/dev/null || exit 1
elif [ "$#" -eq 0 ]; then
	printf 'Preparing exact CLI and unit-test artifacts through Nix...\n' >&2
	if out="$(timeout 1800 nix build .#default .#test-binaries --no-link --json --timeout 1800 --log-format bar-with-logs)"; then
		rc=0
	else
		exit "$?"
	fi
	cli_output="$(printf '%s' "$out" | nix develop -c jq -er '[.[] | select(.drvPath | contains("-codescan-test-binaries-") | not)] | if length == 1 then .[0].outputs.out else error("expected one CLI output") end')" || exit 1
	test_output="$(printf '%s' "$out" | nix develop -c jq -er '[.[] | select(.drvPath | contains("-codescan-test-binaries-"))] | if length == 1 then .[0].outputs.out else error("expected one test output") end')" || exit 1
else
	printf 'Usage: ./test [--prepared NIX_CLI_OUTPUT NIX_TEST_OUTPUT]\n' >&2
	exit 64
fi
export CODESCAN_TEST_BIN="$cli_output/bin/codescan"
export CODESCAN_TEST_DB_BIN="$test_output/bin/mk-test-db"
export CODESCAN_UNIT_TEST_BIN="$test_output/bin/codescan-unit-tests"
run_case 'dev-shell cache preservation' nix develop -c ./tests/unit/test-dev-shell-cache
run_case 'all-system flake evaluation' nix flake check --no-build --all-systems
run_case 'compiled source closure' nix build --no-link ".#checks.$codescan_nix_system.source-closure"
run_case 'preventive filesystem boundary' nix develop -c ./tests/unit/test-isolation
if [ "$rc" -eq 0 ]; then
	run_case 'isolated complete suite' nix develop -c ./tests/lib/run-isolated -- bash ./tests/run-prepared
fi

exit "$failed"
