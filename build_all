#!/usr/bin/env bash
set -u

run() {
	"$@" || {
		echo "FAILED: $*" >&2
		exit 1
	}
}

if [ "$#" -ne 0 ]; then
	echo "usage: ./build_all" >&2
	exit 64
fi

for target in \
	"macos-arm64" \
	"linux-arm64" \
	"linux-amd64" \
	"mswin-arm64" \
	"mswin-amd64"
do
	case "$target" in
		macos-*) variant= ;;
		linux-*) variant=musl/ ;;
		mswin-*) variant=gnu/ ;;
	esac
	prefix=".nix-out/$target/${variant}ReleaseFast"
	run mkdir -p "$(dirname "$prefix")"
	run nix build ".#release-$target" --out-link "$prefix"
done

# Run native last so zig-out/bin contains a binary for this machine.
run ./build
