# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
close=[
	deps
	src/plugins
	zig-cache
]

annotate=[
	.codescan-fixtures = Gitignored fixture repository clones for integration tests
	.github/workflows/build.yml = GitHub Actions build plus release-artifact workflow
	.gitignore = Ignored paths for build outputs and local indexes
	INTENT.md = Canonical product scope and verification requirements
	LICENSE = MIT license
	PLAN.md = Ordered pending work with recent verified completions
	PROJECT_STATE.md = Working notes on build, run, and configuration details for future contributors
	README.md = User guide, including supported languages, extensionless-script rules, Jina setup, and watcher operation.
	RULES.md = Non-negotiable project rules
	SEMANTIC_EDITING_PLAN.md = Architecture plan for symbol-level editing, hashlines, and LSP integration
	build.zig = Zig build script for the CLI, the aggregated test-unit step, and the vendored tree-sitter grammars
	build.zig.zon = Zig package metadata and the git dependency on the sqlite-vec fork
	build_all = Five-target cross-build gate that finishes with a native ./build artifact.
	deps/tree-sitter = Vendored tree-sitter runtime (C library and headers)
	deps/tree-sitter-bash = Vendored tree-sitter Bash grammar
	deps/tree-sitter-c = Vendored tree-sitter C grammar
	deps/tree-sitter-haskell = Vendored tree-sitter Haskell grammar
	deps/tree-sitter-idris2 = Vendored tree-sitter Idris 2 grammar
	deps/tree-sitter-lean = Vendored tree-sitter Lean grammar
	deps/tree-sitter-lua = Vendored tree-sitter Lua grammar
	deps/tree-sitter-nim = Vendored tree-sitter Nim grammar
	deps/tree-sitter-nix = Vendored tree-sitter Nix grammar
	deps/tree-sitter-rust = Vendored tree-sitter Rust grammar
	deps/tree-sitter-typescript = Vendored tree-sitter TypeScript/TSX grammar
	docs/PLAN_LOG.md = Public-safe completed-work records
	docs/jina-code-embeddings-ollama.md = Verified local Jina GGUF pooling-metadata patch, Ollama import, and acceptance procedure
	docs/plan_context/build_conformance.md = Current build products, callers, migration checks, and protected live publication
	docs/plan_context/filter_classifiers.md = Filter classifier inventory, empty-intersection regressions, and complete-set validation evidence
	docs/plan_context/inference_availability.md = Embedding rejection and held-reconciliation evidence, retained-index checks, and open policies
	docs/plan_context/request_deadlines.md = Cancellation fixture scope, cleanup contract, and remaining native qualification
	docs/plan_context/sqlite_vec_callback_safety.md = SQLite vector callback failure evidence, Nix patch scope, and removal criteria
	docs/plan_context/staged_dependency_parser.md = Shared tokenizer repair evidence and independent consumer controls
	docs/plan_context/test_latency.md = Measured test-runtime costs, removed polling delay, and remaining budget work
	docs/plan_context/watcher_sqlite_failures.md = SQLite watcher failure evidence, constraints, and diagnostic acceptance criteria
	fixtures/manifest.toml = Pinned fixture repositories used by the integration suite
	flake.lock = Pinned Nix inputs for a reproducible dev shell
	flake.nix = Nix flake providing the dev shell, packages, and checks used by both ./build and CI
	patches/profiler-latency-debounce-fixture.patch = Seed a bounded prior notification state in the pinned profiler CLI fixture
	patches/sqlite-vec-cleanup-callbacks.patch = Pinned sqlite-vec callback-type correction for ReleaseSafe vector insertion
	reindex_all = Sequentially update direct-child Git projects with local Ollama Jina and percentage progress
	scripts/ci-build = CI build and packaging wrapper, ReleaseFast per target
	scripts/ci-local = Runs the CI build job locally via act (Linux only)
	scripts/ci-setup-nix = CI helper that installs Nix for GitHub Actions
	scripts/ci-verify-macos-arm64 = Build-time native Mac runner, Mach-O ARM64 header, and executable smoke gate
	src/about.zig = Pure compilation-target identification and one-line CLI metadata renderer
	src/all_tests.zig = Aggregated unit-test root importing every module with test blocks, so one binary runs the whole suite
	src/cli.zig = Parses commands/global switches, including internal watcher daemon mode
	src/config.zig = Parses and loads .codescan/config.ini (with a legacy 'config' filename fallback), including search weights
	src/diagnostics.zig = Zero-result diagnosis: counts symbols per active filter dimension (kind/lang/path) so the CLI can name which filter eliminated the results
	src/diff.zig = Unified-diff generation between old and new file content; returns an empty string (no headers or hunks) when identical
	src/doctor.zig = Pure doctor report model and deterministic human/JSON renderer.
	src/embedding.zig = HTTP/null embedding adapters and caller-owned per-attempt failure capture
	src/embedding_http.zig = Shared embedding HTTP transport: cancellable preflight deadlines plus provider/model availability checks; embedding POSTs remain unbounded for cold models.
	src/env_expand.zig = Shell-style $VAR / ${VAR:-DEF} expansion for config values, with $$ escaping and a hermetic EnvMap variant for tests
	src/extract_bash.zig = Extracts Bash functions and a file-level module for searchable top-level script content.
	src/extract_c.zig = C extractor using tree-sitter
	src/extract_elixir.zig = Elixir function extractor using a lightweight hand-rolled parser
	src/extract_generic.zig = Tree-sitter extractors for languages without a dedicated module: Ruby, Erlang, OCaml, Swift, LLVM IR, Clojure, assembly, and the fish/nu/PowerShell/Tcl/Oil shells
	src/extract_go.zig = Go extractor using tree-sitter
	src/extract_haskell.zig = Haskell extractor using tree-sitter
	src/extract_idris.zig = Idris 2 extractor using a line-based fallback parser (no maintained grammar)
	src/extract_lean.zig = Lean 4 extractor using tree-sitter
	src/extract_log.zig = Log-file extractor emitting one chunk per log line
	src/extract_lua.zig = Lua extractor using tree-sitter
	src/extract_markdown.zig = Extracts Markdown heading sections plus weighted description/tag frontmatter metadata, including YAML block-list tags.
	src/extract_nim.zig = Nim extractor using tree-sitter
	src/extract_nix.zig = Nix extractor using tree-sitter
	src/extract_python.zig = Python function/class indexing with decorator spans, nested name paths, multiline signatures, and docstrings
	src/extract_roc.zig = Roc source extraction with annotation-aware symbol spans
	src/extract_rust.zig = Rust extractor using tree-sitter
	src/extract_text.zig = Plain-text extractor chunking by paragraph, line, or sentence
	src/extract_typescript.zig = TypeScript/TSX extractor using tree-sitter
	src/extract_util.zig = Shared extractor helpers for doc-comment association and line splitting
	src/extract_zig.zig = Zig extractor built on the native std.zig AST
	src/filter.zig = Glob-to-regex compiler and PCRE2 matcher used for ignore-pattern matching
	src/filters.zig = Search/index filter list construction; pure with respect to the index — default search admits every code language rather than pinning the most-populous one
	src/freshness.zig = Watcher-aware pre-search reconciliation, stale fallback, and watcher-advisory classifiers
	src/fs_watch.zig = OS-native filesystem watch port: FSEvents on macOS, fanotify on Linux, polling fallback elsewhere
	src/hashline.zig = Three-character base-62 chained line hashes for content-anchored addressing; a hash depends on the previous line's, so any edit above cascades and stale line references are detected
	src/index_service.zig = Transport-neutral full/incremental indexing service owning filter, ignore, batch, dispatch, and read-only pending semantic-index count semantics.
	src/indexer.zig = Full and incremental indexing with crash-safe embedding completion, empty-input exclusion, successful-commit markers, and read-only exact pending-path counts.
	src/io_singleton.zig = Process-wide std.Io singleton bridging Zig 0.16's explicit Io; daemon and watcher paths must set() early or get() panics
	src/kind.zig = Type/category enum (code/doc/text/log) used by plugins and by index and search filters
	src/last_index.zig = Touches the empty project marker whose mtime records the last successful index commit
	src/line_index.zig = Precomputed line-offset table giving O(log n) byte-offset to line-number lookups instead of rescanning from byte 0 on every call
	src/log_cmd.zig = Platform log adapters with shared duration validation and root/output filtering
	src/lsp.zig = Minimal LSP client (JSON-RPC 2.0 over stdio with Content-Length framing) backing the references and rename commands
	src/main.zig = CLI dispatcher, inference fallback, watcher readiness/error reporting, and path-independent MCP registration
	src/mcp.zig = MCP JSON-RPC adapter: preserves existing searches through inference outages, returns actionable command errors, and exposes semantic-index pending-path metadata.
	src/mcp_install.zig = MCP self-registration policy: agent/scope model, argv builders for claude and codex, and the exhausted install-vs-skip decision
	src/mk_test_db.zig = Generates a tiny SQLite index for the CLI and HTTP suites; embedding dimension defaults to 1024, overridable via --embedding-dim
	src/model.zig = Core extracted-symbol data model, including optional symbol_kind/visibility/scope/arity metadata
	src/output.zig = Human/JSON result rendering; JSON carries freshness, confidence, inference-outage recovery, and watcher-backlog metadata.
	src/pcre2.zig = Minimal PCRE2 wrapper backing the ignore-pattern matcher
	src/pidfile.zig = Watcher pidfile lifecycle: liveness checks, atomic tryAcquirePid, and the bounded awaitClaim wait so 'Started' means started
	src/plugin.zig = Extractor interface, per-language Extractor records, and the default Registry that maps extensions to them
	src/plugins/assembly/mod.zig = Assembly plugin metadata (.s/.S/.asm) and generic extractor registration
	src/plugins/bash/mod.zig = Bash plugin metadata (.sh/.bash) and Tree-sitter extractor registration
	src/plugins/c/mod.zig = C plugin metadata (.c/.h) and Tree-sitter extractor registration
	src/plugins/clojure/mod.zig = Clojure plugin metadata (.clj/.cljs/.cljc/.edn) and Tree-sitter extractor registration
	src/plugins/common_lisp/mod.zig = Common Lisp language plugin metadata and Tree-sitter extractor registration.
	src/plugins/elixir/mod.zig = Elixir plugin metadata (.ex/.exs) and extractor registration
	src/plugins/elm/mod.zig = Elm language plugin metadata and Tree-sitter extractor registration.
	src/plugins/erlang/mod.zig = Erlang plugin metadata (.erl/.hrl) and Tree-sitter extractor registration
	src/plugins/fish/mod.zig = Fish language plugin metadata and Tree-sitter extractor registration.
	src/plugins/fsharp/mod.zig = F# language plugin metadata and Tree-sitter extractor registration.
	src/plugins/gleam/mod.zig = Gleam language plugin metadata and Tree-sitter extractor registration.
	src/plugins/go/mod.zig = Go plugin metadata (.go) and Tree-sitter extractor registration
	src/plugins/haskell/mod.zig = Haskell plugin metadata (.hs) and Tree-sitter extractor registration
	src/plugins/idris/mod.zig = Idris 2 plugin metadata (.idr) and line-based extractor registration
	src/plugins/lean/mod.zig = Lean 4 plugin metadata (.lean) and Tree-sitter extractor registration
	src/plugins/llvm/mod.zig = LLVM IR plugin metadata (.ll) and Tree-sitter extractor registration
	src/plugins/log/mod.zig = Log plugin metadata (.log)
	src/plugins/lua/mod.zig = Lua plugin metadata (.lua) and Tree-sitter extractor registration
	src/plugins/markdown/mod.zig = Markdown plugin metadata plus the README filename matcher
	src/plugins/nim/mod.zig = Nim plugin metadata (.nim) and Tree-sitter extractor registration
	src/plugins/nix/mod.zig = Nix plugin metadata (.nix) and Tree-sitter extractor registration
	src/plugins/nushell/mod.zig = Nushell language plugin metadata and Tree-sitter extractor registration.
	src/plugins/ocaml/mod.zig = OCaml plugin metadata (.ml/.mli) and Tree-sitter extractor registration
	src/plugins/oil/mod.zig = Oil Shell language plugin metadata with OSH/YSH extensions.
	src/plugins/powershell/mod.zig = PowerShell language plugin metadata and Tree-sitter extractor registration.
	src/plugins/python/mod.zig = Python source/stub extensions, dependency exclusions, and shared Python/PyPy interpreter recognition
	src/plugins/racket/mod.zig = Racket language plugin metadata over the pinned Scheme grammar.
	src/plugins/ruby/mod.zig = Ruby plugin metadata (.rb) and Tree-sitter extractor registration
	src/plugins/rust/mod.zig = Rust plugin metadata (.rs) and Tree-sitter extractor registration
	src/plugins/scheme/mod.zig = Scheme language plugin metadata and Tree-sitter extractor registration.
	src/plugins/sml/mod.zig = Standard ML language plugin metadata and Tree-sitter extractor registration.
	src/plugins/swift/mod.zig = Swift plugin metadata (.swift) and Tree-sitter extractor registration
	src/plugins/tcl/mod.zig = Tcl language plugin metadata and Tree-sitter extractor registration.
	src/plugins/text/mod.zig = Plain-text plugin metadata (.txt)
	src/plugins/typescript/mod.zig = TypeScript/TSX plugin metadata and Tree-sitter extractor registration
	src/plugins/wat/mod.zig = WAT/WAST plugin metadata with structural and behavioral extraction.
	src/plugins/zig/mod.zig = Zig plugin metadata (.zig) and native-AST extractor registration
	src/preflight.zig = Watcher-start preflight: server reachability, embedding-model availability, and index schema consistency, all decided in the parent because the daemon's stdio is closed
	src/progress.zig = Watcher progress file kept as a symlink into TMPDIR for low disk wear; codescan status reads it to report watcher activity
	src/retirement.zig = Pure watcher-retirement policy: shouldRetire over an injected clock, activity classification, idle-limit parsing (0/never disable) and duration formatting
	src/roc_signature.zig = Pure matching of partial Roc declaration signatures
	src/scan.zig = Git-aware source discovery, ignore classification, and extensionless shebang detection with one Git candidate-list subprocess
	src/search.zig = Candidate gathering and ranking, including explicit empty language constraints and query-embedding failure classification
	src/search_service.zig = Transport-neutral search application service for filters, weights, execution, and lexical retry when query embeddings become unavailable.
	src/server.zig = HTTP adapter for health, status, search, indexing, symbols, and edits; returns fallback metadata, watcher backlog, or 503 inference errors.
	src/setup_model_text.zig = Single embedding-model recommendation and provider-specific setup guidance
	src/simd.zig = SIMD (@Vector) case-insensitive substring search; a drop-in faster std.ascii.indexOfIgnoreCase on both NEON and SSE2
	src/storage.zig = SQLite persistence, schema reconciliation and connection-local bounded failure diagnostics
	src/symbol_tree.zig = Hierarchical symbol-tree model plus the native-Zig-AST extractor and human-readable tree formatting
	src/syslog.zig = Unix OS-log adapter; compiles log calls out on Windows while watcher failures persist project-locally.
	src/ts_symbols.zig = Tree-sitter symbol hierarchy and edit boundaries, including Python decorators and Roc annotations
	src/update_service.zig = Update-database lifecycle service: exhausted decideDbAction, and the two-phase prepare() that proves the live embedder's width before any rebuild
	src/watcher.zig = Native/polling loops with readiness, bounded retries, and durable daemon failures
	src/watcher_mgmt.zig = Cross-project watcher inventory; its numeric project PID fields keep unsupported Windows commands compilable while Unix parses ps and lsof output.
	src/weights.zig = Parses .codescan/weights.toml ([default] plus per-language vector/lexical weights and metadata boosts) and resolves them with explicit-override precedence
	test = Master test runner: accumulates failures across the unit, CLI, HTTP, and integration layers and exits with their combined status
	test_jina = Live acceptance gate proving fully local Ollama serves 1536-dimensional Jina embeddings
	test_jina_omlx = Live acceptance gate for the remote Tailscale Mac oMLX Jina fallback
	tests/cli/test-about = Actual CLI metadata contract with malformed settings and conflicting platform environment
	tests/cli/test-cli = Black-box CLI contracts for roots, filtering, inference failures, and path-independent MCP registration
	tests/cli/test-mcp-offline = Actual stdio MCP fallback, file/edit, and rejected-provider session regressions
	tests/cli/test-watcher-schema-preservation = Native CLI regression preserving an existing index after a rejected schema write
	tests/fixtures/source-closure = Read-only accepted/rejected input corpus for actual Nix package source filtering
	tests/http/test-http = Live HTTP adapter test; bounded Ollama preflight skips by default and strict mode requires it.
	tests/integration/test-integration = RAM-backed live integration test; bounded Ollama preflight skips by default and strict mode requires it.
	tests/lib/capture.bash = Portable RAM-only stdout/stderr/status capture for test scripts
	tests/lib/copy-source = Tracked-source fixture copy with lightweight searchable Git inventory
	tests/lib/run-isolated = Linux preventive read-only host boundary for prepared test execution
	tests/run-prepared = Complete runtime suite using immutable Nix artifacts and a disposable tracked-source copy
	tests/unit/test-build-all-contract = Structural test locking the supported five-target build_all matrix and final native build.
	tests/unit/test-build-nix = Disposable build adapter regressions for Nix modes, failures, symlink escape refusal and native publication
	tests/unit/test-capture = Text capture stream/status and shell-metacharacter regressions
	tests/unit/test-ci-architecture = Failure-injected CI publication guards and real Mach-O header classifier regressions
	tests/unit/test-ci-runner-contract = Complete CI runner/target/artifact matrix and required test-command contract
	tests/unit/test-dev-shell-cache = Regression proving nix develop preserves inherited nonempty Zig cache paths
	tests/unit/test-isolation = Forbidden-write canaries, concurrent namespace barriers, private state and exit-status qualification
	tests/unit/test-no-committed-secrets = Security regression rejecting tracked literal oMLX embedding API keys without echoing secrets
	tests/unit/test-portable-mcp-config = Set classifier rejecting machine-specific or unresolvable commands in the committed .mcp.json
	tests/unit/test-prepared-runner = FIFO-barrier regression for two-lane completion and failure propagation
	tests/unit/test-profiler-pin = Verify the pinned shared profiler in the isolated test environment
	tests/unit/test-reindex-all-projects = Isolated reindex-runner behavior tests using TMPDIR on macOS and Linux
	tests/unit/test-single-index-entrypoint = Structural control: indexer.indexAll/indexIncremental may only be called from index_service, so adapters cannot drift on filters or dimension
	tests/unit/test-source-fixture = Exact tracked-set, ignored-path, searchability, and overwrite regression
	tests/unit/test-unit = Runs prepared safety-enabled Zig unit tests with an outer hang guard
	tests/unit/test-unit-runner = Checks unit hang-guard arguments, output, and child/timeout exit statuses
]
