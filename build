#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 1
attribute=default
all_platforms=0
while [ "$#" -gt 0 ]; do
	case "$1" in
		debug|--debug)
			[ "$attribute" != test-binaries ] || { printf 'error: choose debug or test preparation, not both\n' >&2; exit 64; }
			attribute=debug ;;
		--test)
			[ "$attribute" != debug ] || { printf 'error: choose debug or test preparation, not both\n' >&2; exit 64; }
			attribute=test-binaries ;;
		--all|--all-plats|--all-platforms) all_platforms=1 ;;
		--all-impls|--all-implementations) ;; # Zig is the sole executable implementation.
		-h|--help)
			printf 'Usage: ./build [--debug|--test] [--all-impls] [--all-plats|--all]\nNix is required. ReleaseFast is the default.\nImplementation aliases: --all-impls, --all-implementations\nPlatform aliases: --all-plats, --all-platforms\n--all enables both scopes. Debug/test products are native-only.\nPublishes verified commands in bin/<PF>/ without changing PATH.\n'
			exit 0 ;;
		*) printf 'error: unsupported build option: %s\n' "$1" >&2; exit 64 ;;
	esac
	shift
done
if [ "$all_platforms" -eq 1 ] && [ "$attribute" != default ]; then
	printf 'error: all-platform builds support ReleaseFast only; debug/test products are native-only\n' >&2
	exit 64
fi
command -v nix >/dev/null 2>&1 || { printf 'error: Nix is required; install Nix before building codescan\n' >&2; exit 127; }
cd "$root" || exit 1
validate_retention() {
	local prefix="$1" directory="${1%/*}" parent
	for parent in .nix-out "$directory" "${directory%/*}"; do
		if [ -L "$parent" ] || { [ -e "$parent" ] && [ ! -d "$parent" ]; }; then
			printf 'error: refusing retained output through unexpected symlink/file: %s\n' "$parent" >&2
			return 1
		fi
	done
	if [ -e "$prefix" ] && [ ! -L "$prefix" ]; then
		printf 'error: refusing to replace a non-link retained output: %s\n' "$prefix" >&2
		return 1
	fi
}
validate_publication_lock() {
	local lock=.nix-out/.publication.lock
	if [ -L "$lock" ] || { [ -e "$lock" ] && { [ ! -f "$lock" ] || [ -s "$lock" ]; }; }; then
		printf 'error: refusing an unexpected publication lock file/link/directory\n' >&2
		return 1
	fi
}
validate_public_entry() {
	local prefix="$1" platform="${1#.nix-out/}" command_name=codescan parent previous namespace
	platform="${platform%%/*}"
	case "$platform" in mswin-*) command_name=codescan.exe ;; esac
	public_command="bin/$platform/$command_name"
	public_target="../../$prefix/bin/$command_name"
	for parent in bin "bin/$platform"; do
		if [ -L "$parent" ] || { [ -e "$parent" ] && [ ! -d "$parent" ]; }; then
			printf 'error: refusing public command through unexpected symlink/file: %s\n' "$parent" >&2
			return 1
		fi
	done
	if [ -L "$public_command" ]; then
		previous="$(readlink "$public_command")" || return "$?"
		namespace="../../${prefix%/*}"
		case "$previous" in
			"$namespace/ReleaseFast/bin/$command_name"|"$namespace/Debug/bin/$command_name") ;;
			*) printf 'error: refusing to replace an unrecognized public command link: %s\n' "$public_command" >&2; return 1 ;;
		esac
		[ ! -d "$public_command" ] || { printf 'error: public command resolves to a directory: %s\n' "$public_command" >&2; return 1; }
	elif [ -e "$public_command" ]; then
		printf 'error: refusing to replace a non-link public command: %s\n' "$public_command" >&2
		return 1
	fi
}
retention_works=()
publication=''
selected_prefixes=()
selected_products=()
previous_products=()
previous_available=()
previous_roots=()
public_commands=()
public_targets=()
previous_commands=()
public_stages=()
rollback_needed=0
keep_previous=0
restore_public_command() {
	local index="$1" command="${public_commands[$1]}" previous="${previous_commands[$1]}" current=''
	if [ -L "$command" ]; then current="$(readlink "$command")"; fi
	if [ -n "$previous" ] && [ "$current" = "$previous" ]; then return; fi
	if { [ -e "$command" ] && [ ! -L "$command" ]; } || { [ -n "$current" ] && [ "$current" != "${public_targets[$index]}" ]; }; then
		printf 'error: refusing rollback over an unexpected public command: %s\n' "$command" >&2
		keep_previous=1
	elif [ -n "$previous" ]; then
		if ln -sfn "$previous" "${public_stages[$index]}/entry" && mv -f -- "${public_stages[$index]}/entry" "$command"; then :; else
			printf 'error: could not restore public command: %s -> %s\n' "$command" "$previous" >&2
			keep_previous=1
		fi
	elif [ -L "$command" ]; then
		unlink "$command" || keep_previous=1
	fi
}
restore_selections() {
	local index prefix previous current restore_status
	for ((index=${#selected_prefixes[@]}-1; index>=0; index--)); do
		restore_public_command "$index"
		prefix="${selected_prefixes[$index]}"; previous="${previous_products[$index]}"
		current=''
		if [ -L "$prefix" ]; then current="$(readlink "$prefix")"; fi
		if [ -n "$previous" ] && [ "$current" = "$previous" ]; then continue; fi
		if { [ -e "$prefix" ] && [ ! -L "$prefix" ]; } || { [ -n "$current" ] && [ "$current" != "${selected_products[$index]}" ]; }; then
			printf 'error: refusing rollback over an unexpected selected output: %s\n' "$prefix" >&2
			keep_previous=1
			continue
		fi
		if [ -n "$previous" ]; then
			restore_status=0
			if [ "${previous_available[$index]}" -eq 1 ]; then
				nix-store --add-root "$prefix" --realise "$previous" >/dev/null || restore_status="$?"
			else
				# An originally dangling link has metadata, but no product to retain.
				ln -sfn "$previous" "$prefix" || restore_status="$?"
			fi
			if [ "$restore_status" -ne 0 ] || [ "$(readlink "$prefix")" != "$previous" ]; then
				printf 'error: could not restore previous selected output: %s -> %s\n' "$prefix" "$previous" >&2
				if [ "${previous_available[$index]}" -eq 1 ]; then
					printf 'error: previous product recovery root: %s/previous-%s\n' "$candidate_root" "$index" >&2
				fi
				keep_previous=1
			fi
		elif [ -L "$prefix" ]; then
			unlink "$prefix" || keep_previous=1
		fi
	done
}
cleanup_publication() {
	local retention_work previous_root public_stage
	if [ "$rollback_needed" -eq 1 ]; then restore_selections; fi
	if [ -n "$publication" ] && [ -f "$publication" ]; then unlink "$publication"; fi
	if [ "$keep_previous" -eq 1 ]; then
		printf 'error: rollback incomplete; previous products remain retained for recovery in %s\n' "$candidate_root" >&2
		return
	fi
	for public_stage in "${public_stages[@]}"; do
		if [ -L "$public_stage/entry" ]; then unlink "$public_stage/entry"; fi
		rmdir "$public_stage"
	done
	for previous_root in "${previous_roots[@]}"; do
		if [ -L "$previous_root" ]; then unlink "$previous_root"; fi
	done
	for retention_work in "${retention_works[@]}"; do
		if [ -L "$retention_work/tools" ]; then unlink "$retention_work/tools"; fi
		if [ -L "$retention_work/result" ]; then unlink "$retention_work/result"; fi
		rmdir "$retention_work"
	done
}
trap cleanup_publication EXIT
prepare_product() {
	local prefix="$1" attribute="$2" target="$3" retention_work executable=codescan
	mkdir -p "${prefix%/*}" || return "$?"
	retention_work="$(mktemp -d "$root/${prefix%/*}/.candidate.XXXXXXXX")" || return "$?"
	retention_works+=("$retention_work")
	candidate_root="$retention_work"
	if candidate_output="$(nix build --out-link "$retention_work/result" --print-out-paths "$attribute")"; then :; else return "$?"; fi
	if [ -z "$candidate_output" ] || [ "$(readlink "$retention_work/result")" != "$candidate_output" ]; then
		printf 'error: Nix output does not match its retained candidate\n' >&2
		return 1
	fi
	case "$target" in *-windows-gnu) executable=codescan.exe ;; esac
	ci_verify_release "$target" "$candidate_output/bin/$executable"
}
if [ "$attribute" != test-binaries ]; then
	case "$(uname -s)/$(uname -m)" in
		Linux/x86_64) native_namespace=linux-amd64/musl; native_target=x86_64-linux-musl ;;
		Linux/aarch64) native_namespace=linux-arm64/musl; native_target=aarch64-linux-musl ;;
		Darwin/arm64) native_namespace=macos-arm64; native_target=aarch64-macos ;;
		*) printf 'error: native Nix builds support Linux x86_64/aarch64 and macOS arm64\n' >&2; exit 69 ;;
	esac
	profile=ReleaseFast
	[ "$attribute" != debug ] || profile=Debug
	native_prefix=".nix-out/$native_namespace/$profile"
	validate_retention "$native_prefix" || exit 1
	validate_public_entry "$native_prefix" || exit 1
	validate_publication_lock || exit 1
	source "$root/scripts/ci-verify-release" || exit "$?"
fi
if [ "$all_platforms" -eq 1 ]; then
	targets=(macos-arm64 linux-arm64 linux-amd64 mswin-arm64 mswin-amd64)
	prefixes=()
	# Validate every retained-output parent before any build or publication.
	for target in "${targets[@]}"; do
		case "$target" in
			macos-*) variant= ;;
			linux-*) variant=musl/ ;;
			mswin-*) variant=gnu/ ;;
		esac
		prefix=".nix-out/$target/${variant}ReleaseFast"
		prefixes+=("$prefix")
		validate_retention "$prefix" || exit 1
		validate_public_entry "$prefix" || exit 1
	done
	products=()
	for index in "${!targets[@]}"; do
		prefix="${prefixes[$index]}"
		case "${targets[$index]}" in
			macos-arm64) compiler_target=aarch64-macos ;;
			linux-arm64) compiler_target=aarch64-linux-musl ;;
			linux-amd64) compiler_target=x86_64-linux-musl ;;
			mswin-arm64) compiler_target=aarch64-windows-gnu ;;
			mswin-amd64) compiler_target=x86_64-windows-gnu ;;
			*) printf 'error: unsupported product target\n' >&2; exit 64 ;;
		esac
		prepare_product "$prefix" ".#release-${targets[$index]}" "$compiler_target" || exit "$?"
		products+=("$candidate_output")
	done
fi
if [ "$attribute" = test-binaries ]; then
	if output="$(nix build --no-link --print-out-paths ".#$attribute")"; then :; else exit "$?"; fi
	printf 'Prepared test artifacts: %s\n' "$output" >&2
	exit 0
fi
# No selected root changes until the complete requested batch is verified.
prepare_product "$native_prefix" ".#$attribute" "$native_target" || exit "$?"
output="$candidate_output"
if [ -L zig-out ] || [ -L zig-out/bin ] || [ -d zig-out/bin/codescan ]; then
	printf 'error: refusing publication through an unexpected output symlink/directory\n' >&2
	exit 1
fi
mkdir -p zig-out/bin || exit 1
publication="$(mktemp "$root/zig-out/bin/.codescan.XXXXXX")" || exit 1
install -m755 "$output/bin/codescan" "$publication" || exit 1
if tools_output="$(nix build --out-link "$candidate_root/tools" --print-out-paths .#publication-tools)"; then :; else exit "$?"; fi
if [ -z "$tools_output" ] || [ "$(readlink "$candidate_root/tools")" != "$tools_output" ] || [ ! -x "$tools_output/bin/flock" ]; then
	printf 'error: Nix publication tools are missing or do not match their retained candidate\n' >&2
	exit 1
fi
validate_publication_lock || exit 1
# Keep this inode across invocations. The inherited descriptor retains the
# kernel lease after flock exits; process exit releases it without a stale PID.
exec 9>>.nix-out/.publication.lock || exit "$?"
if "$tools_output/bin/flock" -n -E 75 9; then :; else
	status="$?"
	if [ "$status" -eq 75 ]; then
		printf 'error: another publisher is selecting products; retry after it exits\n' >&2
	else
		printf 'error: native publication lease failed (exit %s)\n' "$status" >&2
	fi
	exit "$status"
fi
if [ "$all_platforms" -eq 1 ]; then
	for index in "${!targets[@]}"; do
		# The explicit native request owns this profile's final selection.
		[ "${prefixes[$index]}" != "$native_prefix" ] || continue
		selected_prefixes+=("${prefixes[$index]}")
		selected_products+=("${products[$index]}")
	done
fi
selected_prefixes+=("$native_prefix")
selected_products+=("$output")
# Retain every prior complete product before changing any selected GC root.
for index in "${!selected_prefixes[@]}"; do
	prefix="${selected_prefixes[$index]}"
	validate_retention "$prefix" || exit 1
	previous=''; available=0
	if [ -L "$prefix" ]; then
		previous="$(readlink "$prefix")" || exit "$?"
		if [ -e "$prefix" ]; then
			available=1
			previous_root="$candidate_root/previous-$index"
			previous_roots+=("$previous_root")
			nix-store --add-root "$previous_root" --realise "$previous" >/dev/null || exit "$?"
			[ "$(readlink "$previous_root")" = "$previous" ] || { printf 'error: previous product lacks its rollback retention root\n' >&2; exit 1; }
		fi
	fi
	previous_products+=("$previous")
	previous_available+=("$available")
	validate_public_entry "$prefix" || exit 1
	public_commands+=("$public_command")
	public_targets+=("$public_target")
	previous=''
	if [ -L "$public_command" ]; then previous="$(readlink "$public_command")" || exit "$?"; fi
	previous_commands+=("$previous")
	mkdir -p "${public_command%/*}" || exit "$?"
	public_stage="$(mktemp -d "$root/${public_command%/*}/.candidate.XXXXXXXX")" || exit "$?"
	public_stages+=("$public_stage")
	ln -s "$public_target" "$public_stage/entry" || exit "$?"
done
rollback_needed=1
for index in "${!selected_prefixes[@]}"; do
	prefix="${selected_prefixes[$index]}"; product="${selected_products[$index]}"
	nix-store --add-root "$prefix" --realise "$product" >/dev/null || exit "$?"
	[ "$(readlink "$prefix")" = "$product" ] || { printf 'error: selected output does not match the verified product\n' >&2; exit 1; }
done
for index in "${!public_commands[@]}"; do
	mv -f -- "${public_stages[$index]}/entry" "${public_commands[$index]}" || exit "$?"
done
mv -f -- "$publication" zig-out/bin/codescan || exit 1
rollback_needed=0
