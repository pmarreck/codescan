#!/usr/bin/env bash
set -u

source "$(dirname "${BASH_SOURCE[0]}")/../lib/capture.bash"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="${CODESCAN_TEST_BIN:?prepare test binaries with ./test}"
MK_DB="${CODESCAN_TEST_DB_BIN:?prepare the fixture generator with ./test}"

out=
err=
rc=

fail() {
	printf '%s\n' "error: $1" >&2
	exit 1
}

require_tool() {
	local tool="$1"
	if ! command -v "$tool" >/dev/null 2>&1; then
		fail "missing required tool: $tool (run via 'nix develop -c ./tests/cli/test-cli')"
	fi
}

search_names() {
	local query="$1"
	shift
	capture "$BIN" search "$query" --db "$DB" --mode lexical --json "$@"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "codescan search failed"
	fi
	printf '%s' "$out" | jq -r '.results[].name'
}

main() {
	require_tool jq
	require_tool rg
	require_tool cmp

	[ -x "$BIN" ] && [ -x "$MK_DB" ] || fail 'prepared test artifacts are unavailable'

	DB_DIR="$(mktemp -d "$TMPDIR/codescan-cli.XXXXXX")"
	DB="$DB_DIR/index.sqlite3"
	trap 'rm -rf "$DB_DIR"' EXIT

	capture "$MK_DB" --db "$DB"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "mk_test_db failed"
	fi
	cd "$DB_DIR" || fail "could not enter the private fixture directory"
	[ "$PWD" -ef "$DB_DIR" ] || fail "CLI test commands must run in their private fixture directory, not the caller's index root"

	for query in checksum ''; do
		for constraint in zig:doc markdown:code; do
			language="${constraint%:*}"
			content_type="${constraint#*:}"
			capture "$BIN" search "$query" --db "$DB" --mode lexical --lang "$language" --type "$content_type" --json
			[ "$rc" -eq 0 ] || fail "contradictory language/type filters failed instead of returning an empty set: $err"
			printf '%s' "$out" | jq -e '.results == []' >/dev/null || \
				fail "contradictory language/type filters broadened the candidate set: $out"
		done
	done
	capture "$BIN" search checksum_fn --db "$DB" --mode lexical --lang zig --type code --json
	[ "$rc" -eq 0 ] || fail 'matching code filters failed'
	printf '%s' "$out" | jq -e '[.results[].name] == ["checksum_fn"]' >/dev/null || fail 'matching code filters returned the wrong set'
	capture "$BIN" search checksum --db "$DB" --mode lexical --lang markdown --type doc --json
	[ "$rc" -eq 0 ] || fail 'matching document filters failed'
	printf '%s' "$out" | jq -e '[.results[].name] == ["Checksum Docs"]' >/dev/null || fail 'matching document filters returned the wrong set'
	for query in checksum_fn ''; do
		capture "$BIN" search "$query" --db "$DB" --mode lexical --path '**/sum.zig' --json
		[ "$rc" -eq 0 ] || fail 'whole-component path filter failed'
		printf '%s' "$out" | jq -e '.results == []' >/dev/null || fail 'recursive path filter matched only a basename suffix'
	done
	capture "$BIN" search checksum_fn --db "$DB" --mode lexical --path '**/checksum.zig' --json
	[ "$rc" -eq 0 ] || fail 'matching recursive path filter failed'
	printf '%s' "$out" | jq -e '[.results[].name] == ["checksum_fn"]' >/dev/null || fail 'matching recursive path filter returned the wrong set'

	# A bad log duration is a CLI usage error. Keep stdout available for log
	# records so shell callers do not have to strip a diagnostic from their data.
	capture "$BIN" log --root "$DB_DIR" --since 0h
	[ "$rc" -eq 64 ] || fail "invalid log duration did not exit with usage status"
	[ -z "$out" ] || fail "invalid log duration wrote its diagnostic to stdout"
	printf '%s' "$err" | rg -q "invalid --since '0h'" || \
		fail "invalid log duration did not explain the accepted shorthand"

	fresh_root="$DB_DIR/fresh-search"
	mkdir -p "$fresh_root/.git"
	printf '%s\n' \
		'/// Finds a freshly indexed value.' \
		'pub fn freshSearchValue() usize { return 42; }' \
		> "$fresh_root/fresh.zig"
	capture "$BIN" search freshSearchValue --root "$fresh_root" --lexical-only \
		--ollama-url http://127.0.0.1:1 --json
	[ "$rc" -eq 0 ] || fail "fresh search could not create its index"
	[ "$(printf '%s' "$out" | jq '.results | length')" -gt 0 ] || fail "fresh search omitted the new source file"
	[ "$(printf '%s' "$out" | jq -r '.freshness')" = reconciled ] || fail "fresh search omitted reconciled metadata"
	[ ! -e "$fresh_root/.codescan/watcher.pid" ] || fail "fresh search implicitly started a watcher"

	cross_case_root="$DB_DIR/cross-case-identifiers"
	mkdir -p "$cross_case_root/.git" || fail 'cross-case fixture setup'
	printf '%s\n' \
		'pub fn parseHttpResponse() void {}' \
		'pub fn parse_http_response() void {}' \
		'pub fn invoke(callback: @TypeOf(parseHttpResponse)) void { _ = callback; }' \
		'pub fn parseHttpRequest() void {}' \
		'pub fn renderHttpResponse() void {}' \
		'pub fn parseResponse() void {}' \
		'pub fn parseAhttpBresponse() void {}' > "$cross_case_root/cases.zig"
	capture "$BIN" index --root "$cross_case_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "cross-case fixture index failed: $err"
	for query in parseHttpResponse parse_http_response; do
		for fts_mode in broad balanced strict; do
			capture "$BIN" search "$query" --root "$cross_case_root" --mode lexical --fts-mode "$fts_mode" --top 20 --json
			[ "$rc" -eq 0 ] || fail "cross-case search failed: $err"
			printf '%s' "$out" | jq -e '[.results[].name] | sort == ["invoke", "parseHttpResponse", "parse_http_response"]' >/dev/null || \
				fail "cross-case search lost a complete identifier or added unrelated symbols ($query/$fts_mode): $out"
			printf '%s' "$out" | jq -e 'all(.results[]; .lexical_sources.signature == true and (.lexical_sources.name == (.name != "invoke")))' >/dev/null || \
				fail "cross-case search omitted matched-field evidence ($query/$fts_mode): $out"
		done
	done

	zig_signature_root="$DB_DIR/zig-signatures"
	mkdir -p "$zig_signature_root/.git" || fail 'Zig signature fixture setup'
	printf '%s\n' 'pub fn ceil(value: f64) f64 { return value; }' \
		'pub fn ceiling(value: f64) f64 { return value; }' > "$zig_signature_root/input.zig"
	printf '%s\n' 'pub fn ceil() f64 { return 1; }' > "$zig_signature_root/zero.zig"
	printf '%s\n' 'pub fn ceil(value: f32) f32 { return value; }' > "$zig_signature_root/other.zig"
	capture "$BIN" index --root "$zig_signature_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "Zig signature fixture index failed: $err"
	zig_signature_queries=('ceil : -> f64' 'fn ceil(...) f64' 'ceil : f64 -> f64' 'fn ceil(renamed: f64) f64' 'fn ceil() f64' 'ceil : -> f32' 'ceil : -> f16')
	zig_signature_expected=('input.zig zero.zig' 'input.zig zero.zig' 'input.zig' 'input.zig' 'zero.zig' 'other.zig' '')
	for i in "${!zig_signature_queries[@]}"; do
		capture "$BIN" search "${zig_signature_queries[$i]}" --root "$zig_signature_root" --mode lexical --top 20 --json
		[ "$rc" -eq 0 ] || fail "Zig signature query failed: $err"
		actual="$(printf '%s' "$out" | jq -r '[.results[] | select(.name == "ceil" and .language == "zig") | .file_path | split("/")[-1]] | sort | join(" ")')" || fail 'invalid Zig signature result paths'
		[ "$actual" = "${zig_signature_expected[$i]}" ] || fail "Zig signature query returned the wrong set (${zig_signature_queries[$i]}): $out"
		printf '%s' "$out" | jq -e 'all(.results[]; .name == "ceil" and .language == "zig" and .lexical_sources.name and .lexical_sources.signature)' >/dev/null || \
			fail "Zig signature query broadened the name or omitted matching evidence: $out"
	done
	capture "$BIN" search 'ceil : -> f64' --root "$zig_signature_root" --mode lexical --lang roc --json
	[ "$rc" -eq 0 ] || fail 'Zig signature language exclusion failed'
	printf '%s' "$out" | jq -e '.results == []' >/dev/null || fail 'signature query ignored the language filter'

	rust_signature_root="$DB_DIR/rust-signatures"
	mkdir -p "$rust_signature_root/.git" || fail 'Rust signature fixture setup'
	printf '%s\n' 'pub fn ceil(value: f64) -> f64 { value }' \
		'pub fn ceiling(value: f64) -> f64 { value }' > "$rust_signature_root/input.rs"
	printf '%s\n' 'pub fn ceil() -> f64 { 1.0 }' > "$rust_signature_root/zero.rs"
	printf '%s\n' 'pub fn ceil(value: f32) -> f32 { value }' > "$rust_signature_root/other.rs"
	printf '%s\n' 'pub struct Rounder;' 'impl Rounder {' \
		'pub fn ceil(&self, value: f64) -> f64 { value }' '}' > "$rust_signature_root/method.rs"
	printf '%s\n' 'pub fn identity<T: Copy>(value: T) -> T where T: Send { value }' > "$rust_signature_root/generic.rs"
	capture "$BIN" index --root "$rust_signature_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "Rust signature fixture index failed: $err"
	rust_signature_queries=('ceil : -> f64' 'fn ceil(...) -> f64' 'ceil : f64 -> f64' 'fn ceil(renamed: f64) -> f64' 'fn ceil() -> f64' 'ceil : &Self, f64 -> f64' 'ceil : -> f16' 'identity : -> T' 'fn identity<T: Copy>(...) -> T where T: Send' 'fn identity<T: Clone>(...) -> T where T: Send')
	rust_signature_expected=('input.rs method.rs zero.rs' 'input.rs method.rs zero.rs' 'input.rs' 'input.rs' 'zero.rs' 'method.rs' '' 'generic.rs' 'generic.rs' '')
	for i in "${!rust_signature_queries[@]}"; do
		capture "$BIN" search "${rust_signature_queries[$i]}" --root "$rust_signature_root" --mode lexical --top 20 --json
		[ "$rc" -eq 0 ] || fail "Rust signature query failed: $err"
		actual="$(printf '%s' "$out" | jq -r '[.results[].file_path | split("/")[-1]] | sort | join(" ")')" || fail 'invalid Rust signature result paths'
		[ "$actual" = "${rust_signature_expected[$i]}" ] || fail "Rust signature query returned the wrong set (${rust_signature_queries[$i]}): $out"
		printf '%s' "$out" | jq -e 'all(.results[]; .language == "rust" and .lexical_sources.name and .lexical_sources.signature)' >/dev/null || fail "Rust signature query omitted matching evidence: $out"
	done

	c_file="$DB_DIR/functions with spaces.c"
	printf '%s\n' '// Adds two values.' 'int add(int left, int right) {' \
		$'\treturn left + right;' '}' 'int prototype(int value);' 'static void adjacent(void) {}' > "$c_file"
	capture "$BIN" symbols --file "$c_file" --json
	[ "$rc" -eq 0 ] || fail "C symbol listing failed: $err"
	printf '%s' "$out" | jq -e '[.[]|{name,kind,start_line,end_line}] == [{name:"add",kind:"fn",start_line:2,end_line:4},{name:"adjacent",kind:"fn",start_line:6,end_line:6}]' >/dev/null || \
		fail "C grammar changed the complete function set or source ranges: $out"
	capture "$BIN" symbols add --file "$c_file" --include-body --json
	[ "$rc" -eq 0 ] || fail "C function body lookup failed: $err"
	printf '%s' "$out" | jq -e '.name_path=="add" and .start_line==2 and .end_line==4 and .body==["int add(int left, int right) {","\treturn left + right;","}"]' >/dev/null || \
		fail "C grammar changed the exact function body: $out"

	python_root="$DB_DIR/python project"
	mkdir -p "$python_root/.git" "$python_root/.venv" "$python_root/package"
	python_file="$python_root/client with spaces.py"
	printf '%s\n' \
		'@registry.register' 'class Client:' \
		'    """Manages quasar responses."""' \
		'    @staticmethod' '    async def fetch(url: str) -> bytes:' \
		'        """Fetches the nebula payload."""' \
		'        return await read(url)' '' \
		'def adjacent(): return 42' > "$python_file"
	printf '%s\n' 'def parse(value: str) -> int: ...' > "$python_root/package/api.pyi"
	printf '%s\n' '#!/usr/bin/env -S python3.13 -u' 'def script_entry(): pass' > "$python_root/tool"
	chmod +x "$python_root/tool"
	printf '%s\n' 'def excluded_dependency(): pass' > "$python_root/.venv/dependency.py"
	capture "$BIN" index --root "$python_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "Python initial index failed: $err"
	capture "$BIN" search --root "$python_root" --lang python --kind fn --mode lexical --json --top 50
	[ "$rc" -eq 0 ] || fail "Python function browse failed: $err"
	printf '%s' "$out" | jq -e '[.results[].name] | sort == ["Client/fetch", "adjacent", "parse", "script_entry"]' >/dev/null || \
		fail "Python browse returned the wrong symbol set: $out"
	capture "$BIN" search nebula --root "$python_root" --lang python --only-comments --mode lexical --json
	[ "$rc" -eq 0 ] || fail "Python docstring search failed: $err"
	printf '%s' "$out" | jq -e '.results | length == 1 and .[0].name == "Client/fetch"' >/dev/null || \
		fail "Python docstring search omitted its method: $out"
	capture "$BIN" symbols Client/fetch --file "$python_file" --include-body --json
	[ "$rc" -eq 0 ] || fail "Python symbol lookup failed: $err"
	printf '%s' "$out" | jq -e '.body | join("\n") | contains("@staticmethod") and contains("async def fetch")' >/dev/null || \
		fail "Python symbol body omitted its decorator: $out"
	capture "$BIN" read-file "$python_file" --json
	[ "$rc" -eq 0 ] || fail "Python version read failed: $err"
	python_version="$(printf '%s' "$out" | jq -r '.version')"
	capture bash -c 'printf "%s\n" "    @classmethod" "    def fetch(cls, url):" "        return b\"replacement\"" | "$@"' _ \
		"$BIN" replace-symbol Client/fetch --file "$python_file" --version "$python_version"
	[ "$rc" -eq 0 ] || fail "Python method replacement failed: $err"
	if rg -q '@staticmethod|async def fetch' "$python_file"; then fail "Python replacement left a stale decorator or signature"; fi
	rg -q '^    @classmethod$' "$python_file" || fail "Python replacement changed the method indentation"
	rg -q '^@registry.register$' "$python_file" || fail "Python replacement removed its class decorator"
	rg -q '^def adjacent' "$python_file" || fail "Python replacement removed its neighbor"
	capture "$BIN" update --root "$python_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "Python incremental update failed: $err"
	capture "$BIN" search replacement --root "$python_root" --lang python --mode lexical --json
	[ "$rc" -eq 0 ] || fail "Python search after update failed: $err"
	printf '%s' "$out" | jq -e '.results[] | select(.name == "Client/fetch")' >/dev/null || \
		fail "Python update did not replace indexed method content: $out"
	capture "$BIN" help languages
	[ "$rc" -eq 0 ] || fail "language help failed"
	printf '%s' "$out" | rg -q 'Python' || fail "language help omitted Python"
	if printf '%s' "$out" | rg -q 'Python and Scala are intentionally unsupported'; then fail "language help still rejects Python"; fi

	roc_root="$DB_DIR/roc"
	mkdir -p "$roc_root/.git"
	printf '%s\n' \
		'## Rounds up a decimal.' 'ceil :' $'\tDec' $'\t-> Dec' \
		'ceil = |value| value' '' 'ceiling : Dec -> Str' 'ceiling = |value| "Dec"' \
		> "$roc_root/Dec.roc"
	capture "$BIN" index --root "$roc_root" --lexical-only
	[ "$rc" -eq 0 ] || fail "Roc lexical index failed: $err"
	cp "$roc_root/.codescan/index.sqlite3" "$DB_DIR/roc-before.sqlite3"
	capture env CODESCAN_INDEX_WORKERS=0 "$BIN" index --root "$roc_root" --lexical-only
	[ "$rc" -ne 0 ] || fail "initial indexing accepted an invalid worker count"
	printf '%s' "$err" | rg -q 'CODESCAN_INDEX_WORKERS must be an integer from 1 through 64' || \
		fail "invalid worker count omitted recovery guidance"
	cmp -s "$DB_DIR/roc-before.sqlite3" "$roc_root/.codescan/index.sqlite3" || \
		fail "invalid worker count destroyed the existing index"
	capture "$BIN" search 'ceil : -> Dec' --root "$roc_root" --mode lexical --json
	[ "$rc" -eq 0 ] || fail "Roc signature query failed: $err"
	printf '%s' "$out" | jq -e '.results | length == 1 and .[0].name == "ceil" and .[0].language == "roc"' >/dev/null || \
		fail "Roc partial signature query returned the wrong declarations: $out"
	capture "$BIN" symbols ceil --file "$roc_root/Dec.roc" --include-body --json
	[ "$rc" -eq 0 ] || fail "Roc symbol lookup failed: $err"
	printf '%s' "$out" | jq -e '.body | join("\n") | contains("ceil :") and contains("ceil =")' >/dev/null || \
		fail "Roc symbol body omitted its annotation"
	capture "$BIN" read-file "$roc_root/Dec.roc" --json
	[ "$rc" -eq 0 ] || fail "Roc version read failed: $err"
	roc_version="$(printf '%s' "$out" | jq -r '.version')"
	capture bash -c 'printf "%s\n" "ceil : Dec -> Dec" "ceil = |value| value + 1" | "$@"' _ \
		"$BIN" replace-symbol ceil --file "$roc_root/Dec.roc" --version "$roc_version"
	[ "$rc" -eq 0 ] || fail "Roc symbol replacement failed: $err"
	[ "$(rg -c '^ceil :' "$roc_root/Dec.roc")" -eq 1 ] || fail "Roc replacement left a stale annotation"
	rg -q '^ceiling = ' "$roc_root/Dec.roc" || fail "Roc replacement removed a neighboring declaration"

	offline_root="$DB_DIR/offline-inference"
	mkdir -p "$offline_root/.git"
	printf '%s\n' 'pub fn indexedBeforeOutage() void {}' > "$offline_root/offline.zig"
	capture "$BIN" index --root "$offline_root" --lexical-only --ollama-url http://127.0.0.1:1
	[ "$rc" -eq 0 ] || fail "lexical-only index failed: $err"
	offline_db="$offline_root/.codescan/index.sqlite3"
	cmp_backup="$DB_DIR/offline-before.sqlite3"
	cp "$offline_db" "$cmp_backup"

	# A normal search retains its usable index when the embedding service goes
	# away, reports the fallback in JSON for agents, and never tries to index.
	capture "$BIN" search indexedBeforeOutage --root "$offline_root" --ollama-url http://127.0.0.1:1 --json
	[ "$rc" -eq 0 ] || fail "search did not degrade to the existing lexical index: $err"
	printf '%s' "$out" | jq -e '.results[] | select(.name == "indexedBeforeOutage")' >/dev/null || \
		fail "offline search omitted the existing indexed symbol"
	[ "$(printf '%s' "$out" | jq -r '.inference_unavailable')" = true ] || \
		fail "offline search omitted inference_unavailable metadata"
	printf '%s' "$out" | jq -r '.inference_help' | rg -q 'Start or repair the server' || \
		fail "offline search omitted the recovery instruction for agents"

	# A normal index requires embeddings. It must fail before opening the database
	# in recreate mode, leaving the usable prior index byte-for-byte unchanged.
	capture bash -c 'exec "$@" < /dev/null' _ \
		"$BIN" index --root "$offline_root" --ollama-url http://127.0.0.1:1
	[ "$rc" -ne 0 ] || fail "semantic index unexpectedly succeeded without inference"
	printf '%s' "$err" | rg -q 'Embedding server unreachable' || \
		fail "offline semantic index did not explain the unavailable server"
	cmp -s "$cmp_backup" "$offline_db" || \
		fail "offline semantic index changed the existing database"

	# Doctor must be a real diagnostic command, not a search fallback. A stopped
	# watcher is informational, while an unavailable inference server remains a
	# failed check and causes a non-zero exit.
	doctor_root="$DB_DIR/doctor"
	mkdir -p "$doctor_root/.git" "$doctor_root/.codescan"
	printf '%s\n' \
		'embedding_url=http://127.0.0.1:1' \
		'embedding_model=test-model' \
		'embedding_api=ollama' \
		> "$doctor_root/.codescan/config.ini"
	capture "$MK_DB" --db "$doctor_root/.codescan/index.sqlite3"
	[ "$rc" -eq 0 ] || fail "mk-test-db could not create the doctor fixture: $err"
	capture "$BIN" doctor --root "$doctor_root" --json
	[ "$rc" -ne 0 ] || fail "doctor unexpectedly accepted an unavailable inference server"
	printf '%s' "$out" | jq -e '.ok == false' >/dev/null || fail "doctor did not report a failed health result"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Settings" and .status == "pass")' >/dev/null || \
		fail "doctor did not validate settings"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Database" and .status == "pass")' >/dev/null || \
		fail "doctor did not validate SQLite integrity"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Inference" and .status == "fail")' >/dev/null || \
		fail "doctor did not report unavailable inference"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Watcher" and .status == "note" and .message == "stopped")' >/dev/null || \
		fail "doctor treated a stopped watcher as a failure"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Permissions" and .status == "pass")' >/dev/null || \
		fail "doctor did not validate project-state permissions"
	printf '%s' "$err" | rg -q "assuming 'search'" && fail "doctor fell back to search"

	invalid_doctor_root="$DB_DIR/doctor-invalid-settings"
	mkdir -p "$invalid_doctor_root/.git" "$invalid_doctor_root/.codescan"
	printf '%s\n' 'embedding_dim=not-a-number' > "$invalid_doctor_root/.codescan/config.ini"
	capture "$BIN" doctor --root "$invalid_doctor_root" --json
	[ "$rc" -ne 0 ] || fail "doctor accepted malformed settings"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Settings" and .status == "fail")' >/dev/null || \
		fail "doctor did not report malformed settings"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Inference" and .status == "skipped")' >/dev/null || \
		fail "doctor tried inference after malformed settings"

	mv "$fresh_root/fresh.zig" "$fresh_root/fresh.zig.off"
	capture "$BIN" search freshSearchValue --root "$fresh_root" --mode lexical --json
	[ "$rc" -eq 0 ] || fail "fresh search failed after deleting the indexed source"
	[ "$(printf '%s' "$out" | jq '.results | length')" -eq 0 ] || fail "fresh search retained data for a deleted source file"
	printf '%s' "$err" | rg -q 'No index found' && fail "fresh search redundantly auto-indexed after reconciliation"
	[ ! -e "$fresh_root/.codescan/watcher.pid" ] || fail "deleted-file search implicitly started a watcher"

	names=$(search_names "checksum")
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' && fail "default search included docs unexpectedly"

	names=$(search_names "checksum" --include-docs)
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "include-docs missing docs"

	names=$(search_names "checksum" --docs)
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "docs-only missing docs"
	printf '%s\n' "$names" | rg -q '^checksum_fn$' && fail "docs-only included code"

	names=$(search_names "checksum" --only-docs)
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "only-docs missing docs"

	names=$(search_names "checksum" --scope docs)
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "scope=docs missing docs"
	printf '%s\n' "$names" | rg -q '^checksum_fn$' && fail "scope=docs included code"

	names=$(search_names "checksum" --scope code)
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' && fail "scope=code included docs"

	names=$(search_names "checksum" --comments --lang zig)
	printf '%s\n' "$names" | rg -q '^hash_bytes$' || fail "comments-only missing commented symbol"
	printf '%s\n' "$names" | rg -q '^checksum_fn$' && fail "comments-only included non-commented symbol"

	names=$(search_names "checksum" --only-comments --lang zig)
	printf '%s\n' "$names" | rg -q '^hash_bytes$' || fail "only-comments missing commented symbol"

	capture "$BIN" search "zzzzzzzzzz" --db "$DB" --mode lexical --json --min-score 1
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "no-results search failed"
	fi
	count=$(printf '%s' "$out" | jq '.results | length')
	[ "$count" -eq 0 ] || fail "expected no results for missing query"
	printf '%s' "$err" | rg -q 're-?index' || fail "missing reindex suggestion on empty results"

	capture "$BIN" help search
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "help search failed"
	fi
	printf '%s' "$out" | rg -q '^Usage: codescan search' || fail "help search did not print focused usage"

	capture "$BIN" help doctor
	[ "$rc" -eq 0 ] || fail "help doctor failed"
	printf '%s' "$out" | rg -q '^Usage: codescan doctor' || fail "help doctor did not print focused usage"
	printf '%s' "$out" | rg -q 'stopped watcher' || fail "doctor help did not explain stopped watcher status"

	capture "$BIN" search --help
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "search --help failed"
	fi
	printf '%s' "$out" | rg -q '^Usage: codescan search' || fail "search --help did not print focused usage"
	printf '%s' "$out" | rg -q -- '--lexical-only' || fail "search help omitted lexical-only mode"

	capture "$BIN" --no-progress update --help
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "global --no-progress before update failed"
	fi
	printf '%s' "$out" | rg -q '^Usage: codescan update' || fail "global --no-progress obscured focused update help"
	printf '%s' "$out" | rg -q -- '--no-progress' || fail "update help omitted --no-progress"

	read_root="$DB_DIR/read-file-root"
	read_caller="$DB_DIR/read-file-caller"
	mkdir -p "$read_root/.git" "$read_root/bin" "$read_caller"
	printf '%s\n' 'ref: refs/heads/yolo' > "$read_root/.git/HEAD"
	printf '%s\n' 'root-relative-read-marker' > "$read_root/bin/example"

	capture bash -c 'cd "$1" && "$2" read-file --root "$3" bin/example' _ \
		"$read_caller" "$BIN" "$read_root"
	[ "$rc" -eq 0 ] || fail "read-file rejected --root after the verb: $err"
	printf '%s' "$out" | rg -q 'root-relative-read-marker' || \
		fail "read-file after-verb --root did not resolve the relative path from root"

	capture bash -c 'cd "$1" && "$2" --root "$3" read-file bin/example' _ \
		"$read_caller" "$BIN" "$read_root"
	[ "$rc" -eq 0 ] || fail "read-file rejected --root before the verb: $err"
	printf '%s' "$out" | rg -q 'root-relative-read-marker' || \
		fail "read-file before-verb --root did not resolve the relative path from root"
	printf '%s' "$err" | rg -q 'assuming .search.' && \
		fail "read-file with leading --root silently fell back to search"

	auth_root="$DB_DIR/openai-without-key"
	mkdir -p "$auth_root/.codescan"
	printf '%s\n' \
		'embedding_api=openai' \
		'embedding_url=http://127.0.0.1:8000' \
		'embedding_model=test-model' \
		'embedding_dim=3' > "$auth_root/.codescan/config.ini"
	capture env -u CODESCAN_EMBEDDING_SERVER_API_KEY \
		"$BIN" status --root "$auth_root" --json
	[ "$rc" -ne 0 ] || fail "OpenAI-compatible provider accepted a missing API key"
	printf '%s' "$err" | rg -q 'CODESCAN_EMBEDDING_SERVER_API_KEY' || \
		fail "missing API key error did not explain the environment-variable remedy"
	capture env -u CODESCAN_EMBEDDING_SERVER_API_KEY \
		"$BIN" doctor --root "$auth_root" --json
	[ "$rc" -ne 0 ] || fail "doctor accepted a missing OpenAI-compatible API key"
	printf '%s' "$out" | jq -e '.checks[] | select(.name == "Inference" and .status == "fail" and (.message | contains("API key")))' >/dev/null || \
		fail "doctor did not explain the missing OpenAI-compatible API key"

	boundary_root="$DB_DIR/root-boundary"
	mkdir -p "$boundary_root/workspace/.codescan"
	mkdir -p "$boundary_root/workspace/repo/.git"
	mkdir -p "$boundary_root/workspace/repo/sub"
	capture bash -c 'cd "$1" && "$2" root --json' _ \
		"$boundary_root/workspace/repo/sub" "$BIN"
	[ "$rc" -ne 0 ] || fail "root discovery crossed a nested Git boundary"
	printf '%s' "$out" | jq -e '.root == null' >/dev/null || \
		fail "root boundary failure did not emit its JSON diagnostic"
	for component in ordinary 'quoted"path' 'backslash\path' $'line\nbreak\ttab\rcarriage' 'unicode-λ-雪'; do
		for state in found missing; do
			root_case="$DB_DIR/root-json/$state/$component"
			mkdir -p "$root_case/.git" || fail 'root JSON fixture setup'
			if [ "$state" = found ]; then mkdir "$root_case/.codescan" || fail 'root marker setup'; fi
			for adapter in mcp cli; do
				expected_rc=0
				if [ "$adapter" = mcp ]; then
					root_requests="$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize"}' '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"root","arguments":{}}}')"
					capture timeout 15 "$BIN" mcp-serve --root "$root_case" <<< "$root_requests"
					[ "$rc" -eq 0 ] || fail "MCP root session failed: $err"
					expected_root_log="$(printf 'codescan mcp: server started (root: %s)\ncodescan mcp: stdin closed, shutting down' "$root_case")"
					[ "$err" = "$expected_root_log" ] || fail 'MCP root session changed its captured lifecycle diagnostics'
					root_payload="$(printf '%s\n' "$out" | jq -cse 'if map(.id)==[1,2] and all(.error==null and .result!=null) then .[1].result.content[0].text | fromjson else error("invalid root protocol") end' 2> "$DB_DIR/root-parse-error")" || \
						fail "MCP root emitted a malformed report for [$component]"
					out="$root_payload"
				else
					capture bash -c 'cd "$1" && "$2" root --json' _ "$root_case" "$BIN"
					[ "$state" != missing ] || expected_rc=1
				fi
				[ "$rc" -eq "$expected_rc" ] || fail "$adapter root JSON $state changed its exit contract"
				if [ "$adapter" = cli ]; then [ -z "$err" ] || fail 'root CLI emitted an unexpected diagnostic'; fi
				if [ "$state" = found ]; then
					printf '%s' "$out" | jq -e --arg path "$root_case" \
						'.project_root==$path and .root==($path+"/.codescan") and .db_path==($path+"/.codescan/index.sqlite3") and .watcher_pid==null and .watcher_status=="stopped" and .walk_up_steps==0' \
						>/dev/null 2> "$DB_DIR/root-parse-error" || fail "$adapter root JSON did not preserve discovered component [$component]: $out"
				else
					printf '%s' "$out" | jq -e --arg path "$root_case" \
						'.root==null and .error==("no .codescan/ directory found walking up from "+$path)' \
						>/dev/null 2> "$DB_DIR/root-parse-error" || fail "$adapter root JSON did not preserve missing component [$component]: $out"
				fi
			done
		done
	done

	# Give the February timestamp its own fixture, independent of files indexed
	# by earlier edit tests. This checks the ISO8601 off-by-one-month regression.
	status_db="$DB_DIR/status.sqlite3"
	capture "$MK_DB" --db "$status_db"
	[ "$rc" -eq 0 ] || fail "status fixture creation failed: $err"
	capture sqlite3 "$status_db" "INSERT INTO indexed_files (file_path, mtime_ns, size, indexed_at) VALUES ('test.zig', 0, 100, 1771148200);"
	[ "$rc" -eq 0 ] || fail "status timestamp fixture failed: $err"
	capture "$BIN" status --db "$status_db" --json
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "status --json failed"
	fi
	iso_ts=$(printf '%s' "$out" | jq -r '.last_indexed.timestamp_utc')
	# The ISO8601 string must contain 2026-02 (February), not 2026-03 (March)
	printf '%s' "$iso_ts" | rg -q '^2026-02-' || fail "status ISO8601 month wrong: expected 2026-02-*, got '$iso_ts'"

	# Body search: a unique string that only appears inside a function body
	names=$(search_names "xylophone_unique_test_string")
	printf '%s\n' "$names" | rg -q '^processItems$' || fail "body search did not find symbol by body content"

	capture bash -lc "printf '{\"action\":\"search\",\"query\":\"checksum\",\"mode\":\"lexical\",\"db\":\"$DB\"}\n' | '$BIN' --json"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "stdin json search failed"
	fi
	printf '%s' "$out" | jq -r '.results[].name' | rg -q '^checksum_fn$' || fail "stdin json did not return expected result"

	# A zero-result default search must not claim a language filter the caller
	# never asked for. Default search spans every code language, so naming one of
	# them ("with lang=zig") misreports why the query found nothing — the exact
	# misleading-diagnostic class that hid the primary-language pinning bug.
	capture "$BIN" search "zzzqqq_nonexistent_xyzzy_token" --db "$DB" --mode lexical --top 3
	if printf '%s' "$err" | rg -q 'with lang='; then
		fail "zero-result default search claimed a lang filter the caller never set"
	fi
	if printf '%s' "$err" | rg -q 'lang filter alone'; then
		fail "zero-result default search reported a meaningless whole-corpus lang count"
	fi
	# An explicitly requested language must still be named, so real filter
	# mistakes stay diagnosable.
	capture "$BIN" search "zzzqqq_nonexistent_xyzzy_token" --db "$DB" --mode lexical --top 3 --lang zig
	printf '%s' "$err" | rg -q 'with lang=zig' \
		|| fail "explicit --lang zig was not named in the zero-result diagnostic"

	# Human search output must be plain when stdout is not a terminal. Agents and
	# shell pipelines consume this stream directly, so ANSI escapes are corruption
	# rather than style. `capture` gives us a pipe, i.e. the non-TTY case.
	capture "$BIN" search "checksum" --db "$DB" --mode lexical --top 3
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "human search failed"
	fi
	if printf '%s' "$out" | rg -q $'\x1b\['; then
		fail "human search emitted ANSI escapes to a non-TTY stdout"
	fi


	# --- mcp-install -------------------------------------------------------
	# Exercised against fake agent CLIs on a synthetic PATH so the suite never
	# reads or writes the developer's real ~/.claude.json or ~/.codex/config.toml,
	# and so the install path itself is testable rather than only the skip path.
	fake_bin="$DB_DIR/fake-agents"
	mkdir -p "$fake_bin"
	fake_log="$DB_DIR/agent-calls.log"

	# $1 = agent name, $2 = exit code returned by `mcp get` (0 = registered).
	make_fake_agent() {
		local name="$1" get_rc="$2"
		cat > "$fake_bin/$name" <<FAKEEOF
#!$BASH
printf '%s %s\n' "$name" "\$*" >> "$fake_log"
if [ "\${1:-}" = "mcp" ] && [ "\${2:-}" = "get" ]; then exit $get_rc; fi
exit 0
FAKEEOF
		chmod +x "$fake_bin/$name"
	}

	# Neither agent has codescan registered -> both must be installed.
	: > "$fake_log"
	make_fake_agent claude 1
	make_fake_agent codex 1
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "mcp-install failed against unregistered agents"; }
	printf '%s' "$out" | rg -q 'Claude Code: registered' || fail "mcp-install did not register Claude"
	printf '%s' "$out" | rg -q 'Codex: registered' || fail "mcp-install did not register Codex"
	# An MCP host commonly has a different PATH from the shell that runs this
	# installer. Record the executable itself, so its later launch cannot depend
	# on either host inheriting this shell's project-specific PATH.
	server_command="$(readlink -f "$BIN")"
	rg -F -q -- "claude mcp add codescan --scope user -- $server_command mcp-serve" "$fake_log" \
		|| fail "Claude was not registered with an absolute server command"
	rg -F -q -- "codex mcp add codescan -- $server_command mcp-serve" "$fake_log" \
		|| fail "Codex was not registered with an absolute server command"
	if rg -F -q -- ' -- codescan mcp-serve' "$fake_log"; then
		fail "mcp-install registered a PATH-dependent server command"
	fi
	# Codex has no scope concept; leaking the flag would be rejected by the real CLI.
	if rg -q -- 'codex mcp add codescan --scope' "$fake_log"; then
		fail "Codex registration leaked a --scope flag"
	fi

	# Both agents already have it -> nothing may be written. This is the whole
	# point of the command being safe to re-run.
	: > "$fake_log"
	make_fake_agent claude 0
	make_fake_agent codex 0
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "mcp-install failed against registered agents"; }
	printf '%s' "$out" | rg -q 'Claude Code: already registered' || fail "registered Claude was not left alone"
	printf '%s' "$out" | rg -q 'Codex: already registered' || fail "registered Codex was not left alone"
	if rg -q 'mcp add' "$fake_log"; then
		fail "mcp-install wrote a registration that already existed"
	fi

	# --force on an already-registered agent must remove before adding, since
	# `mcp add` refuses to overwrite.
	: > "$fake_log"
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install --claude --force
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "forced mcp-install failed"; }
	rg -q -- 'claude mcp remove codescan --scope user' "$fake_log" || fail "--force did not remove the existing entry first"
	rg -q -- 'claude mcp add codescan --scope user' "$fake_log" || fail "--force did not re-add the entry"
	if rg -q '^codex ' "$fake_log"; then
		fail "--claude still contacted Codex"
	fi

	# --force must NOT escalate a first-time install into a remove-then-add of an
	# entry that does not exist.
	: > "$fake_log"
	make_fake_agent claude 1
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install --claude --force
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "forced first-time mcp-install failed"; }
	if rg -q 'mcp remove' "$fake_log"; then
		fail "--force issued a remove for an unregistered entry"
	fi

	# --project must reach Claude as project scope, and later flags win.
	: > "$fake_log"
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install --claude --project --dry-run
	printf '%s' "$out" | rg -q -- '--scope project' || fail "--project did not select project scope"
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install --claude --project --user --dry-run
	printf '%s' "$out" | rg -q -- '--scope user' || fail "a later --user did not override an earlier --project"

	# --dry-run must not run anything at all.
	: > "$fake_log"
	capture env PATH="$fake_bin:$PATH" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install --dry-run
	if rg -q 'mcp add|mcp remove' "$fake_log"; then
		fail "--dry-run executed a registration command"
	fi

	# A missing agent CLI is reported, never treated as failure — most machines
	# have only one of these installed.
	: > "$fake_log"
	empty_bin="$DB_DIR/no-agents"
	mkdir -p "$empty_bin"
	capture env PATH="$empty_bin" MUTE_DEBUG_STATUS=1 "$BIN" mcp-install
	[ "$rc" -eq 0 ] || fail "mcp-install failed when no agent CLI was installed"
	printf '%s' "$out" | rg -q 'not installed' || fail "absent agent CLI was not reported"


	# --- global config tier ------------------------------------------------
	# Settings shared by every project (embedding URL, model, dimension) should
	# live in one file. Merging is per key, so a project that sets one value must
	# still inherit the rest rather than discarding the global file wholesale.
	gcfg="$DB_DIR/gcfg"
	mkdir -p "$gcfg/xdg/codescan" "$gcfg/proj/.codescan"
	printf 'embedding_url=http://from-global:11434\nembedding_dim=1536\nignore=vendor/\n' > "$gcfg/xdg/codescan/config.ini"
	printf 'top=7\nignore=build/\n' > "$gcfg/proj/.codescan/config.ini"
	( cd "$gcfg/proj" && git init -q . )

	capture env XDG_CONFIG_HOME="$gcfg/xdg" MUTE_DEBUG_STATUS=1 "$BIN" --root "$gcfg/proj" config show
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "config show failed with a global tier"; }
	printf '%s' "$out" | rg -q '^# global: ' || fail "config show hid the global tier"
	printf '%s' "$out" | rg -q '^# project: ' || fail "config show did not label the project tier"
	printf '%s' "$out" | rg -q 'embedding_url=http://from-global' || fail "global values were not shown"
	printf '%s' "$out" | rg -q 'top=7' || fail "project values were not shown"

	# With no global file, the display must not invent one.
	capture env -u XDG_CONFIG_HOME HOME="$gcfg/empty-home" MUTE_DEBUG_STATUS=1 "$BIN" --root "$gcfg/proj" config show
	[ "$rc" -eq 0 ] || { printf '%s' "$err" >&2; fail "config show failed without a global tier"; }
	if printf '%s' "$out" | rg -q '^# global: '; then
		fail "config show reported a global tier that does not exist"
	fi

	# A project with no config at all must inherit the global one entirely —
	# the case that makes one embedding URL across many projects worthwhile.
	mkdir -p "$gcfg/bare"
	( cd "$gcfg/bare" && git init -q . )
	capture env XDG_CONFIG_HOME="$gcfg/xdg" MUTE_DEBUG_STATUS=1 "$BIN" --root "$gcfg/bare" config show
	printf '%s' "$out" | rg -q 'embedding_url=http://from-global' || fail "a config-less project did not inherit the global tier"

	printf '%s\n' "cli ok"
}

main "$@"
