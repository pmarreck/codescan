#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/../lib/capture.bash"
binary="${CODESCAN_TEST_BIN:?prepared CLI required}"
fixture_db="${CODESCAN_TEST_DB_BIN:?prepared fixture tool required}"
fixture="$(mktemp -d "${TMPDIR:?}/codescan-mcp-offline.XXXXXX")" || exit 1
provider_pid=
service_pid=
cleanup() {
	local status="$?" provider_status fixture_pid
	for fixture_pid in "$service_pid" "$provider_pid"; do
		if [ -n "$fixture_pid" ]; then
			if kill -0 "$fixture_pid" 2>/dev/null; then
				kill -TERM "$fixture_pid" || status=1
			fi
			if wait "$fixture_pid"; then provider_status=0; else provider_status="$?"; fi
			case "$provider_status" in 0|143) ;; *) status=1 ;; esac
		fi
	done
	rm -rf -- "$fixture" || status=1
	exit "$status"
}
trap cleanup EXIT
fail() { printf 'FAIL MCP offline: %s\n' "$1" >&2; exit 1; }
mkdir -p "$fixture/.codescan" || fail setup
cd "$fixture" || fail 'private working directory unavailable'
out= err= rc=
capture "$fixture_db" --db .codescan/index.sqlite3 --embedding-dim 2
[ "$rc" -eq 0 ] || fail 'could not prepare the existing index'
printf '%s\n' 'embedding_url=http://127.0.0.1:1' 'embedding_api=ollama' 'embedding_model=test-model' 'embedding_dim=2' 'search_mode=lexical' > .codescan/config.ini
capture "$binary" status --json --root "$fixture"
[ "$rc" -eq 0 ] || fail 'could not inspect the original index'
before="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid index status'
[ "$before" = '{"symbols":4,"embeddings":4,"comment_embeddings":2}' ] || fail 'original fixture is incomplete'
requests="$(printf '%s\n' \
	'{"jsonrpc":"2.0","id":1,"method":"initialize"}' \
	'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"search","arguments":{"query":"checksum_fn"}}}' \
	'{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"create_file","arguments":{"file":"editable.zig","body":"const before = 1;\n"}}}' \
	'{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail "server did not complete the offline session (exit $rc): $err"
responses="$out"
printf '%s\n' "$responses" | jq -se '
	map(.id) == [1,2,3,4] and all(.error == null and .result != null) and
	(.[1].result.content[0].text | contains("checksum_fn"))
' >/dev/null || fail "offline protocol behavior differed: $responses"
version="$(printf '%s\n' "$responses" | jq -er 'select(.id == 4) | .result.content[0].text | fromjson | .version')" || fail 'read_file did not supply an edit version'
edit="$(jq -cn --arg version "$version" '{jsonrpc:"2.0",id:2,method:"tools/call",params:{name:"replace_content",arguments:{file:"editable.zig",needle:"before",body:"after",version:$version}}}')" || fail 'could not encode the versioned edit'
requests="$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize"}' "$edit" '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail 'versioned offline edit session failed'
printf '%s\n' "$out" | jq -se 'map(.id) == [1,2,3] and all(.error == null) and (.[2].result.content[0].text | contains("after"))' >/dev/null || fail 'versioned edit/read failed'
[ "$(< editable.zig)" = 'const after = 1;' ] || fail 'file edits were not retained'
capture "$binary" status --json --root "$fixture"
[ "$rc" -eq 0 ] || fail 'could not inspect the index before the rejected indexing request'
before="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid pre-request index status'
requests="$(printf '%s\n' \
	'{"jsonrpc":"2.0","id":1,"method":"initialize"}' \
	'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"index","arguments":{}}}' \
	'{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail 'server stopped after rejecting offline indexing'
printf '%s\n' "$out" | jq -se '
	map(.id) == [1,2,3] and
	(.[1].error.message | contains("inference server unavailable") and contains("unchanged")) and
	(.[2].result.content[0].text | contains("after"))
' >/dev/null || fail "index failure was not actionable/recoverable: $out"
capture "$binary" status --json --root "$fixture"
[ "$rc" -eq 0 ] || fail 'could not inspect the retained index'
after="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid retained index status'
[ "$after" = "$before" ] || fail "the failed index request changed the existing index: $before -> $after"
printf '%s\n' 'embedding_url=http://127.0.0.1:1' 'embedding_api=ollama' 'embedding_model=test-model' 'embedding_dim=2' 'search_mode=hybrid' > .codescan/config.ini
requests="$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize"}' '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"search","arguments":{"query":"checksum_fn"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail 'hybrid search did not complete with the provider stopped'
printf '%s\n' "$out" | jq -se '
	map(.id) == [1,2] and all(.error == null) and
	(.[1].result.content[0].text | fromjson |
		.inference_unavailable == true and (.inference_help | length > 0) and
		(.results | any(.name == "checksum_fn")))
' >/dev/null || fail "hybrid search did not return lexical matches and inference advice: $out"

# The actual HTTP adapter answers probes but has no embedding endpoint.
# Required Linux runs own a private network; suites share one sequential lane.
provider_root="$fixture/.codescan/http-provider"
provider_port=8125
mkdir -p "$provider_root" || fail 'provider fixture setup'
mkfifo "$provider_root/stderr" || fail 'provider readiness channel'
exec {provider_stderr}<>"$provider_root/stderr"
"$binary" serve --root "$provider_root" --http-host 127.0.0.1 --http-port "$provider_port" \
	--ollama-url http://127.0.0.1:1 --ollama-model test-model --embedding-dim 2 \
	> "$provider_root/stdout" 2>&"$provider_stderr" &
provider_pid=$!
ready=false
while IFS= read -r -t 15 line <&"$provider_stderr"; do
	case "$line" in
		"codescan serve: listening on http://127.0.0.1:$provider_port/") ready=true; break ;;
		error:*) fail "provider fixture startup: $line" ;;
	esac
done
[ "$ready" = true ] || fail 'provider did not report readiness'
capture "$binary" status --json --root "$fixture"
[ "$rc" -eq 0 ] || fail 'could not inspect the index before embedding rejection'
index_before_rejection="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid pre-rejection index status'
capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
[ "$rc" -eq 0 ] || fail 'could not record the original symbols'
symbols_before_rejection="$out"
export CODESCAN_EMBEDDING_SERVER_API_KEY=fixture-key
printf '%s\n' "embedding_url=http://127.0.0.1:$provider_port" 'embedding_api=openai' \
	'embedding_model=test-model' 'embedding_dim=2' 'search_mode=hybrid' > .codescan/config.ini
requests="$(printf '%s\n' \
	'{"jsonrpc":"2.0","id":1,"method":"initialize"}' \
	'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"search","arguments":{"query":"checksum_fn"}}}' \
	'{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail "rejected embeddings stopped the MCP session (exit $rc): $err"
printf '%s\n' "$err" | rg -qF 'HTTP 404' || fail 'fixture did not reject an actual embedding request'
printf '%s\n' "$out" | jq -se '
	map(.id) == [1,2,3] and all(.error == null) and
	(.[1].result.content[0].text | fromjson |
		.inference_unavailable == true and (.inference_help | length > 0) and
		(.results | any(.name == "checksum_fn"))) and
	(.[2].result.content[0].text | contains("after"))
' >/dev/null || fail "embedding rejection lost lexical results, advice, or subsequent file access: $out"
capture "$binary" status --json --root "$fixture"
[ "$rc" -eq 0 ] || fail 'could not inspect the index after embedding rejection'
index_after_rejection="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid post-rejection index status'
printf '%s\n' "$index_after_rejection" | jq -e --argjson before "$index_before_rejection" \
	'.embeddings == $before.embeddings and .comment_embeddings == $before.comment_embeddings' >/dev/null || fail 'embedding rejection removed existing vectors'
capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
[ "$rc" -eq 0 ] || fail 'could not inspect the retained symbols'
jq -ne --argjson before "$symbols_before_rejection" --argjson after "$out" \
	'($before | length) > 0 and all($before[]; . as $symbol | any($after[]; . == $symbol))' >/dev/null || fail 'embedding rejection removed or changed an original symbol'

# A responding endpoint does not authorize replacing a usable index. Exercise
# both actual full-index adapters against the same provider's rejected POSTs.
replacement_failed=0
for adapter in CLI MCP; do
	capture "$fixture_db" --db .codescan/index.sqlite3 --embedding-dim 2
	[ "$rc" -eq 0 ] || fail "$adapter replacement fixture creation failed"
	capture "$binary" status --json --root "$fixture"
	[ "$rc" -eq 0 ] || fail "$adapter pre-replacement status failed"
	index_before="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid replacement fixture status'
	capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
	[ "$rc" -eq 0 ] || fail 'could not record replacement fixture rows'
	rows_before="$out"
	if [ "$adapter" = CLI ]; then
		capture timeout 15 "$binary" index --root "$fixture" --no-progress
		[ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] || fail 'CLI must reject unusable embeddings without hanging'
		printf '%s\n' "$err" | rg -qF 'existing index was left unchanged' || fail 'CLI rejection lost the index-preservation advice'
	else
		requests="$(printf '%s\n' \
			'{"jsonrpc":"2.0","id":1,"method":"initialize"}' \
			'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"index","arguments":{}}}' \
			'{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
		capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
		[ "$rc" -eq 0 ] || fail 'MCP stopped after a rejected replacement request'
		printf '%s\n' "$out" | jq -se 'map(.id) == [1,2,3] and .[1].error != null and (.[2].result.content[0].text | contains("after"))' >/dev/null || fail 'MCP replacement rejection lost its error or subsequent file access'
		printf '%s\n' "$out" | jq -se '.[1].error.message | contains("existing index unchanged")' >/dev/null || fail 'MCP rejection lost the index-preservation advice'
	fi
	printf '%s\n' "$err" | rg -qF 'HTTP 404' || fail "$adapter replacement did not exercise an actual rejected embedding request"
	capture "$binary" status --json --root "$fixture"
	[ "$rc" -eq 0 ] || fail "$adapter left an unreadable index"
	index_after="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid replacement result status'
	capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
	[ "$rc" -eq 0 ] || fail 'could not inspect replacement result rows'
	if [ "$index_after" != "$index_before" ] || [ "$out" != "$rows_before" ]; then
		printf '%s\n' "$adapter rejected embeddings changed the index: $index_before -> $index_after" >&2
		replacement_failed=1
	fi
done
[ "$replacement_failed" -eq 0 ] || fail 'full-index rejection must preserve symbols and vectors'
requests="$(printf '%s\n' \
	'{"jsonrpc":"2.0","id":1,"method":"initialize"}' \
	'{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"search","arguments":{"query":"checksum_fn"}}}' \
	'{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"read_file","arguments":{"file":"editable.zig"}}}')"
capture timeout 15 "$binary" mcp-serve --root "$fixture" <<< "$requests"
[ "$rc" -eq 0 ] || fail 'search/read session stopped after rejected replacement'
printf '%s\n' "$out" | jq -se '
	map(.id) == [1,2,3] and all(.error == null) and
	(.[1].result.content[0].text | fromjson | .inference_unavailable and (.results | any(.name == "checksum_fn"))) and
	(.[2].result.content[0].text | contains("after"))
' >/dev/null || fail 'rejected replacement lost usable lexical search or file reads'

# Exercise HTTP replacement against the same responding/rejecting provider.
capture "$fixture_db" --db .codescan/index.sqlite3 --embedding-dim 2
[ "$rc" -eq 0 ] || fail 'HTTP fixture creation failed'
service_port=8126
mkfifo .codescan/service-stderr || fail 'HTTP readiness channel'
exec {service_stderr}<>.codescan/service-stderr
"$binary" serve --root "$fixture" --http-host 127.0.0.1 --http-port "$service_port" \
	> .codescan/service-stdout 2>&"$service_stderr" &
service_pid=$!
ready=false
while IFS= read -r -t 15 line <&"$service_stderr"; do
	case "$line" in
		"codescan serve: listening on http://127.0.0.1:$service_port/") ready=true; break ;;
		error:*) fail "HTTP fixture startup: $line" ;;
	esac
done
[ "$ready" = true ] || fail 'HTTP fixture did not report readiness'
http_failed=0
for endpoint in /index /update; do
	capture "$fixture_db" --db .codescan/index.sqlite3 --embedding-dim 2
	[ "$rc" -eq 0 ] || fail 'HTTP replacement fixture reset failed'
	capture "$binary" status --json --root "$fixture"
	[ "$rc" -eq 0 ] || fail 'HTTP pre-replacement status failed'
	index_before="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid HTTP fixture status'
	capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
	[ "$rc" -eq 0 ] || fail 'could not record HTTP fixture rows'
	rows_before="$out"
	capture curl --connect-timeout 1 --max-time 10 -sS -w '\n%{http_code}' \
		-H 'Content-Type: application/json' --data '{}' "http://127.0.0.1:$service_port$endpoint"
	[ "$rc" -eq 0 ] || fail "$endpoint transport failed: $err"
	http_status="${out##*$'\n'}"
	if [ "$http_status" != 503 ]; then
		printf '%s\n' "$endpoint returned $http_status instead of service-unavailable advice" >&2
		http_failed=1
	else
		printf '%s' "${out%$'\n'*}" | jq -e '.error | contains("existing index") and contains("unchanged")' >/dev/null || fail "$endpoint lost the preservation advice"
	fi
	capture "$binary" status --json --root "$fixture"
	[ "$rc" -eq 0 ] || fail 'HTTP left an unreadable index'
	index_after="$(printf '%s' "$out" | jq -ce '.index | {symbols, embeddings, comment_embeddings}')" || fail 'invalid HTTP result status'
	capture sqlite3 -readonly -json .codescan/index.sqlite3 'SELECT * FROM symbols ORDER BY id;'
	[ "$rc" -eq 0 ] || fail 'could not inspect HTTP result rows'
	if [ "$index_after" != "$index_before" ] || [ "$out" != "$rows_before" ]; then
		printf '%s\n' "$endpoint rejected embeddings changed the index: $index_before -> $index_after" >&2
		http_failed=1
	fi
done
[ "$http_failed" -eq 0 ] || fail 'HTTP embedding rejection must preserve the existing index'
capture curl --connect-timeout 1 --max-time 10 -fsS "http://127.0.0.1:$service_port/health"
[ "$rc" -eq 0 ] || fail 'HTTP stopped after rejecting embeddings'
capture curl --connect-timeout 1 --max-time 10 -fsS -H 'Content-Type: application/json' \
	--data '{"query":"checksum_fn"}' "http://127.0.0.1:$service_port/search"
[ "$rc" -eq 0 ] || fail 'HTTP search stopped after rejecting embeddings'
printf '%s' "$out" | jq -e '.inference_unavailable and (.results | any(.name == "checksum_fn"))' >/dev/null || fail 'HTTP rejection lost lexical results or inference advice'
printf 'MCP offline session contract passed\n'
