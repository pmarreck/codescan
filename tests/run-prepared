#!/usr/bin/env bash
set -u
source "$(dirname "${BASH_SOURCE[0]}")/lib/capture.bash"
source_root="$PWD"
project="$TEST_WORKSPACE/project"
export PATH="$(dirname "$CODESCAN_TEST_BIN"):$PATH"
out= err= rc= failed=0
run_case() {
	local name="$1"
	shift
	capture "$@"
	if [ "$rc" -eq 0 ]; then
		case "$out" in
			*skipped*) printf 'SKIP %s: %s\n' "$name" "$out" ;;
			*) printf 'PASS %s\n' "$name" ;;
		esac
		case "$err" in *skipped*) printf '%s\n' "$err" | tail -n 1 ;; esac
	else
		printf 'FAIL %s (exit %s)\n%s\n%s\n' "$name" "$rc" "$out" "$err" >&2
		failed=1
		return 1
	fi
}
# Units own private scratch and need no source copy. Keep at most two lanes.
(
	cd "$TEST_WORKSPACE" || exit 1
	run_case 'unit' "$source_root/tests/unit/test-unit"
) &
unit_pid=$!
# Copy current tracked/staged source, never ignored live indexes or products.
if ! bash "$source_root/tests/lib/copy-source" "$source_root" "$project"; then
	wait "$unit_pid"
	exit 1
fi
if ! cd "$project"; then
	wait "$unit_pid"
	exit 1
fi
run_case 'pinned profiling adapter' bash ./tests/unit/test-profiler-pin
run_case 'portable capture' ./tests/unit/test-capture
run_case 'tracked source fixture' bash ./tests/unit/test-source-fixture
run_case 'prepared runner orchestration' bash ./tests/unit/test-prepared-runner
run_case 'five-target build contract' ./tests/unit/test-build-all-contract
run_case 'Nix-required build adapter' ./tests/unit/test-build-nix
run_case 'CI runner contract' ./tests/unit/test-ci-runner-contract
run_case 'CI architecture/publication' ./tests/unit/test-ci-architecture
run_case 'no committed embedding keys' ./tests/unit/test-no-committed-secrets
run_case 'portable MCP configuration' ./tests/unit/test-portable-mcp-config
run_case 'single index entrypoint' ./tests/unit/test-single-index-entrypoint
run_case 'sequential project reindex runner' ./tests/unit/test-reindex-all-projects
run_case 'CLI about' ./tests/cli/test-about "$CODESCAN_TEST_BIN" "$CODESCAN_EXPECT_PF" "${CODESCAN_EXPECT_VARIANT:-}"
run_case 'MCP offline session' ./tests/cli/test-mcp-offline
run_case 'CLI' ./tests/cli/test-cli
run_case 'watcher schema preservation' ./tests/cli/test-watcher-schema-preservation
run_case 'HTTP' ./tests/http/test-http
run_case 'integration' ./tests/integration/test-integration
if ! wait "$unit_pid"; then failed=1; fi
exit "$failed"
