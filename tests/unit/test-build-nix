	export -f nix-store
	for operation in initial replacement; do
		product="$old_product"; fault=0
		if [ "$operation" = replacement ]; then product="$new_product"; fault=1; fi
		if (cd "$project" && env RETENTION_PRODUCT="$product" GC_PROJECT="$project" \
			GC_FAIL_SELECTED="$fault" GC_FAIL_RESTORE="$restore_fault" GC_SELECTED_PREFIX=".nix-out/$namespace/ReleaseFast" GC_UNREGISTERED_BACKUP="$mutation" \
			"$BASH" ./build) > "$project/$operation-out" 2> "$project/$operation-error"; then status=0; else status="$?"; fi
