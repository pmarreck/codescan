		[ "$#" -eq 4 ] && [ "$1" = --add-root ] && [ "$3" = --realise ] || return 64
		if [ "$GC_FAIL_RESTORE" -eq 1 ] && [ "$2" = "$GC_SELECTED_PREFIX" ] && [ "$4" != "$RETENTION_PRODUCT" ]; then
			printf 'controlled rollback registration failure\n' >&2
