#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
fixture="$(mktemp -d "${TMPDIR:?}/codescan-build.XXXXXX")" || exit 1
trap 'rm -rf -- "$fixture"' EXIT
fail() { printf 'FAIL Nix build: %s\n' "$1" >&2; exit 1; }
nix() {
	printf '%s\n' "$*" >> "$BUILD_EVENTS"
	[ "$BUILD_STATUS" -eq 0 ] || return "$BUILD_STATUS"
	local link='' argument next_link=0
	for argument in "$@"; do
		if [ "$next_link" -eq 1 ]; then link="$argument"; next_link=0; continue; fi
		[ "$argument" != --out-link ] || next_link=1
	done
	if [ -n "$link" ]; then ln -sfn "$BUILD_OUTPUT" "$link" || return 1; fi
	printf '%s\n' "$BUILD_OUTPUT"
}
zig() { printf 'forbidden compiler\n' >> "$BUILD_EVENTS"; return 99; }
export -f nix zig
for mode in default debug test failure missing-nix output-symlink real-publication; do
	project="$fixture/$mode/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/prepared/bin" "$project/tools" || fail setup
	cp "$root/build" "$project/build" || fail 'cannot copy source fixture'
	printf old > "$project/zig-out/bin/codescan"
	printf new > "$project/prepared/bin/codescan"
	chmod +x "$project/prepared/bin/codescan"
	if [ "$mode" = output-symlink ]; then
		mv "$project/zig-out" "$project/protected-output"
		ln -s "$project/protected-output" "$project/zig-out"
	fi
	if [ "$mode" = real-publication ]; then
		[ -x "${CODESCAN_TEST_BIN:-}" ] || fail 'real publication requires the prepared Nix CLI'
		ln -sf "$CODESCAN_TEST_BIN" "$project/prepared/bin/codescan"
	fi
	: > "$project/events"
	status=0
	[ "$mode" != failure ] || status=19
	args=()
	case "$mode" in debug) args=(debug) ;; test) args=(--test) ;; esac
	if [ "$mode" = missing-nix ]; then
		ln -s "$(command -v dirname)" "$project/tools/dirname"
		invocation=(bash -c 'unset -f nix; export PATH="$1"; exec "$2" "$3"' _ "$project/tools" "$BASH" "$project/build")
	else
		invocation=("$BASH" "$project/build" "${args[@]}")
	fi
	if (cd "$project" && env BUILD_EVENTS="$project/events" BUILD_STATUS="$status" BUILD_OUTPUT="$project/prepared" "${invocation[@]}") > "$project/stdout" 2> "$project/stderr"; then
		rc=0
	else rc="$?"; fi
	case "$mode" in
		failure|missing-nix|output-symlink)
			[ "$rc" -ne 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail "$mode did not preserve the previous product"
			;;
		real-publication)
			[ "$rc" -eq 0 ] || fail 'real prepared product was not published'
			cmp "$CODESCAN_TEST_BIN" "$project/zig-out/bin/codescan" || fail 'real publication changed executable bytes'
			"$project/zig-out/bin/codescan" --about > "$project/about" 2> "$project/about-error" || fail 'published native command did not execute'
			[ -s "$project/about" ] && [ ! -s "$project/about-error" ] || fail 'published command did not identify itself cleanly'
			;;
		test)
			[ "$rc" -eq 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'test preparation unexpectedly published a CLI'
			grep -Fq '.#test-binaries' "$project/events" || fail 'test preparation did not select Nix test artifacts'
			;;
		default|debug)
			if [ "$rc" -ne 0 ]; then printf '%s\n' "$(< "$project/stderr")" >&2; fail "$mode failed"; fi
			[ "$(< "$project/zig-out/bin/codescan")" = new ] || fail "$mode did not publish the prepared output"
			attribute=default
			[ "$mode" != debug ] || attribute=debug
			grep -Fq ".#$attribute" "$project/events" || fail "$mode selected the wrong output"
			;;
	esac
	if grep -Fq 'forbidden compiler' "$project/events"; then fail "$mode fell back to direct compilation"; fi
done

# Native products coexist by target and profile; the complete output is retained.
uname() {
	case "$1" in
		-s) printf '%s\n' "$BUILD_OS" ;;
		-m) printf '%s\n' "$BUILD_ARCH" ;;
		*) command uname "$@" ;;
	esac
}
export -f uname
for mapping in Linux:x86_64:linux-amd64/musl Linux:aarch64:linux-arm64/musl Darwin:arm64:macos-arm64; do
	IFS=: read -r os arch namespace <<< "$mapping"
	project="$fixture/native-$os-$arch/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/release/bin" "$project/release/share" "$project/debug/bin" "$project/debug/lib" || fail 'native retention setup'
	cp "$root/build" "$project/build" || fail 'native retention wrapper'
	mkdir -p "$project/foreign/share" "$project/.nix-out/mswin-arm64/gnu" || fail 'foreign coexistence setup'
	printf foreign > "$project/foreign/share/resource"
	ln -s "$project/foreign" "$project/.nix-out/mswin-arm64/gnu/ReleaseFast" || fail 'foreign coexistence link'
	printf release > "$project/release/bin/codescan"
	printf resource > "$project/release/share/resource"
	printf debug > "$project/debug/bin/codescan"
	printf library > "$project/debug/lib/runtime"
	chmod +x "$project/release/bin/codescan" "$project/debug/bin/codescan" || fail 'native retention executables'
	printf old > "$project/zig-out/bin/codescan"
	: > "$project/events"
	for profile in ReleaseFast Debug; do
		args=(); product=release
		if [ "$profile" = Debug ]; then args=(--debug); product=debug; fi
		if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" PF=conflicting VARIANT=conflicting \
			BUILD_EVENTS="$project/events" BUILD_STATUS=0 BUILD_OUTPUT="$project/$product" \
			"$BASH" ./build "${args[@]}") > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
		[ "$rc" -eq 0 ] || fail "$mapping $profile failed"
		[ -L "$project/.nix-out/$namespace/$profile" ] && [ "$(readlink "$project/.nix-out/$namespace/$profile")" = "$project/$product" ] || fail "$mapping $profile did not retain the exact complete Nix product"
		[ "$(< "$project/zig-out/bin/codescan")" = "$product" ] || fail 'native retention changed legacy publication'
	done
	[ "$(< "$project/.nix-out/$namespace/ReleaseFast/share/resource")" = resource ] || fail 'debug build lost release resources'
	[ "$(< "$project/.nix-out/$namespace/Debug/lib/runtime")" = library ] || fail 'release build lost debug resources'
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=19 BUILD_OUTPUT="$project/debug" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 19 ] && [ "$(< "$project/zig-out/bin/codescan")" = debug ] || fail 'failed native rebuild changed legacy selection'
	[ "$(readlink "$project/.nix-out/$namespace/ReleaseFast")" = "$project/release" ] || fail 'failed native rebuild changed retained release'
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/release" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = release ] || fail 'native retry did not reuse the retained product'
	[ "$(readlink "$project/.nix-out/$namespace/Debug")" = "$project/debug" ] || fail 'native retry changed the other profile'
	[ "$(readlink "$project/.nix-out/mswin-arm64/gnu/ReleaseFast")" = "$project/foreign" ] && [ "$(< "$project/.nix-out/mswin-arm64/gnu/ReleaseFast/share/resource")" = foreign ] || fail 'native builds changed a foreign retained product'
done
for obstacle in root-link platform-link variant-link root-file platform-file variant-file leaf-file leaf-directory; do
	project="$fixture/native-$obstacle/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/protected" || fail 'native refusal setup'
	cp "$root/build" "$project/build" || fail 'native refusal wrapper'
	printf old > "$project/zig-out/bin/codescan"
	printf unchanged > "$project/protected/sentinel"
	case "$obstacle" in
		root-*) blocked="$project/.nix-out" ;;
		platform-*) blocked="$project/.nix-out/linux-amd64" ;;
		variant-*) blocked="$project/.nix-out/linux-amd64/musl" ;;
		leaf-*) blocked="$project/.nix-out/linux-amd64/musl/ReleaseFast" ;;
	esac
	mkdir -p "$(dirname "$blocked")" || fail 'native refusal parent'
	case "$obstacle" in
		*-link) ln -s "$project/protected" "$blocked" || fail 'native refusal link' ;;
		*-file) printf unchanged > "$blocked" ;;
		leaf-directory) mkdir "$blocked" && cp "$project/protected/sentinel" "$blocked/sentinel" || fail 'native refusal directory' ;;
	esac
	: > "$project/events"
	if (cd "$project" && env BUILD_OS=Linux BUILD_ARCH=x86_64 BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/protected" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 1 ] && [ ! -s "$project/events" ] && [ -s "$project/err" ] || fail "$obstacle did not refuse before building"
	[ "$(< "$project/zig-out/bin/codescan")" = old ] && [ "$(< "$project/protected/sentinel")" = unchanged ] || fail "$obstacle changed existing data"
	[ "$(find "$project/protected" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ] || fail "$obstacle wrote through an unexpected parent"
	case "$obstacle" in
		*-link) [ "$(readlink "$blocked")" = "$project/protected" ] || fail 'native refusal retargeted a link' ;;
		*-file) [ "$(< "$blocked")" = unchanged ] || fail 'native refusal overwrote a file' ;;
		leaf-directory) [ "$(< "$blocked/sentinel")" = unchanged ] || fail 'native refusal overwrote a directory' ;;
	esac
done
for mapping in Darwin:x86_64 Linux:riscv64 Plan9:amd64 MINGW64_NT:x86_64; do
	IFS=: read -r os arch <<< "$mapping"
	project="$fixture/unsupported-$os-$arch"
	mkdir -p "$project/zig-out/bin" || fail 'unsupported host setup'
	cp "$root/build" "$project/build" || fail 'unsupported host wrapper'
	printf old > "$project/zig-out/bin/codescan"
	: > "$project/events"
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT=unused "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 69 ] && [ ! -s "$project/events" ] && [ -s "$project/err" ] || fail "$mapping was not rejected before building"
	[ ! -e "$project/.nix-out" ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'unsupported host changed products'
done
unset -f uname

# Explicit source execution must not select a stale PATH or published command.
nix() {
	printf '%s\0' "$@" > "$BUILD_EVENTS"
	local input
	if IFS= read -r input; then printf '%s\0' consumed-stdin "$input" >> "$BUILD_EVENTS"; fi
	[ "$BUILD_STATUS" -eq 0 ] || return "$BUILD_STATUS"
	printf '%s\n' "$BUILD_OUTPUT"
}
export -f nix
for mode in run run-child-failure run-build-failure run-missing-product run-nonexecutable run-multiple-products run-missing-nix run-real-product; do
	project="$fixture/$mode/project with spaces"
	caller="$fixture/$mode/caller directory"
	mkdir -p "$project/zig-out/bin" "$project/prepared/bin" "$caller" "$project/tools" || fail 'run setup'
	cp "$root/run" "$project/run" 2> "$project/setup-error" || fail 'explicit run entrypoint is missing'
	printf old > "$project/zig-out/bin/codescan"
	printf '#!%s\nexit 91\n' "$BASH" > "$project/tools/codescan"
	chmod +x "$project/tools/codescan" || fail 'stale command setup'
	{
		printf '#!%s\n' "$BASH"
		printf '%s\n' \
			'printf "%s\0" "$@" > "$RUN_ARGUMENTS"' \
			'printf "%s\n" "$PWD" > "$RUN_DIRECTORY"' \
			'printf "%s\n" "$BASHPID" > "$RUN_PID"' \
			'printf "child diagnostic\n" >&2' \
			'command cat' \
			'exit "$RUN_STATUS"'
	} > "$project/prepared/bin/codescan"
	chmod +x "$project/prepared/bin/codescan" || fail 'prepared run setup'
	status=0 child_status=0 expected_rc=0 output="$project/prepared"
	args=('query with spaces' '' --json --root 'relative directory')
	case "$mode" in
		run-child-failure) child_status=37 expected_rc=37 ;;
		run-build-failure) status=19 expected_rc=19 ;;
		run-missing-product) output="$project/absent" expected_rc=1 ;;
		run-nonexecutable) chmod -x "$project/prepared/bin/codescan"; expected_rc=1 ;;
		run-multiple-products) output="$project/prepared"$'\n'"$project/another output"; expected_rc=1 ;;
		run-missing-nix) expected_rc=127 ;;
		run-real-product)
			ln -sf "$CODESCAN_TEST_BIN" "$project/prepared/bin/codescan" || fail 'prepared CLI setup'
			args=(--about)
			;;
	esac
	: > "$project/events"
	printf 'stdin marker\n' > "$project/input"
	if [ "$mode" = run-missing-nix ]; then
		ln -s "$(command -v dirname)" "$project/tools/dirname" || fail 'missing Nix fixture'
		invocation=(bash -c 'unset -f nix; export PATH="$1"; exec "$2" "$3"' _ "$project/tools" "$BASH" "$project/run")
	else
		invocation=("$BASH" "$project/run" "${args[@]}")
	fi
	(cd "$caller" && exec env PATH="$project/tools:$PATH" BUILD_EVENTS="$project/events" BUILD_STATUS="$status" BUILD_OUTPUT="$output" \
		RUN_ARGUMENTS="$project/arguments" RUN_DIRECTORY="$project/directory" RUN_PID="$project/pid" RUN_STATUS="$child_status" \
		"${invocation[@]}") < "$project/input" > "$project/stdout" 2> "$project/stderr" &
	invocation_pid=$!
	if wait "$invocation_pid"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq "$expected_rc" ] || fail "$mode returned $rc instead of $expected_rc"
	[ "$(< "$project/zig-out/bin/codescan")" = old ] && [ ! -e "$project/.nix-out" ] && [ ! -e "$project/bin" ] || fail "$mode published a product"
	if [ "$mode" = run-missing-nix ]; then
		[ ! -s "$project/events" ] && [ -s "$project/stderr" ] || fail 'missing Nix did not fail clearly before building'
	else
		printf '%s\0' build --no-link --print-out-paths "$project#default" > "$project/expected-build"
		cmp -s "$project/expected-build" "$project/events" || fail "$mode did not build its own exact native output once"
	fi
	case "$mode" in
		run|run-child-failure)
			printf '%s\0' "${args[@]}" > "$project/expected-arguments"
			cmp -s "$project/expected-arguments" "$project/arguments" || fail "$mode changed arguments"
			cmp -s "$project/input" "$project/stdout" || fail "$mode changed stdin/stdout"
			[ "$(< "$project/directory")" = "$caller" ] || fail "$mode changed the caller directory"
			[ "$(< "$project/pid")" -eq "$invocation_pid" ] || fail "$mode retained a selector process instead of exec"
			printf 'child diagnostic\n' > "$project/expected-stderr"
			cmp -s "$project/expected-stderr" "$project/stderr" || fail "$mode changed child diagnostics"
			;;
		run-real-product)
			"$CODESCAN_TEST_BIN" --about > "$project/expected-about" 2> "$project/about-error" || fail 'prepared CLI oracle failed'
			cmp -s "$project/expected-about" "$project/stdout" && [ ! -s "$project/stderr" ] || fail 'run did not execute the exact real prepared product'
			;;
		*) [ ! -e "$project/pid" ] && [ ! -s "$project/stdout" ] || fail "$mode invoked a stale or invalid command" ;;
	esac
done
printf 'Nix-required build adapter passed\n'
