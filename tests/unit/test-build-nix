# A real collector must not reclaim the old complete product during a failed
# replacement. The mutation leaves an ordinary symlink instead of a GC root.
gc_rollback_case() (
	case_root="$fixture/gc-rollback-$1"
	mutation=0; [ "$1" != unregistered ] || mutation=1
	restore_fault=0; [ "$1" != restore-failure ] || restore_fault=1
	export NIX_REMOTE="local?store=$case_root/store&state=$case_root/state&log=$case_root/log"
	for generation in old new; do
		mkdir -p "$case_root/$generation-source/bin" "$case_root/$generation-source/share" || fail 'GC rollback sources'
		printf '#!/usr/bin/env bash\nprintf %s\n' "$generation" > "$case_root/$generation-source/bin/codescan"
		printf '%s-runtime-resource\n' "$generation" > "$case_root/$generation-source/share/resource"
