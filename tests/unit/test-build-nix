		[ "$status" -eq "$expected" ] || fail "$operation changed the actual private-store failure: $status"
	done
	rg -Fq 'controlled post-registration failure' "$project/replacement-error" || fail 'GC rollback did not reach its intended fault'
	[ -f "$old_product/share/resource" ] || fail 'private GC discarded previous runtime resources'
	retained_root="$project/.nix-out/$namespace/ReleaseFast"
	if [ "$restore_fault" -eq 1 ]; then
		rg -Fq 'controlled rollback registration failure' "$project/replacement-error" || fail 'restoration failure did not reach its fault'
		rg -Fq 'rollback incomplete; previous products remain retained for recovery' "$project/replacement-error" || fail 'incomplete rollback hid its recovery location'
		[ "$(readlink "$retained_root")" = "$new_product" ] || fail 'restoration-failure state was not observed'
		command nix-store --gc > "$project/recovery-gc-out" 2> "$project/recovery-gc-error" || fail 'recovery private GC'
		cmp -s "$case_root/old-source/share/resource" "$old_product/share/resource" || fail 'GC lost the recoverable previous product'
		cmp -s "$case_root/old-source/bin/codescan" "$project/zig-out/bin/codescan" || fail 'failed restoration changed the prior command'
		backup_root="$(find "$project/.nix-out" -type l -name previous-0 -print)"
		[ "$(readlink "$backup_root")" = "$old_product" ] || fail 'recovery backup does not identify its old product'
		command nix-store --query --roots "$old_product" > "$project/recovery-roots" || fail 'recovery root query'
		awk -v root="$backup_root" 'index($0, root " -> ") == 1 { n++ } END { exit n != 1 }' "$project/recovery-roots" || fail 'recoverable product lacks its real GC root'
		exit 0
	fi
	[ "$(readlink "$retained_root")" = "$old_product" ] || fail 'private store did not restore its prior selected root'
	cmp -s "$case_root/old-source/share/resource" "$retained_root/share/resource" || fail 'GC rollback changed old resource bytes'
	cmp -s "$case_root/old-source/bin/codescan" "$project/zig-out/bin/codescan" || fail 'GC rollback changed the prior command'
	command nix-store --query --roots "$old_product" > "$project/restored-roots" || fail 'restored private root query'
	awk -v root="$retained_root" 'index($0, root " -> ") == 1 { n++ } END { exit n != 1 }' "$project/restored-roots" || fail 'rollback did not register the restored GC root'
