	done
	old_product="$(command nix-store --add "$case_root/old-source")" || fail 'old GC rollback product'
	new_product="$(command nix-store --add "$case_root/new-source")" || fail 'new GC rollback product'
	project="$case_root/project with spaces"
	mkdir -p "$project" || fail 'GC rollback project'
	copy_build_fixture "$project" || fail 'GC rollback wrapper'
