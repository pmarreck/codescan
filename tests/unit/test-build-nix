#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
fixture="$(mktemp -d "${TMPDIR:?}/codescan-build.XXXXXX")" || exit 1
cleanup_fixture() {
	[ -n "$fixture" ] && [ -d "$fixture" ] && [ ! -L "$fixture" ] || return 1
	# Only the fresh allocation belongs to this invocation. Physical traversal
	# must not chmod a retained product or another target reached by a symlink.
	find -P "$fixture" -type d -exec chmod u+w -- {} + || return 1
	rm -rf -- "$fixture"
}
finish_fixture() {
	local previous_status="$1"
	if ! cleanup_fixture; then
		printf 'FAIL Nix build: owned fixture cleanup failed\n' >&2
		[ "$previous_status" -ne 0 ] || previous_status=1
	fi
	exit "$previous_status"
}
trap 'finish_fixture "$?"' EXIT
fail() { printf 'FAIL Nix build: %s\n' "$1" >&2; exit 1; }
source "$root/tests/lib/build-fixture.bash"

# Exercise the actual exit handler independently of filesystem cleanup.
cleanup_status_controls=0
for statuses in 0:0:0 0:9:1 7:0:7 7:9:7; do
	IFS=: read -r body_status cleanup_status expected_status <<< "$statuses"
	if (
		trap - EXIT
		cleanup_fixture() { return "$cleanup_status"; }
		finish_fixture "$body_status"
	) > "$fixture/exit-out" 2> "$fixture/exit-error"; then status=0; else status="$?"; fi
	[ "$status" -eq "$expected_status" ] || fail "cleanup status matrix changed body $body_status / cleanup $cleanup_status: expected $expected_status, got $status"
	[ ! -s "$fixture/exit-out" ] || fail 'cleanup status handler wrote unexpected stdout'
	if [ "$cleanup_status" -eq 0 ]; then
		[ ! -s "$fixture/exit-error" ] || fail 'successful cleanup reported an error'
	else
		printf 'FAIL Nix build: owned fixture cleanup failed\n' > "$fixture/expected-cleanup-error"
		cmp "$fixture/expected-cleanup-error" "$fixture/exit-error" || fail 'cleanup failure lost its diagnostic'
	fi
	cleanup_status_controls=$((cleanup_status_controls + 1))
done
[ "$cleanup_status_controls" -eq 4 ] || fail 'incomplete cleanup exit-status matrix'

# A real read-only tree is removable, while an external symlink target keeps
# both its bytes and permissions. The outer fixture owns both disposable trees.
protected="$fixture/cleanup-protected"
mkdir "$protected" || fail 'cleanup protected fixture'
printf protected > "$protected/sentinel"
chmod 0444 "$protected/sentinel" && chmod 0555 "$protected" || fail 'cleanup protected permissions'
(
	trap - EXIT
	fixture="$(mktemp -d "$fixture/cleanup-probe.XXXXXXXX")" || exit 1
	mkdir "$fixture/readonly" || exit 1
	printf private > "$fixture/readonly/data"
	ln -s "$protected" "$fixture/external" || exit 1
	chmod 0444 "$fixture/readonly/data" && chmod 0555 "$fixture/readonly" "$fixture" || exit 1
	cleanup_fixture || exit 1
	[ ! -e "$fixture" ] && [ ! -L "$fixture" ] || exit 1
	[ "$(find -P "$protected" -maxdepth 0 -perm 0555 -print)" = "$protected" ] || exit 1
	[ "$(find -P "$protected/sentinel" -maxdepth 0 -perm 0444 -print)" = "$protected/sentinel" ] || exit 1
	[ "$(< "$protected/sentinel")" = protected ] || exit 1
) || fail 'owned cleanup followed an external symlink or retained read-only fixture data'
(
	trap - EXIT
	fixture="$fixture/cleanup-root-link"
	ln -s "$protected" "$fixture" || exit 1
	if cleanup_fixture; then exit 1; fi
	[ -L "$fixture" ] && [ "$(readlink "$fixture")" = "$protected" ] || exit 1
	[ "$(find -P "$protected" -maxdepth 0 -perm 0555 -print)" = "$protected" ] || exit 1
	[ "$(< "$protected/sentinel")" = protected ] || exit 1
) || fail 'owned cleanup accepted a substituted symlink root'

nix() {
	printf '%s\n' "$*" >> "$BUILD_EVENTS"
	[ "$BUILD_STATUS" -eq 0 ] || return "$BUILD_STATUS"
	local link='' argument next_link=0 attribute='' product="$BUILD_OUTPUT"
	for argument in "$@"; do
		if [ "$next_link" -eq 1 ]; then link="$argument"; next_link=0; continue; fi
		[ "$argument" != --out-link ] || next_link=1
		case "$argument" in '.#'*) attribute="$argument" ;; esac
	done
	if [ "$attribute" = .#publication-tools ]; then product="${CODESCAN_PUBLICATION_TOOLS:?prepare native publication tools with Nix}"; fi
	if [ -n "$link" ]; then ln -sfn "$product" "$link" || return 1; fi
	printf '%s\n' "$product"
}
nix-store() {
	[ "$#" -eq 4 ] && [ "$1" = --add-root ] && [ "$3" = --realise ] || return 64
	case "$4" in "$BUILD_OUTPUT"|"$PWD/release"|"$PWD/debug") ;; *) return 64 ;; esac
	if [[ "$2" == .nix-out/* ]] && [ "$4" = "$BUILD_OUTPUT" ]; then
		[ "${BUILD_RETAIN_STATUS:-0}" -eq 0 ] || return "$BUILD_RETAIN_STATUS"
	fi
	ln -sfn "$4" "$2"
	if [[ "$2" == .nix-out/* ]] && [ "$4" = "$BUILD_OUTPUT" ]; then
		return "${BUILD_RETAIN_AFTER_STATUS:-0}"
	fi
}
zig() { printf 'forbidden compiler\n' >> "$BUILD_EVENTS"; return 99; }
export -f nix nix-store zig
for mode in default debug test failure missing-nix output-symlink real-publication wrong-header header-reader-failure linked-command dangling-root dangling-root-failure; do
	project="$fixture/$mode/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/prepared/bin" "$project/tools" || fail setup
	copy_build_fixture "$project" || fail 'cannot copy source fixture'
	printf old > "$project/zig-out/bin/codescan"
	printf new > "$project/prepared/bin/codescan"
	chmod +x "$project/prepared/bin/codescan"
	if [[ "$mode" == dangling-root* ]]; then
		case "$(uname -s)/$(uname -m)" in
			Linux/x86_64) namespace=linux-amd64/musl ;;
			Linux/aarch64) namespace=linux-arm64/musl ;;
			Darwin/arm64) namespace=macos-arm64 ;;
			*) fail 'unsupported dangling-root fixture host' ;;
		esac
		selected="$project/.nix-out/$namespace/ReleaseFast"
		mkdir -p "${selected%/*}" || fail 'dangling root parent'
		ln -s "$project/missing-old-product" "$selected" || fail 'dangling root fixture'
	fi
	if [ "$mode" = output-symlink ]; then
		mv "$project/zig-out" "$project/protected-output"
		ln -s "$project/protected-output" "$project/zig-out"
	fi
	if [ "$mode" = real-publication ]; then
		[ -x "${CODESCAN_TEST_BIN:-}" ] || fail 'real publication requires the prepared Nix CLI'
		mv "$project/prepared" "$project/fake-prepared" || fail 'real publication staging'
		ln -s "$(dirname "$(dirname "$CODESCAN_TEST_BIN")")" "$project/prepared" || fail 'complete native fixture'
	fi
	if [ "$mode" = linked-command ]; then
		mv "$project/prepared/bin/codescan" "$project/prepared/real-command" || fail 'linked command fixture'
		ln -s ../real-command "$project/prepared/bin/codescan" || fail 'linked command fixture'
	fi
	: > "$project/events"
	status=0
	header=''; header_status=0; real_header=0; after_status=0
	[ "$mode" != dangling-root-failure ] || after_status=23
	[ "$mode" != failure ] || status=19
	[ "$mode" != wrong-header ] || header='foreign executable'
	[ "$mode" != header-reader-failure ] || header_status=17
	[ "$mode" != real-publication ] || real_header=1
	args=()
	case "$mode" in debug) args=(debug) ;; test) args=(--test) ;; esac
	if [ "$mode" = missing-nix ]; then
		ln -s "$(command -v dirname)" "$project/tools/dirname"
		invocation=(bash -c 'unset -f nix; export PATH="$1"; exec "$2" "$3"' _ "$project/tools" "$BASH" "$project/build")
	else
		invocation=("$BASH" "$project/build" "${args[@]}")
	fi
	if (cd "$project" && env BUILD_EVENTS="$project/events" BUILD_STATUS="$status" BUILD_OUTPUT="$project/prepared" BUILD_HEADER="$header" BUILD_HEADER_STATUS="$header_status" BUILD_REAL_HEADER="$real_header" BUILD_RETAIN_AFTER_STATUS="$after_status" "${invocation[@]}") > "$project/stdout" 2> "$project/stderr"; then
		rc=0
	else rc="$?"; fi
	case "$mode" in
		dangling-root)
			[ "$rc" -eq 0 ] || fail "dangling selected root prevented a successful rebuild: $rc"
			[ "$(readlink "$selected")" = "$project/prepared" ] && [ "$(< "$project/zig-out/bin/codescan")" = new ] || fail 'dangling root was not repaired'
			;;
		dangling-root-failure)
			[ "$rc" -eq 23 ] || fail "dangling root lost the post-registration failure: $rc"
			[ "$(readlink "$selected")" = "$project/missing-old-product" ] && [ ! -e "$selected" ] || fail 'failed rebuild did not restore the original dangling link'
			[ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'failed dangling-root repair changed the prior command'
			[ -z "$(find "$project/.nix-out" -type d -name '.candidate.*' -print)" ] || fail 'dangling-root rollback leaked candidates'
			;;
		failure|missing-nix|output-symlink)
			[ "$rc" -ne 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail "$mode did not preserve the previous product"
			;;
		wrong-header|header-reader-failure|linked-command)
			expected_status=1; [ "$mode" != header-reader-failure ] || expected_status=17
			[ "$rc" -eq "$expected_status" ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail "$mode changed the old command or lost the inspection error"
			[ -s "$project/stderr" ] && [ -z "$(find "$project/.nix-out" -name ReleaseFast -type l -print)" ] || fail "$mode hid its diagnostic or promoted a rejected root"
			;;
		real-publication)
			[ "$rc" -eq 0 ] || fail 'real prepared product was not published'
			cmp "$CODESCAN_TEST_BIN" "$project/zig-out/bin/codescan" || fail 'real publication changed executable bytes'
			"$project/zig-out/bin/codescan" --about > "$project/about" 2> "$project/about-error" || fail 'published native command did not execute'
			[ -s "$project/about" ] && [ ! -s "$project/about-error" ] || fail 'published command did not identify itself cleanly'
			case "$(uname -s)/$(uname -m)" in
				Linux/x86_64) public_pf=linux-amd64 ;;
				Linux/aarch64) public_pf=linux-arm64 ;;
				Darwin/arm64) public_pf=macos-arm64 ;;
				*) fail 'unsupported real PF fixture' ;;
			esac
			[ -L "$project/bin/$public_pf/codescan" ] || fail 'real PF command is not a direct retained-product link'
			"$project/bin/$public_pf/codescan" --about > "$project/public-about" 2> "$project/public-error" || fail 'real PF command did not execute'
			cmp "$project/about" "$project/public-about" && [ ! -s "$project/public-error" ] || fail 'PF publication changed native execution'
			;;
		test)
			[ "$rc" -eq 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'test preparation unexpectedly published a CLI'
			grep -Fq '.#test-binaries' "$project/events" || fail 'test preparation did not select Nix test artifacts'
			;;
		default|debug)
			if [ "$rc" -ne 0 ]; then printf '%s\n' "$(< "$project/stderr")" >&2; fail "$mode failed"; fi
			[ "$(< "$project/zig-out/bin/codescan")" = new ] || fail "$mode did not publish the prepared output"
			attribute=default
			[ "$mode" != debug ] || attribute=debug
			grep -Fq ".#$attribute" "$project/events" || fail "$mode selected the wrong output"
			;;
	esac
	if grep -Fq 'forbidden compiler' "$project/events"; then fail "$mode fell back to direct compilation"; fi
done

# Native products coexist by target and profile; the complete output is retained.
uname() {
	case "$1" in
		-s) printf '%s\n' "$BUILD_OS" ;;
		-m) printf '%s\n' "$BUILD_ARCH" ;;
		*) command uname "$@" ;;
	esac
}
export -f uname
for mapping in Linux:x86_64:linux-amd64/musl Linux:aarch64:linux-arm64/musl Darwin:arm64:macos-arm64; do
	IFS=: read -r os arch namespace <<< "$mapping"
	project="$fixture/native-$os-$arch/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/release/bin" "$project/release/share" "$project/debug/bin" "$project/debug/lib" || fail 'native retention setup'
	copy_build_fixture "$project" || fail 'native retention wrapper'
	mkdir -p "$project/bin" || fail 'portable command fixture'
	printf portable-sentinel > "$project/bin/helper"
	mkdir -p "$project/foreign/share" "$project/.nix-out/mswin-arm64/gnu" || fail 'foreign coexistence setup'
	printf foreign > "$project/foreign/share/resource"
	ln -s "$project/foreign" "$project/.nix-out/mswin-arm64/gnu/ReleaseFast" || fail 'foreign coexistence link'
	printf release > "$project/release/bin/codescan"
	printf resource > "$project/release/share/resource"
	printf debug > "$project/debug/bin/codescan"
	printf library > "$project/debug/lib/runtime"
	chmod +x "$project/release/bin/codescan" "$project/debug/bin/codescan" || fail 'native retention executables'
	printf old > "$project/zig-out/bin/codescan"
	: > "$project/events"
	for profile in ReleaseFast Debug; do
		args=(); product=release
		if [ "$profile" = Debug ]; then args=(--debug); product=debug; fi
		if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" PF=conflicting VARIANT=conflicting \
			BUILD_EVENTS="$project/events" BUILD_STATUS=0 BUILD_OUTPUT="$project/$product" \
			"$BASH" ./build "${args[@]}") > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
		[ "$rc" -eq 0 ] || fail "$mapping $profile failed"
		[ -L "$project/.nix-out/$namespace/$profile" ] && [ "$(readlink "$project/.nix-out/$namespace/$profile")" = "$project/$product" ] || fail "$mapping $profile did not retain the exact complete Nix product"
		public_command="$project/bin/${namespace%%/*}/codescan"
		[ -L "$public_command" ] && [ "$(readlink "$public_command")" = "../../.nix-out/$namespace/$profile/bin/codescan" ] || fail "$mapping $profile did not select its direct PF command"
		cmp "$public_command" "$project/$product/bin/codescan" || fail 'PF command did not resolve to the complete retained product'
		[ "$(< "$project/zig-out/bin/codescan")" = "$product" ] || fail 'native retention changed legacy publication'
	done
	[ "$(< "$project/.nix-out/$namespace/ReleaseFast/share/resource")" = resource ] || fail 'debug build lost release resources'
	[ "$(< "$project/.nix-out/$namespace/Debug/lib/runtime")" = library ] || fail 'release build lost debug resources'
	case "$namespace" in
		linux-amd64/musl) foreign_header='ELF 64-bit LSB executable, ARM aarch64, statically linked' ;;
		linux-arm64/musl) foreign_header='ELF 64-bit LSB executable, x86-64, statically linked' ;;
		macos-arm64) foreign_header='Mach-O 64-bit x86_64 executable' ;;
	esac
	for rejected_product in foreign-header reader-failure; do
		header="$foreign_header"; header_status=0; expected_status=1
		if [ "$rejected_product" = reader-failure ]; then header=''; header_status=17; expected_status=17; fi
		if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
			BUILD_STATUS=0 BUILD_OUTPUT="$project/release" BUILD_HEADER="$header" BUILD_HEADER_STATUS="$header_status" \
			"$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
		[ "$rc" -eq "$expected_status" ] && [ -s "$project/err" ] || fail "$mapping $rejected_product lost its inspection failure"
		[ "$(readlink "$project/.nix-out/$namespace/ReleaseFast")" = "$project/release" ] || fail "$mapping $rejected_product changed the retained release"
		[ "$(readlink "$project/.nix-out/$namespace/Debug")" = "$project/debug" ] || fail "$mapping $rejected_product changed the retained debug product"
		[ "$(< "$project/zig-out/bin/codescan")" = debug ] || fail "$mapping $rejected_product changed the previous command"
	done
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=19 BUILD_OUTPUT="$project/debug" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 19 ] && [ "$(< "$project/zig-out/bin/codescan")" = debug ] || fail 'failed native rebuild changed legacy selection'
	[ "$(readlink "$project/.nix-out/$namespace/ReleaseFast")" = "$project/release" ] || fail 'failed native rebuild changed retained release'
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/release" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 0 ] && [ "$(< "$project/zig-out/bin/codescan")" = release ] || fail 'native retry did not reuse the retained product'
	[ "$(readlink "$project/.nix-out/$namespace/Debug")" = "$project/debug" ] || fail 'native retry changed the other profile'
	mkdir -p "$project/incomplete/bin" || fail 'incomplete product fixture'
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/incomplete" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -ne 0 ] && [ "$(readlink "$project/.nix-out/$namespace/ReleaseFast")" = "$project/release" ] || fail 'invalid successful build replaced the previous retained product'
	[ "$(< "$project/zig-out/bin/codescan")" = release ] || fail 'invalid successful build changed the previous command'
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_RETAIN_STATUS=23 BUILD_OUTPUT="$project/debug" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 23 ] && [ "$(readlink "$project/.nix-out/$namespace/ReleaseFast")" = "$project/release" ] || fail 'failed root registration changed the previous retained product or status'
	[ "$(< "$project/zig-out/bin/codescan")" = release ] || fail 'failed root registration changed the previous command'
	[ -z "$(find "$project/.nix-out" -type d -name '.candidate.*' -print)" ] || fail 'native build left a temporary retention root'
	[ "$(readlink "$project/.nix-out/mswin-arm64/gnu/ReleaseFast")" = "$project/foreign" ] && [ "$(< "$project/.nix-out/mswin-arm64/gnu/ReleaseFast/share/resource")" = foreign ] || fail 'native builds changed a foreign retained product'
	[ "$(< "$project/bin/helper")" = portable-sentinel ] && [ ! -e "$project/bin/codescan" ] || fail 'PF publication changed generic portable commands'
done
for obstacle in root-link platform-link variant-link root-file platform-file variant-file leaf-file leaf-directory; do
	project="$fixture/native-$obstacle/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/protected" || fail 'native refusal setup'
	copy_build_fixture "$project" || fail 'native refusal wrapper'
	printf old > "$project/zig-out/bin/codescan"
	printf unchanged > "$project/protected/sentinel"
	case "$obstacle" in
		root-*) blocked="$project/.nix-out" ;;
		platform-*) blocked="$project/.nix-out/linux-amd64" ;;
		variant-*) blocked="$project/.nix-out/linux-amd64/musl" ;;
		leaf-*) blocked="$project/.nix-out/linux-amd64/musl/ReleaseFast" ;;
	esac
	mkdir -p "$(dirname "$blocked")" || fail 'native refusal parent'
	case "$obstacle" in
		*-link) ln -s "$project/protected" "$blocked" || fail 'native refusal link' ;;
		*-file) printf unchanged > "$blocked" ;;
		leaf-directory) mkdir "$blocked" && cp "$project/protected/sentinel" "$blocked/sentinel" || fail 'native refusal directory' ;;
	esac
	: > "$project/events"
	if (cd "$project" && env BUILD_OS=Linux BUILD_ARCH=x86_64 BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/protected" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 1 ] && [ ! -s "$project/events" ] && [ -s "$project/err" ] || fail "$obstacle did not refuse before building"
	[ "$(< "$project/zig-out/bin/codescan")" = old ] && [ "$(< "$project/protected/sentinel")" = unchanged ] || fail "$obstacle changed existing data"
	[ "$(find "$project/protected" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ] || fail "$obstacle wrote through an unexpected parent"
	case "$obstacle" in
		*-link) [ "$(readlink "$blocked")" = "$project/protected" ] || fail 'native refusal retargeted a link' ;;
		*-file) [ "$(< "$blocked")" = unchanged ] || fail 'native refusal overwrote a file' ;;
		leaf-directory) [ "$(< "$blocked/sentinel")" = unchanged ] || fail 'native refusal overwrote a directory' ;;
	esac
done
for obstacle in root-link root-file platform-link platform-file leaf-link leaf-dangling-link leaf-file leaf-directory; do
	project="$fixture/public-$obstacle/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/protected" || fail 'public refusal setup'
	copy_build_fixture "$project" || fail 'public refusal wrapper'
	printf old > "$project/zig-out/bin/codescan"
	printf unchanged > "$project/protected/sentinel"
	case "$obstacle" in
		root-*) blocked="$project/bin" ;;
		platform-*) blocked="$project/bin/linux-amd64" ;;
		leaf-*) blocked="$project/bin/linux-amd64/codescan" ;;
	esac
	mkdir -p "${blocked%/*}" || fail 'public refusal parent'
	case "$obstacle" in
		leaf-dangling-link) ln -s "$project/protected/missing" "$blocked" || fail 'public dangling link' ;;
		*-link) ln -s "$project/protected" "$blocked" || fail 'public refusal link' ;;
		*-file) printf unchanged > "$blocked" ;;
		leaf-directory) mkdir "$blocked" && cp "$project/protected/sentinel" "$blocked/sentinel" || fail 'public refusal directory' ;;
	esac
	: > "$project/events"
	if (cd "$project" && env BUILD_OS=Linux BUILD_ARCH=x86_64 BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT="$project/protected" "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 1 ] && [ ! -s "$project/events" ] && [ -s "$project/err" ] || fail "$obstacle public command was not refused before building"
	[ "$(< "$project/zig-out/bin/codescan")" = old ] && [ "$(< "$project/protected/sentinel")" = unchanged ] || fail "$obstacle public refusal changed existing data"
	[ ! -e "$project/.nix-out" ] && [ "$(find "$project/protected" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ] || fail 'public refusal wrote into caller data'
done
for mapping in Darwin:x86_64 Linux:riscv64 Plan9:amd64 MINGW64_NT:x86_64; do
	IFS=: read -r os arch <<< "$mapping"
	project="$fixture/unsupported-$os-$arch"
	mkdir -p "$project/zig-out/bin" || fail 'unsupported host setup'
	copy_build_fixture "$project" || fail 'unsupported host wrapper'
	printf old > "$project/zig-out/bin/codescan"
	: > "$project/events"
	if (cd "$project" && env BUILD_OS="$os" BUILD_ARCH="$arch" BUILD_EVENTS="$project/events" \
		BUILD_STATUS=0 BUILD_OUTPUT=unused "$BASH" ./build) > "$project/out" 2> "$project/err"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 69 ] && [ ! -s "$project/events" ] && [ -s "$project/err" ] || fail "$mapping was not rejected before building"
	[ ! -e "$project/.nix-out" ] && [ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'unsupported host changed products'
done
unset -f uname

# Every selected product must survive a failure anywhere in the build batch.
(
	nix() {
		[ "$1" = build ] || return 64
		local argument link='' key='' next_link=0 print_paths=0 product
		for argument in "$@"; do
			if [ "$next_link" -eq 1 ]; then link="$argument"; next_link=0; continue; fi
			case "$argument" in
				--out-link) next_link=1 ;;
				--print-out-paths) print_paths=1 ;;
				'.#release-'*) key="${argument#.#release-}" ;;
				'.#default') key=native ;;
				'.#publication-tools') key=tools ;;
			esac
		done
		[ -n "$key" ] && [ -n "$link" ] && [ "$next_link" -eq 0 ] || return 64
		if [ "$BATCH_FAULT" = build-failure ] && [ "$key" = "$BATCH_BAD_PRODUCT" ]; then return 19; fi
		product="$BATCH_PROJECT/next/$key"
		if [ "$key" = tools ]; then product="${CODESCAN_PUBLICATION_TOOLS:?prepare native publication tools with Nix}"; fi
		ln -sfn "$product" "$link" || return 1
		if [ "$print_paths" -eq 1 ]; then printf '%s\n' "$product"; fi
	}
	nix-store() {
		[ "$#" -eq 4 ] && [ "$1" = --add-root ] && [ "$3" = --realise ] || return 64
		if [[ "$BATCH_FAULT" == registration-* ]] && [[ "$4" == "$BATCH_PROJECT/next/"* ]]; then
			case "$2" in
				".nix-out/$BATCH_BAD_PRODUCT/ReleaseFast"|".nix-out/$BATCH_BAD_PRODUCT/musl/ReleaseFast"|".nix-out/$BATCH_BAD_PRODUCT/gnu/ReleaseFast")
					if [[ "$BATCH_FAULT" == registration-after-mutation* ]]; then ln -sfn "$4" "$2" || return 68; fi
