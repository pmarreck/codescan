#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "$0")/../.." && pwd)"
fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/codescan-ci-architecture.XXXXXX")" || exit 1
trap 'rm -rf -- "$fixture_root"' EXIT

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	exit 1
}

# These adapters are inherited only by this test's child CI scripts. They
# record requested operations and return controlled responses without compiling.
uname() {
	printf 'uname\t%s\n' "$*" >> "$CI_CASE_EVENTS"
	case "${1-}" in
		-s) printf '%s\n' "$CI_CASE_OS" ;;
		-m) printf '%s\n' "$CI_CASE_ARCH" ;;
		*) return 64 ;;
	esac
}

file() {
	printf 'file\t%s\n' "$*" >> "$CI_CASE_EVENTS"
	if [ "$CI_CASE_FILE_RC" -ne 0 ]; then
		printf 'fixture header inspection failed\n' >&2
		return "$CI_CASE_FILE_RC"
	fi
	printf '%s\n' "$CI_CASE_FORMAT"
}

nix() {
	if [ "${1-}" = develop ] && [ "${2-}" = -c ]; then
		shift 2
		[ "${1-}" != zig ] || return 64
		"$@"
		return "$?"
	fi
	[ "${1-}" = build ] && [ "${2-}" = --no-link ] && [ "${3-}" = --print-out-paths ] || return 64
	printf 'build\t%s\n' "$*" >> "$CI_CASE_EVENTS"
	if [ "$CI_CASE_BUILD_RC" -ne 0 ]; then
		printf 'fixture compilation failed\n' >&2
		return "$CI_CASE_BUILD_RC"
	fi
	local output="$PWD/prepared output"
	mkdir -p "$output/bin" || return 1
	{
		printf '#!%s\n' "$BASH"
		printf '%s\n' \
			'printf "binary\t%s\n" "$*" >> "$CI_CASE_EVENTS"' \
			'printf "fixture about\n"' \
			'exit "$CI_CASE_BINARY_RC"'
	} > "$output/bin/codescan"
	chmod +x "$output/bin/codescan"
	cp "$output/bin/codescan" "$output/bin/codescan.exe" || return 1
	printf '%s\n' "$output"
}
tar() {
	if [ "${CI_CASE_ARCHIVE_RC:-0}" -ne 0 ]; then
		[ "${1-}" = -czf ] && [ -n "${2-}" ] || return 64
		printf 'partial archive\n' > "$2" || return 1
		return "$CI_CASE_ARCHIVE_RC"
	fi
	command tar "$@"
}
export -f uname file nix tar

run_case() {
	local name="$1" os="$2" arch="$3" format="$4" outcome="$5" target="$6"
	local build_rc="${7:-0}" file_rc="${8:-0}" binary_rc="${9:-0}"
	local package_name="${10:-package dir}"
	local archive_name="${11:-artifact.tar.gz}" executable=codescan
	case "$target" in *-windows-gnu) executable=codescan.exe ;; esac
	local extension="${executable#codescan}"
	local case_dir="$fixture_root/$name/project with spaces"
	mkdir -p "$case_dir/$package_name" || fail "could not create case $name"
	printf 'previous artifact\n' > "$case_dir/$package_name/previous"
	printf 'fixture README\n' > "$case_dir/README.md"
	printf 'fixture license\n' > "$case_dir/LICENSE"
	: > "$case_dir/events"
	local rc
	if (
		cd "$case_dir" || exit 1
		env CI_CASE_EVENTS="$case_dir/events" CI_CASE_OS="$os" CI_CASE_ARCH="$arch" \
			CI_CASE_FORMAT="$format" CI_CASE_BUILD_RC="$build_rc" CI_CASE_FILE_RC="$file_rc" \
			CI_CASE_BINARY_RC="$binary_rc" \
			bash "$root/scripts/ci-build" "$target" "$package_name" "$archive_name" "$extension"
	) > "$case_dir/stdout" 2> "$case_dir/stderr"; then
		rc=0
	else
		rc="$?"
	fi
	if [ "$outcome" = reject ]; then
		[ "$rc" -ne 0 ] || fail "$name: CI published an invalid native Mac product"
		[ -f "$case_dir/$package_name/previous" ] || fail "$name: failed verification replaced the previous package"
		[ ! -e "$case_dir/$archive_name" ] || fail "$name: failed verification published an archive"
	else
		if [ "$rc" -ne 0 ]; then
			printf '%s\n' "$(<"$case_dir/stderr")" >&2
			fail "$name: valid CI product was rejected"
		fi
		[ -f "$case_dir/$package_name/previous" ] && [ "$(<"$case_dir/$package_name/previous")" = 'previous artifact' ] || fail "$name: packaging destroyed caller-owned staging contents"
		[ ! -e "$case_dir/$package_name/$executable" ] || fail "$name: packaging wrote into caller-owned staging"
		[ -f "$case_dir/$archive_name" ] || fail "$name: valid product was not published"
		local actual_members expected_members
		case "$archive_name" in
			*.zip) actual_members="$(unzip -Z -1 "$case_dir/$archive_name")" || fail "$name: ZIP listing failed" ;;
			*) actual_members="$(tar -tzf "$case_dir/$archive_name")" || fail "$name: tar listing failed" ;;
		esac
		actual_members="$(printf '%s\n' "$actual_members" | LC_ALL=C sort)" || fail "$name: member sorting failed"
		expected_members="$(printf '%s\n' "$package_name/" "$package_name/LICENSE" "$package_name/README.md" "$package_name/$executable")"
		[ "$actual_members" = "$expected_members" ] || fail "$name: archive contains the wrong product set"
		mkdir "$case_dir/extracted" || fail "$name: could not allocate extraction fixture"
		case "$archive_name" in
			*.zip) unzip -q "$case_dir/$archive_name" -d "$case_dir/extracted" || fail "$name: archive extraction failed" ;;
			*) tar -xzf "$case_dir/$archive_name" -C "$case_dir/extracted" || fail "$name: archive extraction failed" ;;
		esac
		cmp "$case_dir/prepared output/bin/$executable" "$case_dir/extracted/$package_name/$executable" || fail "$name: archive changed executable bytes"
		[ -x "$case_dir/extracted/$package_name/$executable" ] || fail "$name: archive lost executable permissions"
	fi
	case "$name" in
		wrong-os|wrong-host-cpu)
			[ -s "$case_dir/stderr" ] || fail "$name: runner rejection was silent"
			[ "$(awk '$1 == "build" { n++ } END { print n+0 }' "$case_dir/events")" -eq 0 ] || fail "$name: invalid runner reached compilation"
			;;
		wrong-binary|header-tool-failure|build-failure)
			[ "$(awk '$1 == "binary" { n++ } END { print n+0 }' "$case_dir/events")" -eq 0 ] || fail "$name: rejected artifact was executed"
			;;
		valid-mac)
			[ "$(awk '$1 == "binary" && $2 == "--about" { n++ } END { print n+0 }' "$case_dir/events")" -eq 1 ] || fail "native Mac binary was not smoke-executed"
			;;
		binary-failure)
			[ "$(awk '/^error:/ { n++ } END { print n+0 }' "$case_dir/stderr")" -gt 0 ] || fail "native smoke failure had no error diagnostic"
			;;
		linux-*)
			[ "$(awk '$1 == "uname" || $1 == "file" || $1 == "binary" { n++ } END { print n+0 }' "$case_dir/events")" -eq 0 ] || fail "Linux cross-build unexpectedly required a native Mac runner"
			;;
	esac
	if [ "$name" != wrong-os ] && [ "$name" != wrong-host-cpu ]; then
		local attribute
		case "$target" in
			aarch64-macos) attribute=release-macos-arm64 ;;
			aarch64-linux-musl) attribute=release-linux-arm64 ;;
			x86_64-linux-musl) attribute=release-linux-amd64 ;;
			x86_64-windows-gnu) attribute=release-mswin-amd64 ;;
			aarch64-windows-gnu) attribute=release-mswin-arm64 ;;
			*) fail 'test case requires an explicit expected Nix output' ;;
		esac
		[ "$(awk -F '\t' -v expected="build --no-link --print-out-paths .#$attribute" '$1 == "build" && $2 == expected { n++ } END { print n+0 }' "$case_dir/events")" -eq 1 ] || fail "$name: CI did not select its declared Nix release output"
	fi
}

run_case wrong-os Linux arm64 'Mach-O 64-bit arm64 executable' reject aarch64-macos
run_case wrong-host-cpu Darwin x86_64 'Mach-O 64-bit arm64 executable' reject aarch64-macos
run_case wrong-binary Darwin arm64 'Mach-O 64-bit x86_64 executable' reject aarch64-macos
run_case header-tool-failure Darwin arm64 '' reject aarch64-macos 0 9
run_case binary-failure Darwin arm64 'Mach-O 64-bit arm64 executable' reject aarch64-macos 0 0 7
run_case build-failure Darwin arm64 'Mach-O 64-bit arm64 executable' reject aarch64-macos 6
run_case valid-mac Darwin arm64 'Mach-O 64-bit arm64 executable' accept aarch64-macos
run_case linux-arm Linux x86_64 'ELF 64-bit LSB executable, ARM aarch64' accept aarch64-linux-musl
run_case linux-x86 Linux x86_64 'ELF 64-bit LSB executable, x86-64' accept x86_64-linux-musl
run_case linux-archive-label Linux x86_64 '' accept x86_64-linux-musl 0 0 0 archive.tar.gz
run_case linux-zip-label Linux x86_64 '' accept x86_64-linux-musl 0 0 0 archive.zip
run_case linux-zip-archive Linux x86_64 '' accept x86_64-linux-musl 0 0 0 archive.zip artifact.zip
run_case windows-x86 Linux x86_64 '' accept x86_64-windows-gnu 0 0 0 package artifact.zip
run_case windows-arm Linux x86_64 '' accept aarch64-windows-gnu 0 0 0 package artifact.zip

# The failing builder is a controlled stop: even a broken argument validator
# cannot reach staging deletion for these adversarial inputs.
reject_package_args() {
	local name="$1" package_name="$2" archive_name="$3" extension="$4"
	local case_dir="$fixture_root/$name/project with spaces" rc
	mkdir -p "$case_dir" || fail "could not create argument case $name"
	case "$name" in
		absolute-package) package_name="$case_dir/package" ;;
		absolute-archive) archive_name="$case_dir/artifact.tar.gz" ;;
		symlink-archive)
			printf 'protected archive\n' > "$case_dir/protected"
			ln -s protected "$case_dir/artifact.tar.gz" || fail 'could not create archive symlink fixture'
			;;
		directory-archive) mkdir "$case_dir/artifact.tar.gz" || fail 'could not create archive directory fixture' ;;
	esac
	: > "$case_dir/events"
	if (
		cd "$case_dir" || exit 1
		env CI_CASE_EVENTS="$case_dir/events" CI_CASE_BUILD_RC=6 \
			bash "$root/scripts/ci-build" x86_64-linux-musl "$package_name" "$archive_name" "$extension"
	) > "$case_dir/stdout" 2> "$case_dir/stderr"; then rc=0; else rc="$?"; fi
	[ "$rc" -eq 64 ] || fail "$name: unsafe package arguments were not rejected as usage errors"
	[ ! -s "$case_dir/events" ] || fail "$name: invalid package arguments reached the builder"
	[ -s "$case_dir/stderr" ] || fail "$name: invalid package arguments had no diagnostic"
	if [ "$name" = symlink-archive ]; then
		[ -L "$case_dir/artifact.tar.gz" ] && [ "$(<"$case_dir/protected")" = 'protected archive' ] || fail 'archive validation changed its symlink target'
	fi
}
while IFS='|' read -r name package_name archive_name extension; do
	reject_package_args "$name" "$package_name" "$archive_name" "$extension"
done <<'CASES'
empty-package||artifact.tar.gz|
dot-package|.|artifact.tar.gz|
parent-package|..|artifact.tar.gz|
absolute-package|package|artifact.tar.gz|
nested-package|stage/package|artifact.tar.gz|
escaping-package|../package|artifact.tar.gz|
backslash-package|stage\package|artifact.tar.gz|
option-package|-package|artifact.tar.gz|
escaping-archive|package|../artifact.tar.gz|
absolute-archive|package|artifact.tar.gz|
nested-archive|package|stage/artifact.tar.gz|
option-archive|package|-artifact.tar.gz|
unknown-archive|package|artifact.data|
wrong-extension|package|artifact.tar.gz|.exe
escaping-extension|package|artifact.tar.gz|/../secret
symlink-archive|package|artifact.tar.gz|
directory-archive|package|artifact.tar.gz|
CASES

# Inject a writer that opens and partly writes the requested archive, then fails.
# Publication must retain the old archive and clean only its owned workspace.
archive_failure_dir="$fixture_root/archive-failure/project with spaces"
mkdir -p "$archive_failure_dir/package dir" || fail 'could not allocate archive-failure fixture'
printf 'previous artifact\n' > "$archive_failure_dir/package dir/previous"
printf 'previous archive\n' > "$archive_failure_dir/artifact.tar.gz"
printf 'fixture README\n' > "$archive_failure_dir/README.md"
printf 'fixture license\n' > "$archive_failure_dir/LICENSE"
: > "$archive_failure_dir/events"
if (
	cd "$archive_failure_dir" || exit 1
	env CI_CASE_EVENTS="$archive_failure_dir/events" CI_CASE_BUILD_RC=0 CI_CASE_ARCHIVE_RC=7 \
		bash "$root/scripts/ci-build" x86_64-linux-musl 'package dir' artifact.tar.gz ''
) > "$archive_failure_dir/stdout" 2> "$archive_failure_dir/stderr"; then archive_rc=0; else archive_rc="$?"; fi
[ "$archive_rc" -eq 7 ] || fail 'archive failure did not preserve the adapter exit status'
[ "$(<"$archive_failure_dir/artifact.tar.gz")" = 'previous archive' ] || fail 'archive failure replaced the previous archive'
[ "$(<"$archive_failure_dir/package dir/previous")" = 'previous artifact' ] || fail 'archive failure changed caller staging'
leftovers="$(find "$archive_failure_dir" -maxdepth 1 -type d -name '.codescan-package.*' -print)" || fail 'could not inspect owned package cleanup'
[ -z "$leftovers" ] || fail 'archive failure leaked its temporary workspace'

# Sweep the declared host domain as a set, not a few presence checks.
source "$root/scripts/ci-verify-macos-arm64"
allowed_runners=$'Darwin\tarm64'
actual_runners=
for os in Darwin Linux MINGW64_NT unknown; do
	for arch in arm64 aarch64 x86_64 AMD64 unknown; do
		if ci_native_macos_arm64 "$os" "$arch"; then
			actual_runners+="${actual_runners:+$'\n'}$os"$'\t'"$arch"
		fi
	done
done
[ "$actual_runners" = "$allowed_runners" ] || fail "native Mac runner classifier accepted the wrong host set"

for entry in \
	'accept|Mach-O 64-bit arm64 executable' \
	'accept|Mach-O 64-bit arm64 executable, flags:<PIE>' \
	'accept|Mach-O 64-bit executable arm64' \
	'accept|Mach-O 64-bit executable arm64, flags:<PIE>' \
	'reject|Mach-O 64-bit arm64e executable' \
	'reject|Mach-O 64-bit x86_64 executable' \
	'reject|Mach-O universal binary with 2 architectures: x86_64 arm64' \
	'reject|ELF 64-bit LSB executable, ARM aarch64' \
	'reject|PE32+ executable (console) Aarch64, for MS Windows' \
	'reject|data' \
	'reject|'
do
	IFS='|' read -r outcome description <<< "$entry"
	if ci_arm64_macho "$description"; then
		[ "$outcome" = accept ] || fail "binary classifier accepted an unsupported format: $description"
	else
		[ "$outcome" = reject ] || fail "binary classifier rejected an ARM64 Mach-O format: $description"
	fi
done

# libmagic supplies the header descriptions independently of the gate. The
# 32-byte Mach-O headers differ only in their specified CPU type fields.
for entry in \
	'arm64|0c000001|accept' \
	'x86_64|07000001|reject' \
	'arm32|0c000000|reject' \
	'ppc64|12000001|reject'
do
	IFS='|' read -r name cpu outcome <<< "$entry"
	path="$fixture_root/$name.macho"
	bytes="$(printf '%s' "$cpu" | sed 's/../\\x&/g')"
	printf '%b' "\xcf\xfa\xed\xfe$bytes\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00" > "$path"
	description="$(command file -b -- "$path")" || fail "real Mach-O header inspection failed"
	if ci_arm64_macho "$description"; then
		[ "$outcome" = accept ] || fail "real header classifier accepted $name"
	else
		[ "$outcome" = reject ] || fail "real header classifier rejected $name: $description"
	fi
done

printf 'CI architecture/publication regressions passed\n'
