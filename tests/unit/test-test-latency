#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
fixture="$(mktemp -d "${TMPDIR:-/tmp}/codescan-test-latency.XXXXXXXX")" || exit 1
trap 'rm -rf -- "$fixture"' EXIT
fail() { printf 'FAIL test latency: %s\n' "$1" >&2; exit 1; }
mkdir -p "$fixture/project/tests/lib" "$fixture/project/tests/unit" "$fixture/cli" "$fixture/units" "$fixture/job-tmp" "$fixture/nix-tmp" || exit 1
cp "$root/test" "$fixture/project/test" || exit 1
cp "$root/tests/lib/capture.bash" "$fixture/project/tests/lib/capture.bash" || exit 1
if [ -f "$root/tests/lib/latency-run" ]; then
	cp "$root/tests/lib/latency-run" "$fixture/project/tests/lib/latency-run" || exit 1
fi
for path in tests/unit/test-dev-shell-cache tests/unit/test-isolation tests/lib/run-isolated; do
	{ printf '#!%s\n' "$BASH"; printf '%s\n' \
		'printf "test\t%s\t%s\t%s\n" "$0" "${CODESCAN_LATENCY_JOB-}" "$TMPDIR" >> "$LATENCY_FIXTURE_EVENTS"' \
		'case "$LATENCY_FIXTURE_FAILURE:$0" in test:*test-dev-shell-cache|boundary:*test-isolation) exit 7 ;; esac' \
		'exit 0'; } > "$fixture/project/$path"
	chmod +x "$fixture/project/$path" || exit 1
done

# Recording process adapters, never actual Nix or shared history operations.
nix() {
	case "${1-}" in
		path-info|flake) return 0 ;;
		build)
			for arg in "$@"; do
				if [ "$arg" = --json ]; then
					printf '[{"drvPath":"fixture-codescan-cli.drv","outputs":{"out":"%s"}},{"drvPath":"fixture-codescan-test-binaries-unit.drv","outputs":{"out":"%s"}}]\n' "$LATENCY_FIXTURE_CLI" "$LATENCY_FIXTURE_UNITS"
				fi
			done
			return 0
			;;
		develop)
			[ "${2-}" = -c ] || return 64
			shift 2
			(TMPDIR="$LATENCY_FIXTURE_SHELL_TMP"; export TMPDIR; "$@")
			;;
		*) return 64 ;;
	esac
}
timeout() { [ "$1" = 1800 ] || return 64; shift; "$@"; }
performance-profile() {
	if [ "$TMPDIR" != "$LATENCY_FIXTURE_JOB_TMP" ]; then
		printf 'fixture recorder lost the parent job scratch directory\n' >&2
		return 9
	fi
	[ "${1-}" = latency ] || return 64
	case "${2-}" in
		stamp)
			[ "$LATENCY_FIXTURE_FAILURE" != stamp ] || return 9
			printf '123\n'; return 0
			;;
		span) shift 2 ;;
		*) return 64 ;;
	esac
	local job='' kind='' name='' since=''
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--job) job="$2"; shift 2 ;;
			--kind) kind="$2"; shift 2 ;;
			--name) name="$2"; shift 2 ;;
			--since) since="$2"; shift 2 ;;
			--) shift; break ;;
			*) return 64 ;;
		esac
	done
	printf 'span\t%s\t%s\t%s\t%s\n' "$job" "$kind" "$name" "$since" >> "$LATENCY_FIXTURE_EVENTS"
	if [ "$LATENCY_FIXTURE_FAILURE" = recorder ] && [ "$kind" = setup ]; then return 9; fi
	[ "$#" -gt 0 ] || return 0
	"$@"
}
export -f nix timeout performance-profile

run_case() {
	local name="$1" job="$2" failure="$3" expected_rc="$4" rc events="$fixture/$1.events"
	local -a args=(--prepared "$fixture/cli" "$fixture/units")
	if [ "${5-}" = prepare ]; then args=(); fi
	: > "$events"
	if env CODESCAN_LATENCY_JOB="$job" LATENCY_FIXTURE_EVENTS="$events" LATENCY_FIXTURE_FAILURE="$failure" \
		LATENCY_FIXTURE_CLI="$fixture/cli" LATENCY_FIXTURE_UNITS="$fixture/units" \
		TMPDIR="$fixture/job-tmp" LATENCY_FIXTURE_JOB_TMP="$fixture/job-tmp" LATENCY_FIXTURE_SHELL_TMP="$fixture/nix-tmp" \
		bash "$fixture/project/test" "${args[@]}" \
		> "$fixture/$name.stdout" 2> "$fixture/$name.stderr"; then rc=0; else rc="$?"; fi
	if [ "$rc" -ne "$expected_rc" ]; then
		printf '%s\n%s\n' "$(<"$fixture/$name.stdout")" "$(<"$fixture/$name.stderr")" >&2
		fail "$name: wrong runner status $rc"
	fi
	if awk -F '\t' '$1 == "test" && $3 != "" { leaked=1 } END { exit !leaked }' "$events"; then
		fail "$name: child suite inherited the parent latency job"
	fi
	if awk -F '\t' -v expected="$fixture/job-tmp" '$1 == "test" && $4 != expected { lost=1 } END { exit !lost }' "$events"; then
		fail "$name: child suite lost the task-owned scratch directory"
	fi
}
run_case disabled '' none 0
[ "$(awk '$1 == "span" { n++ } END { print n+0 }' "$fixture/disabled.events")" -eq 0 ] || fail 'disabled recording invoked the profiler'
run_case profiled fixture-job none 0
actual="$(awk -F '\t' '$1 == "span" { print $2 "\t" $3 "\t" $4 }' "$fixture/profiled.events")"
expected=$'fixture-job\tsetup\tdev-shell cache preservation shell entry\nfixture-job\texecute\tdev-shell cache preservation\nfixture-job\tnix_eval\tall-system flake evaluation\nfixture-job\tmixed\tcompiled source closure\nfixture-job\tsetup\tpreventive filesystem boundary shell entry\nfixture-job\texecute\tpreventive filesystem boundary\nfixture-job\tsetup\tisolated complete suite shell entry\nfixture-job\texecute\tisolated complete suite'
[ "$actual" = "$expected" ] || fail 'the real runner did not record the complete ordered phase set'
[ "$(awk -F '\t' '$1 == "span" && $3 == "setup" && $5 == 123 { n++ } END { print n+0 }' "$fixture/profiled.events")" -eq 3 ] || fail 'shell-entry spans lost their pre-entry stamps'
run_case recorder-failure fixture-job recorder 1
[ "$(awk '$1 == "test" { n++ } END { print n+0 }' "$fixture/recorder-failure.events")" -eq 0 ] || fail 'a failed setup recorder still launched test execution'
run_case stamp-failure fixture-job stamp 1
[ "$(awk '$1 == "test" { n++ } END { print n+0 }' "$fixture/stamp-failure.events")" -eq 0 ] || fail 'a failed clock recorder still launched test execution'
run_case test-failure fixture-job test 1
[ "$(awk '$1 == "span" { n++ } END { print n+0 }' "$fixture/test-failure.events")" -eq 8 ] || fail 'a failed test dropped later required phase records'
run_case boundary-failure fixture-job boundary 1
[ "$(awk '$1 == "span" { n++ } END { print n+0 }' "$fixture/boundary-failure.events")" -eq 6 ] || fail 'a failed isolation check still launched the complete suite'
run_case artifact-preparation fixture-job none 0 prepare
[ "$(awk -F '\t' '$1 == "span" && $3 == "mixed" && $4 == "artifact preparation" { n++ } END { print n+0 }' "$fixture/artifact-preparation.events")" -eq 1 ] || fail 'Nix preparation was omitted or misclassified as pure compilation'

# Keep both real shell-entry assertions; this port tests only their scheduling.
mkdir "$fixture/cache-tools" || fail 'cache scheduling setup'
{
	printf '#!%s\n' "$BASH"
	printf '%s\n' \
		'[ "$1" = develop ] && [ "$2" = -c ] || exit 64' \
		'if [ -n "$ZIG_GLOBAL_CACHE_DIR" ]; then name=inherited; else name=default; fi' \
		'printf "start:%s\n" "$name" >> "$CACHE_EVENTS"' \
		'if [ "$name" = inherited ]; then' \
		'	printf "ready\n" > "$CACHE_READY" || exit 1' \
		'	read -r release < "$CACHE_RELEASE" || exit 1' \
		'	[ "$release" = go ] || exit 1' \
		'	printf "%s\n%s" "$ZIG_GLOBAL_CACHE_DIR" "$ZIG_LOCAL_CACHE_DIR"' \
		'else' \
		'	read -r ready < "$CACHE_READY" || exit 1' \
		'	[ "$ready" = ready ] || exit 1' \
		'	printf "go\n" > "$CACHE_RELEASE" || exit 1' \
		'	printf "%s\n%s" "$CACHE_DEFAULT_GLOBAL" "$CACHE_DEFAULT_LOCAL"' \
		'fi' \
		'printf "end:%s\n" "$name" >> "$CACHE_EVENTS"' \
		'case "$CACHE_FAILURE:$name" in inherited:inherited) exit 17 ;; default:default) exit 19 ;; esac'
} > "$fixture/cache-tools/nix"
chmod +x "$fixture/cache-tools/nix" || fail 'cache scheduling adapter permissions'
wait() {
	local status
	if builtin wait "$@"; then status=0; else status="$?"; fi
	printf '%s:%s\n' "$1" "$status" >> "$CACHE_WAITS"
	return "$status"
}
export -f wait
for failure in none inherited default; do
	case_root="$fixture/cache-$failure"
	mkdir "$case_root" || fail 'cache case setup'
	mkfifo "$case_root/ready" "$case_root/release" || fail 'cache barriers'
	: > "$case_root/events"
	: > "$case_root/waits"
	if env PATH="$fixture/cache-tools:$PATH" CACHE_FAILURE="$failure" CACHE_EVENTS="$case_root/events" \
		CACHE_WAITS="$case_root/waits" CACHE_READY="$case_root/ready" CACHE_RELEASE="$case_root/release" \
		CACHE_DEFAULT_GLOBAL="$HOME/.cache/zig" CACHE_DEFAULT_LOCAL="$PWD/zig-cache" \
		timeout 10 bash "$root/tests/unit/test-dev-shell-cache" > "$case_root/out" 2> "$case_root/err"; then rc=0; else rc="$?"; fi
	expected=1
	[ "$failure" != none ] || expected=0
	[ "$rc" -eq "$expected" ] || fail "cache $failure returned $rc instead of $expected; both shell entries must overlap"
	printf '%s\n' end:default end:inherited start:default start:inherited > "$case_root/expected"
	LC_ALL=C sort "$case_root/events" > "$case_root/actual" || fail 'cache event sort'
	cmp -s "$case_root/expected" "$case_root/actual" || fail "cache $failure omitted or duplicated a check"
	awk -F: -v failed="$failure" '
		{ if ($1 !~ /^[0-9]+$/ || seen[$1]++) exit 1; status[$2]++; n++ }
		END { if (n!=2 || (failed=="none" ? status[0]!=2 : (status[0]!=1 || status[1]!=1))) exit 1 }
	' "$case_root/waits" || fail "cache $failure did not join both real child statuses"
done
unset -f wait
printf 'Optional test phase recording preserves execution and failure contracts\n'
