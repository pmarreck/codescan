#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
source "$root/tests/lib/capture.bash"
source "$root/scripts/ci-verify-release"
fail() { printf 'FAIL release product: %s\n' "$1" >&2; exit 1; }
targets=(x86_64-linux-musl aarch64-linux-musl aarch64-macos x86_64-windows-gnu aarch64-windows-gnu unknown)
while IFS='|' read -r expected description; do
	for target in "${targets[@]}"; do
		if ci_release_header "$target" "$description"; then
			[ "$target" = "$expected" ] || fail "unexpected accepted pair: $target / $description"
		else
			[ "$target" != "$expected" ] || fail "expected pair refused: $target / $description"
		fi
	done
done <<'HEADERS'
x86_64-linux-musl|ELF 64-bit LSB executable, x86-64, version 1 (SYSV), statically linked, not stripped
aarch64-linux-musl|ELF 64-bit LSB executable, ARM aarch64, version 1 (SYSV), statically linked, with debug_info
aarch64-macos|Mach-O 64-bit arm64 executable
aarch64-macos|Mach-O 64-bit executable arm64, flags:<PIE>
x86_64-windows-gnu|PE32+ executable (console) x86-64, for MS Windows, 7 sections
aarch64-windows-gnu|PE32+ executable (console) Aarch64, for MS Windows, 7 sections
none|ELF 64-bit LSB executable, x86-64, dynamically linked, interpreter /lib/ld.so
none|ELF 64-bit LSB executable, ARM aarch64, dynamically linked
none|ELF 64-bit LSB executable, x86-64, statically linked, interpreter /lib/ld.so
none|ELF 64-bit LSB shared object, x86-64, statically linked
none|ELF 32-bit LSB executable, ARM, statically linked
none|ELF 64-bit MSB executable, ARM aarch64, statically linked
none|Mach-O 64-bit arm64e executable
none|Mach-O 64-bit x86_64 executable
none|Mach-O universal binary with 2 architectures: x86_64 arm64
none|PE32 executable (console) Intel 80386, for MS Windows
none|PE32+ executable (DLL) x86-64, for MS Windows
none|PE32+ executable (console) Aarch64, for MS Windows extra
none|data
none|
HEADERS
# Exercise the actual reader against the independently built native CLI, not a
# recording file port. Exactly its declared target may accept the real bytes.
case "$CODESCAN_EXPECT_PF" in
	linux-amd64) expected_target=x86_64-linux-musl ;;
	linux-arm64) expected_target=aarch64-linux-musl ;;
	macos-arm64) expected_target=aarch64-macos ;;
	*) fail 'unsupported native fixture' ;;
esac
out= err= rc=
for target in "${targets[@]}"; do
	capture bash "$root/scripts/ci-verify-release" "$target" "$CODESCAN_TEST_BIN"
	if [ "$target" = "$expected_target" ]; then
		[ "$rc" -eq 0 ] || { printf '%s\n' "$err" >&2; fail 'native CLI header was rejected'; }
	else
		[ "$rc" -ne 0 ] || fail 'native CLI was accepted as a foreign product'
	fi
done

# Invalid filesystem objects must be refused before invoking the header reader.
# A reader failure must retain its exact status, never become a format verdict.
(
	fixture="$(mktemp -d "${TMPDIR:-/tmp}/codescan-release-product.XXXXXXXX")" || exit 1
	trap 'rm -rf -- "$fixture"' EXIT
	printf 'owned fixture\n' > "$fixture/regular executable"
	chmod +x "$fixture/regular executable" || fail 'executable fixture setup'
	printf 'owned non-executable fixture\n' > "$fixture/non-executable"
	mkdir "$fixture/directory" || fail 'directory fixture setup'
	ln -s "$fixture/regular executable" "$fixture/symlink" || fail 'linked fixture setup'
	file() {
		printf '%s|%s|%s|%s\n' "$#" "$1" "$2" "$3" >> "$fixture/reader-events"
		return 37
	}
	for kind in missing directory non-executable symlink 'regular executable'; do
		for target in "${targets[@]}"; do
			: > "$fixture/reader-events"
			capture ci_verify_release "$target" "$fixture/$kind"
			if [ "$target" = unknown ]; then
				[ "$rc" -eq 64 ] || fail 'unsupported target did not retain usage status'
			elif [ "$kind" = 'regular executable' ]; then
				[ "$rc" -eq 37 ] || fail 'header reader failure lost its exact status'
				[ "$(< "$fixture/reader-events")" = "3|-b|--|$fixture/$kind" ] || fail 'header reader received the wrong argument vector'
				continue
			else
				[ "$rc" -eq 1 ] || fail "invalid filesystem object accepted: $kind"
			fi
			[ ! -s "$fixture/reader-events" ] || fail 'invalid target/object reached the header reader'
		done
	done
	for arguments in 0 1 3; do
		: > "$fixture/reader-events"
		case "$arguments" in
			0) capture ci_verify_release ;;
			1) capture ci_verify_release x86_64-linux-musl ;;
			3) capture ci_verify_release x86_64-linux-musl "$fixture/regular executable" extra ;;
		esac
		[ "$rc" -eq 64 ] && [ ! -s "$fixture/reader-events" ] || fail 'invalid arity reached header inspection'
	done
) || fail 'filesystem/reader controls'
printf 'Release header classifier and actual native CLI checks passed\n'
