#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "$0")/../.." && pwd)"
workflow="$root/.github/workflows/build.yml"

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	exit 1
}

# Compare every matrix row, including duplicate or unexpected rows.
actual="$(awk '
	/^  build:/ { in_build = 1; next }
	in_build && /^  [^ ]/ { in_build = 0 }
	in_build && $1 == "-" && $2 == "os:" { os = $3; target = archive = extension = artifact = "" }
	in_build && $1 == "target:" { target = $2 }
	in_build && $1 == "archive:" { archive = $2 }
	in_build && $1 == "ext:" { extension = $2; gsub(/^"|"$/, "", extension) }
	in_build && $1 == "artifact:" { artifact = $2 }
	in_build && $1 == "pkgdir:" { print os "\t" target "\t" archive "\t" extension "\t" artifact "\t" $2 }
' "$workflow" | LC_ALL=C sort)"
expected="$(printf '%s\n' \
	$'ubuntu-latest\tx86_64-linux-musl\ttar\t\tcodescan-linux-amd64.tar.gz\tcodescan-linux-amd64' \
	$'ubuntu-latest\taarch64-linux-musl\ttar\t\tcodescan-linux-arm64.tar.gz\tcodescan-linux-arm64' \
	$'macos-15\taarch64-macos\ttar\t\tcodescan-macos-arm64.tar.gz\tcodescan-macos-arm64' \
	$'ubuntu-latest\tx86_64-windows-gnu\tzip\t.exe\tcodescan-mswin-amd64.zip\tcodescan-mswin-amd64' \
	$'ubuntu-latest\taarch64-windows-gnu\tzip\t.exe\tcodescan-mswin-arm64.zip\tcodescan-mswin-arm64' | LC_ALL=C sort)"
if [ "$actual" != "$expected" ]; then
	printf '%s\n' "$actual" >&2
	fail "CI runner/target/artifact matrix differs from the supported contract"
fi

actual_test_runners="$(awk '
	/^  test:/ { in_tests = 1; next }
	/^  build:/ { in_tests = 0 }
	in_tests && $1 == "-" && $2 == "os:" { os = $3 }
	in_tests && $1 == "system:" { print os "\t" $2 }
' "$workflow" | LC_ALL=C sort)"
[ "$actual_test_runners" = $'ubuntu-24.04-arm\taarch64-linux\nubuntu-latest\tx86_64-linux' ] || fail 'Complete Linux tests must run on both native architectures'

actual_commands="$(awk '
	/^      - name: Run tests$/ { in_tests = 1; next }
	/^  build:/ { in_tests = 0 }
	in_tests && $1 == "nix" { sub(/^[[:space:]]+/, ""); print }
' "$workflow" | LC_ALL=C sort)"
expected_commands="$(printf '%s\n' \
	'nix flake check --no-build --all-systems' \
	'nix build .#checks.${{ matrix.system }}.test .#checks.${{ matrix.system }}.source-closure --no-link' | LC_ALL=C sort)"
[ "$actual_commands" = "$expected_commands" ] || fail "GitHub test job must run the CI contracts and all-system flake evaluation before building artifacts"

# Exercise the real workflow body with recording process ports, including every
# unsupported host pair. Runner labels alone do not prove native execution.
test_body="$(awk '
	/^      - name: Run tests$/ { in_step = 1; next }
	in_step && /^        run: \|$/ { in_body = 1; next }
	in_body && /^          / { print substr($0,11); next }
	in_body && NF { exit }
' "$workflow")"
fixture="$(mktemp -d "${TMPDIR:?}/codescan-ci-linux.XXXXXXXX")" || exit 1
trap 'rm -rf -- "$fixture"' EXIT
uname() {
	case "$1" in -s) printf '%s\n' "$CI_TEST_OS" ;; -m) printf '%s\n' "$CI_TEST_ARCH" ;; *) return 64 ;; esac
}
nix() { printf '%s\n' "$*" >> "$CI_TEST_EVENTS"; }
export -f uname nix
for system in x86_64-linux aarch64-linux; do
	for os in Linux Darwin MINGW64_NT unknown; do
		for arch in x86_64 aarch64 arm64 AMD64 unknown; do
			template='${{ matrix.system }}'
			body="${test_body//$template/$system}"
			: > "$fixture/events"
			if env CI_TEST_OS="$os" CI_TEST_ARCH="$arch" CI_TEST_EVENTS="$fixture/events" bash -c "$body" > "$fixture/out" 2> "$fixture/err"; then status=0; else status="$?"; fi
			case "$system:$os/$arch" in
				x86_64-linux:Linux/x86_64|aarch64-linux:Linux/aarch64)
					[ "$status" -eq 0 ] || fail 'native Linux runner was refused'
					expected_events="$(printf 'flake check --no-build --all-systems\nbuild .#checks.%s.test .#checks.%s.source-closure --no-link' "$system" "$system")"
					[ "$(< "$fixture/events")" = "$expected_events" ] || fail 'native Linux checks were omitted, duplicated, or misdirected'
					;;
				*) [ "$status" -eq 69 ] && [ ! -s "$fixture/events" ] || fail "foreign host reached Linux checks: $system on $os/$arch" ;;
				esac
			done
	done
done

actual_packaging="$(awk '
	/^      - name: Build ReleaseFast$/ { in_package = 1; next }
	in_package && /^      - name:/ { in_package = 0 }
	in_package && /\.\/scripts\/ci-build/ { sub(/^[[:space:]]+/, ""); print }
' "$workflow")"
expected_packaging='nix develop -c ./scripts/ci-build "${{ matrix.target }}" "${{ matrix.pkgdir }}" "${{ matrix.artifact }}" "${{ matrix.ext }}"'
[ "$actual_packaging" = "$expected_packaging" ] || fail 'CI packaging must use the pinned Nix environment for archive tools'

actual_timeouts="$(awk '/^  [a-z_-]+:$/ { job = $1; sub(/:$/, "", job) } /^    timeout-minutes:/ { print job "\t" $2 }' "$workflow" | LC_ALL=C sort)"
expected_timeouts=$'build\t30\nrelease\t30\ntest\t30'
[ "$actual_timeouts" = "$expected_timeouts" ] || fail "Every CI job must retain its 30-minute execution bound"

actual_assets="$(awk '
	/^  release:/ { in_release = 1; next }
	in_release && $1 ~ /^dist\/\*\*\// { print $1 }
' "$workflow" | LC_ALL=C sort)"
expected_assets="$(printf '%s\n' \
	'dist/**/codescan-linux-amd64.tar.gz' \
	'dist/**/codescan-linux-arm64.tar.gz' \
	'dist/**/codescan-macos-arm64.tar.gz' \
	'dist/**/codescan-mswin-amd64.zip' \
	'dist/**/codescan-mswin-arm64.zip' | LC_ALL=C sort)"
[ "$actual_assets" = "$expected_assets" ] || fail 'Release uploads must include exactly the five canonical PF archives'

windows_workflow="$root/.github/workflows/native-windows.yml"
[ -f "$windows_workflow" ] || fail 'Native Windows cancellation qualification is missing'
actual_windows="$(awk '
	$1 == "-" && $2 == "os:" { os = $3 }
	$1 == "arch:" { print os "\t" $2 }
' "$windows_workflow" | LC_ALL=C sort)"
expected_windows=$'windows-11-arm\tarm64\nwindows-2025\tamd64'
[ "$actual_windows" = "$expected_windows" ] || fail 'Native Windows jobs must cover exactly both supported architectures'
actual_preparation="$(awk '$1 == "nix" && $2 == "build" { sub(/^[[:space:]]+/, ""); print }' "$windows_workflow")"
[ "$actual_preparation" = 'nix build --no-link --keep-going .#cancellation-mswin-amd64 .#cancellation-mswin-arm64 .#test-binaries-mswin-amd64 .#test-binaries-mswin-arm64 .#test-git-mswin-amd64 .#test-git-mswin-arm64 .#release-mswin-amd64 .#release-mswin-arm64' ] || fail 'Windows tests must consume cancellation, aggregate, pinned Git, and release Nix-prepared products'
actual_windows_checks="$(awk '/\.\/scripts\/ci-test-windows\.ps1/ { sub(/^[[:space:]]+/, ""); sub(/^run:[[:space:]]+/, ""); print }' "$windows_workflow")"
expected_windows_checks=$(printf '%s\n' \
	'./scripts/ci-test-windows.ps1 -Suite unit -Architecture "${{ matrix.arch }}" -Executable "./unit/codescan-unit-tests.exe" -GitExecutable "./git-tools/cmd/git.exe"' \
	'./scripts/ci-test-windows.ps1 -Suite release -Architecture "${{ matrix.arch }}" -Executable "./release product with spaces/codescan-mswin-${{ matrix.arch }}/bin/codescan.exe"' \
	'./scripts/ci-test-windows.ps1 -Architecture "${{ matrix.arch }}" -Executable "./cancellation/codescan-cancellation-tests.exe"')
[ "$actual_windows_checks" = "$expected_windows_checks" ] || fail 'Native Windows must run all three bounded architecture/evidence verifiers'
actual_windows_timeouts="$(awk '/^  [a-z_-]+:$/ { job = $1; sub(/:$/, "", job) } /^    timeout-minutes:/ { print job "\t" $2 }' "$windows_workflow" | LC_ALL=C sort)"
[ "$actual_windows_timeouts" = $'prepare\t30\nqualify\t5' ] || fail 'Native Windows preparation/execution bounds changed'

printf 'CI runner contract passed\n'
