#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
fixture="$(mktemp -d "${TMPDIR:?}/codescan-build-scopes.XXXXXX")" || exit 1
trap 'rm -rf -- "$fixture"' EXIT
fail() { printf 'FAIL build scopes: %s\n' "$1" >&2; exit 1; }
source "$root/tests/lib/build-fixture.bash"

# Record the real wrapper's declared Nix requests; never invoke a compiler.
nix() {
	[ "${1:-}" = build ] || return 64
	shift
	local attribute='' link='' next_link=0 argument print_paths=0 product namespace leaf=result
	for argument in "$@"; do
		if [ "$next_link" -eq 1 ]; then link="$argument"; next_link=0; continue; fi
		case "$argument" in
			--out-link) next_link=1 ;;
			--print-out-paths) print_paths=1 ;;
			'.#'*) attribute="$argument" ;;
		esac
	done
	[ -n "$attribute" ] && [ "$next_link" -eq 0 ] || return 64
	case "$attribute" in
		'.#default'|'.#debug')
			namespace="$SCOPE_NAMESPACE"; product="$SCOPE_OUTPUT" ;;
		'.#release-macos-arm64') namespace=macos-arm64; product="$SCOPE_PRODUCTS/macos-arm64" ;;
		'.#release-linux-arm64') namespace=linux-arm64/musl; product="$SCOPE_PRODUCTS/linux-arm64" ;;
		'.#release-linux-amd64') namespace=linux-amd64/musl; product="$SCOPE_PRODUCTS/linux-amd64" ;;
		'.#release-mswin-arm64') namespace=mswin-arm64/gnu; product="$SCOPE_PRODUCTS/mswin-arm64" ;;
		'.#release-mswin-amd64') namespace=mswin-amd64/gnu; product="$SCOPE_PRODUCTS/mswin-amd64" ;;
		'.#test-binaries') namespace=''; product="$SCOPE_OUTPUT" ;;
		'.#publication-tools') namespace="$SCOPE_NAMESPACE"; product="${CODESCAN_PUBLICATION_TOOLS:?prepare native publication tools with Nix}"; leaf=tools ;;
		*) return 64 ;;
	esac
	if [ -n "$namespace" ]; then
		case "$link" in "$PWD/.nix-out/$namespace"/.candidate.????????/"$leaf") ;; *) return 77 ;; esac
		ln -s "$product" "$link" || return 1
		link='<candidate>'
	fi
	printf '%s\t%s\n' "$attribute" "$link" >> "$SCOPE_EVENTS"
	if [ "$attribute" = "$SCOPE_FAIL_ATTRIBUTE" ]; then
		printf 'controlled Nix build failure\n' >&2
		return 19
	fi
	if [ "$print_paths" -eq 1 ]; then printf '%s\n' "$product"; fi
}
nix-store() {
	[ "$#" -eq 4 ] && [ "$1" = --add-root ] && [ "$3" = --realise ] || return 64
	case "$4" in "$SCOPE_OUTPUT"|"$SCOPE_PRODUCTS/"*) ;; *) return 64 ;; esac
	printf '%s\t%s\n' "$2" "$4" >> "$SCOPE_ROOTS"
	ln -sfn "$4" "$2"
}
zig() { printf 'forbidden direct compiler\n' >> "$SCOPE_EVENTS"; return 99; }
file() {
	[ "$#" -eq 3 ] && [ "$1" = -b ] && [ "$2" = -- ] || return 64
	command head -n 1 "$3"
}
export -f nix nix-store zig file

case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) native_namespace=linux-amd64/musl ;;
	Linux/aarch64) native_namespace=linux-arm64/musl ;;
	Darwin/arm64) native_namespace=macos-arm64 ;;
	*) fail 'unsupported test host' ;;
esac
native_request="$(printf '%s\n' $'.#default\t<candidate>' $'.#publication-tools\t<candidate>' | LC_ALL=C sort)"
all_requests="$(printf '%s\n' \
	"$native_request" \
	$'.#release-macos-arm64\t<candidate>' \
	$'.#release-linux-arm64\t<candidate>' \
	$'.#release-linux-amd64\t<candidate>' \
	$'.#release-mswin-arm64\t<candidate>' \
	$'.#release-mswin-amd64\t<candidate>' | LC_ALL=C sort)"
for scenario in all default implementations-short implementations-long platforms-short platforms-long combined reverse repeated debug test invalid-debug invalid-test unknown failure retention-root-symlink retention-platform-symlink retention-variant-symlink; do
	project="$fixture/$scenario/project with spaces"
	mkdir -p "$project/zig-out/bin" "$project/prepared/bin" || fail 'fixture setup'
	copy_build_fixture "$project" || fail 'wrapper fixture'
	printf old > "$project/zig-out/bin/codescan"
	while IFS='|' read -r pf variant description; do
		mkdir -p "$project/products/$pf/bin" || fail 'scope product setup'
		printf '%s\n' "$description" > "$project/products/$pf/bin/codescan"
		cp "$project/products/$pf/bin/codescan" "$project/products/$pf/bin/codescan.exe" || fail 'scope PE fixture'
		chmod +x "$project/products/$pf/bin/codescan" "$project/products/$pf/bin/codescan.exe" || fail 'scope products'
	done < <(build_fixture_headers)
	native_pf="${native_namespace%%/*}"
	cp "$project/products/$native_pf/bin/codescan" "$project/prepared/bin/codescan" || fail 'scope native product'
	native_payload="$(< "$project/prepared/bin/codescan")"
	chmod +x "$project/prepared/bin/codescan" || fail 'fixture executable'
	: > "$project/events"
	args=()
	expected="$native_request"
	expected_rc=0
	fail_attribute=''
	case "$scenario" in
		all) args=(--all); expected="$all_requests" ;;
		implementations-short) args=(--all-impls) ;;
		implementations-long) args=(--all-implementations) ;;
		platforms-short) args=(--all-plats); expected="$all_requests" ;;
		platforms-long) args=(--all-platforms); expected="$all_requests" ;;
		combined) args=(--all-impls --all-plats); expected="$all_requests" ;;
		reverse) args=(--all-platforms --all-implementations); expected="$all_requests" ;;
		repeated) args=(--all --all-plats --all-implementations --all); expected="$all_requests" ;;
		debug) args=(--all-impls --debug); expected="$(printf '%s\n' $'.#debug\t<candidate>' $'.#publication-tools\t<candidate>' | LC_ALL=C sort)" ;;
		test) args=(--test --all-implementations); expected=$'.#test-binaries\t' ;;
		invalid-debug) args=(--all-platforms --debug); expected=''; expected_rc=64 ;;
		invalid-test) args=(--test --all); expected=''; expected_rc=64 ;;
		unknown) args=(--unsupported); expected=''; expected_rc=64 ;;
		failure) args=(--all); fail_attribute='.#release-linux-arm64'; expected_rc=19 ;;
		retention-*-symlink)
			args=(--all); expected=''; expected_rc=1
			mkdir -p "$project/protected" || fail 'protected fixture setup'
			printf unchanged > "$project/protected/sentinel"
			case "$scenario" in
				retention-root-symlink) link="$project/.nix-out" ;;
				retention-platform-symlink) link="$project/.nix-out/linux-arm64" ;;
				retention-variant-symlink) link="$project/.nix-out/linux-arm64/musl" ;;
			esac
			mkdir -p "$(dirname "$link")" || fail 'retained parent fixture'
			ln -s "$project/protected" "$link" || fail 'retained escape fixture'
			;;
	esac
	if (cd "$project" && env SCOPE_EVENTS="$project/events" SCOPE_OUTPUT="$project/prepared" SCOPE_PRODUCTS="$project/products" SCOPE_ROOTS="$project/roots" SCOPE_NAMESPACE="$native_namespace" \
		SCOPE_FAIL_ATTRIBUTE="$fail_attribute" "$BASH" "$project/build" "${args[@]}") > "$project/stdout" 2> "$project/stderr"; then
		rc=0
	else rc="$?"; fi
	[ "$rc" -eq "$expected_rc" ] || fail "$scenario returned $rc, expected $expected_rc"
	actual="$(LC_ALL=C sort "$project/events")" || fail 'request sorting'
	if [ "$scenario" = failure ]; then
		awk -F '\t' '$1 == ".#default" { exit 1 }' "$project/events" || fail 'failed cross-build reached native publication'
		[ "$(awk -F '\t' '$1 == ".#release-linux-arm64" { n++ } END { print n+0 }' "$project/events")" -eq 1 ] || fail 'controlled failed target was not requested exactly once'
		[ "$(< "$project/zig-out/bin/codescan")" = old ] || fail 'failed build replaced the previous command'
		rg -q 'controlled Nix build failure' "$project/stderr" || fail 'failed build hid its diagnostic'
	else
		[ "$actual" = "$expected" ] || fail "$scenario selected the wrong target/profile set or repeated a request: $actual"
		case "$scenario" in
			test|invalid-debug|invalid-test|unknown|retention-*-symlink)
				[ "$(< "$project/zig-out/bin/codescan")" = old ] || fail "$scenario published a command" ;;
			*) [ "$(< "$project/zig-out/bin/codescan")" = "$native_payload" ] || fail "$scenario omitted native publication" ;;
		esac
	fi
	case "$scenario" in
		test|invalid-debug|invalid-test|unknown|failure|retention-*-symlink) [ ! -e "$project/roots" ] || fail "$scenario promoted a native root" ;;
		*)
			profile=ReleaseFast; [ "$scenario" != debug ] || profile=Debug
			expected_roots="$(printf '.nix-out/%s/%s\t%s' "$native_namespace" "$profile" "$project/prepared")"
			if [ "$expected" = "$all_requests" ]; then
				while IFS='|' read -r pf variant description; do
					[ "$pf" != "$native_pf" ] || continue
					expected_roots+=$'\n'"$(printf '.nix-out/%s/%sReleaseFast\t%s/products/%s' "$pf" "$variant" "$project" "$pf")"
				done < <(build_fixture_headers)
			fi
			[ "$(LC_ALL=C sort "$project/roots")" = "$(printf '%s\n' "$expected_roots" | LC_ALL=C sort)" ] || fail "$scenario did not register the exact selected products once"
			while IFS='|' read -r pf variant description; do
				command_name=codescan
				case "$pf" in mswin-*) command_name=codescan.exe ;; esac
				entrypoint="$project/bin/$pf/$command_name"
				if [ "$expected" = "$all_requests" ] || [ "$pf" = "$native_pf" ]; then
					selected_profile=ReleaseFast; [ "$pf" != "$native_pf" ] || selected_profile="$profile"
					[ -L "$entrypoint" ] && [ "$(readlink "$entrypoint")" = "../../.nix-out/$pf/$variant$selected_profile/bin/$command_name" ] || fail "$scenario omitted or misdirected the $pf entrypoint"
					cmp "$entrypoint" "$project/.nix-out/$pf/$variant$selected_profile/bin/$command_name" || fail "$scenario changed the $pf command bytes"
				else
					[ ! -e "$entrypoint" ] && [ ! -L "$entrypoint" ] || fail "$scenario published an unrequested foreign command"
				fi
			done < <(build_fixture_headers)
			;;
	esac
	case "$scenario" in retention-*-symlink)
		[ "$(< "$project/protected/sentinel")" = unchanged ] || fail 'retained output escaped into caller data'
		[ "$(find "$project/protected" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ] || fail 'retained output wrote through a symlink'
		;; esac
done
printf 'Build scopes select exact declared target/profile sets\n'
