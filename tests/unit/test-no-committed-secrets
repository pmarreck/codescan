#!/usr/bin/env bash
set -u

source "$HOME/dotfiles/bin/src/capture.bash"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
key_name='embedding_api_key='
token_prefix='oMLX_'

out=
err=
rc=
capture git -C "$root" grep -nF "${key_name}${token_prefix}" -- .

if [ "$rc" -eq 1 ]; then
	printf 'PASS no literal oMLX embedding keys are tracked\n'
	exit 0
fi

if [ "$rc" -ne 0 ]; then
	printf 'git grep failed with exit code %s\n' "$rc" >&2
	printf '%s' "$err" >&2
	exit 1
fi

printf 'literal oMLX embedding key found in tracked content:\n' >&2
printf '%s\n' "$out" | awk -F: '{ print $1 ":" $2 }' >&2
exit 1
