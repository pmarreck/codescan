#!/usr/bin/env bash
set -u

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
	printf 'Usage: ci-build TARGET PACKAGE_NAME ARCHIVE [EXTENSION]\n' >&2
	exit 64
fi
TARGET="$1"
PKGDIR="$2"
ARCHIVE="$3"
EXT="${4:-}"
ci_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ci_mac_verifier="$ci_script_dir/ci-verify-macos-arm64"

case "$TARGET" in
	x86_64-linux-musl) attribute=release-linux-amd64; expected_extension= ;;
	aarch64-linux-musl) attribute=release-linux-arm64; expected_extension= ;;
	aarch64-macos) attribute=release-macos-arm64; expected_extension= ;;
	x86_64-windows-gnu) attribute=release-mswin-amd64; expected_extension=.exe ;;
	aarch64-windows-gnu) attribute=release-mswin-arm64; expected_extension=.exe ;;
	*) printf 'error: unsupported release target: %s\n' "$TARGET" >&2; exit 64 ;;
esac
package_label_pattern='^[A-Za-z0-9][A-Za-z0-9._ -]*$'
if ! [[ "$PKGDIR" =~ $package_label_pattern && "$ARCHIVE" =~ $package_label_pattern ]] ||
	[[ "$EXT" != "$expected_extension" ]]; then
	printf 'error: package/archive names must be plain labels and the extension must match the target\n' >&2
	exit 64
fi
case "$ARCHIVE" in
	*.tar.gz|*.zip) ;;
	*) printf 'error: archive must end in .tar.gz or .zip\n' >&2; exit 64 ;;
esac
if [ -L "$ARCHIVE" ] || { [ -e "$ARCHIVE" ] && [ ! -f "$ARCHIVE" ]; }; then
	printf 'error: archive output must be a regular file, not a link or directory\n' >&2
	exit 64
fi

if [ "$TARGET" = aarch64-macos ]; then
	"$ci_mac_verifier" || exit "$?"
	nix build --no-link --keep-going -L \
		'.#checks.aarch64-darwin.test' '.#checks.aarch64-darwin.source-closure' || exit "$?"
fi
output="$(nix build --no-link --print-out-paths ".#$attribute")" || exit "$?"

if [ "$TARGET" = aarch64-macos ]; then
	nix develop -c "$ci_mac_verifier" "$output/bin/codescan${EXT}" || exit "$?"
else
	bash "$ci_script_dir/ci-verify-release" "$TARGET" "$output/bin/codescan${EXT}" || exit "$?"
fi

# Keep temporary archives on the destination filesystem for rename publication.
# The package label never selects a caller-owned filesystem directory.
package_work="$(mktemp -d "$PWD/.codescan-package.XXXXXXXX")" || exit 1
cleanup_package() {
	local package_status="$?" cleanup_status=0
	# find does not follow product links. Change only owned directory copies,
	# after archiving, so read-only permissions survive distribution unchanged.
	if find "$package_work" -type d -exec chmod u+w {} + && rm -rf -- "$package_work"; then :; else
		cleanup_status="$?"
		printf 'error: package cleanup failed; staging retained at %s\n' "$package_work" >&2
	fi
	if [ "$package_status" -ne 0 ]; then exit "$package_status"; fi
	exit "$cleanup_status"
}
trap cleanup_package EXIT
mkdir "$package_work/$PKGDIR" || exit 1

# Distributed products cannot depend on links back into the build machine.
product_root="$(cd "$output" && pwd -P)" || exit 1
find "$output" -type l -print0 > "$package_work/.links" || exit "$?"
while IFS= read -r -d '' product_link; do
	link_target="$(readlink "$product_link")" || exit "$?"
	case "$link_target" in /*) printf 'error: absolute product link is not distributable: %s\n' "$product_link" >&2; exit 1 ;; esac
	resolved_target="$(realpath -e "$product_link")" || exit "$?"
	case "$resolved_target" in
		"$product_root"/*) ;;
		*) printf 'error: product link escapes the complete product: %s\n' "$product_link" >&2; exit 1 ;;
	esac
done < "$package_work/.links"

case "$TARGET" in
	*-windows-gnu) cp -RL "$output/." "$package_work/$PKGDIR/" || exit "$?" ;;
	*) cp -R "$output/." "$package_work/$PKGDIR/" || exit "$?" ;;
esac
chmod u+w "$package_work/$PKGDIR" || exit "$?"
# Keep the legacy flat command, but never overwrite an unrelated product file.
if [ -e "$package_work/$PKGDIR/codescan${EXT}" ] || [ -L "$package_work/$PKGDIR/codescan${EXT}" ]; then
	printf 'error: product conflicts with the legacy flat command\n' >&2
	exit 1
fi
cp "$output/bin/codescan${EXT}" "$package_work/$PKGDIR/" || exit 1
for document in README.md LICENSE; do
	if [ -e "$output/$document" ] || [ -L "$output/$document" ]; then
		cmp "$output/$document" "$document" || { printf 'error: product conflicts with package documentation: %s\n' "$document" >&2; exit 1; }
	else
		cp "$document" "$package_work/$PKGDIR/" || exit 1
	fi
done

if [[ "$ARCHIVE" == *.zip ]]; then
	package_archive="$package_work/.archive.zip"
	(cd "$package_work" && zip -ryq "$package_archive" "$PKGDIR") || exit "$?"
else
	package_archive="$package_work/.archive.tar.gz"
	tar -czf "$package_archive" -C "$package_work" "$PKGDIR" || exit "$?"
fi
if [ -L "$ARCHIVE" ] || { [ -e "$ARCHIVE" ] && [ ! -f "$ARCHIVE" ]; }; then
	printf 'error: archive output changed to a link or directory during packaging\n' >&2
	exit 1
fi
mv -f -- "$package_archive" "$ARCHIVE"
