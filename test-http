#!/usr/bin/env bash
set -euo pipefail

source "$HOME/dotfiles/bin/src/capture.bash"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$ROOT/zig-out/bin/codescan"

PORT="${CODESCAN_HTTP_TEST_PORT:-8124}"
HOST="127.0.0.1"
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
MODEL_NAME="${OLLAMA_MODEL:-bge-large}"

out=
err=
rc=

fail() {
	printf '%s\n' "error: $1" >&2
	exit 1
}

require_tool() {
	local tool="$1"
	if ! command -v "$tool" >/dev/null 2>&1; then
		fail "missing required tool: $tool (run via 'nix develop -c ./test-http')"
	fi
}

require_ollama() {
	capture curl -fsS "$OLLAMA_URL/api/tags"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "Ollama not reachable at $OLLAMA_URL (ensure server is running)"
	fi
	if ! printf '%s' "$out" | rg -q "\"name\":\"$MODEL_NAME"; then
		fail "Ollama model '$MODEL_NAME' not found (run: ollama pull $MODEL_NAME)"
	fi
}

post_search() {
	local payload="$1"
	capture curl -fsS -X POST -H 'Content-Type: application/json' \
		-d "$payload" "http://$HOST:$PORT/search"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "search request failed"
	fi
	printf '%s' "$out" | jq -r '.results[].name'
}

wait_for_health() {
	for _ in $(seq 1 40); do
		if curl -fsS "http://$HOST:$PORT/health" >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.1
	done
	return 1
}

main() {
	require_tool curl
	require_tool jq
	require_tool rg
	require_ollama

	capture nix develop -c zig build -Doptimize=ReleaseFast
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "zig build failed"
	fi

	DB_DIR="$(mktemp -d "$TMPDIR/codescan-http.XXXXXX")"
	DB="$DB_DIR/index.sqlite3"
	trap 'rm -rf "$DB_DIR"' EXIT

	capture "$ROOT/zig-out/bin/mk-test-db" --db "$DB"
	if [ "$rc" -ne 0 ]; then
		printf '%s' "$err" >&2
		fail "mk_test_db failed"
	fi

	"$BIN" serve --db "$DB" --http-host "$HOST" --http-port "$PORT" --ollama-url "$OLLAMA_URL" --ollama-model "$MODEL_NAME" &
	SERVER_PID=$!
	trap 'kill "$SERVER_PID" >/dev/null 2>&1 || true; rm -rf "$DB_DIR"' EXIT

	if ! wait_for_health; then
		fail "server did not become healthy"
	fi

	names=$(post_search '{"query":"checksum","mode":"lexical"}')
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' && fail "default search included docs unexpectedly"

	names=$(post_search '{"query":"checksum","mode":"lexical","include_docs":true}')
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "include_docs missing docs"

	names=$(post_search '{"query":"checksum","mode":"lexical","docs":true}')
	printf '%s\n' "$names" | rg -q '^Checksum Docs$' || fail "docs-only missing docs"
	printf '%s\n' "$names" | rg -q '^checksum_fn$' && fail "docs-only included code"

	names=$(post_search '{"query":"checksum","mode":"lexical","only_comments":true,"lang":"zig"}')
	printf '%s\n' "$names" | rg -q '^hash_bytes$' || fail "comments-only missing commented symbol"
	printf '%s\n' "$names" | rg -q '^checksum_fn$' && fail "comments-only included non-commented symbol"

	printf '%s\n' "http ok"
}

main "$@"
